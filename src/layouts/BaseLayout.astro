---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Motion from '../components/Motion.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { siteConfig } from '../data/site';
import '../styles/fonts.css';
import '../styles/global.css';
import { stripBase, withBase } from '../utils/url';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	noIndex?: boolean;
	publishedTime?: Date;
	updatedTime?: Date;
	tags?: string[];
	searchWeight?: number;
	canonicalPath?: string;
}

const {
	title = siteConfig.title,
	description = siteConfig.description,
	image = '/social-card.png',
	type = 'website',
	noIndex = false,
	publishedTime,
	updatedTime,
	tags = [],
	searchWeight,
	canonicalPath,
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} — ${siteConfig.title}`;
const currentPath = stripBase(Astro.url.pathname);
const siteUrl = Astro.site ?? new URL(siteConfig.siteUrl);
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteUrl).toString();
const shareImage = image.startsWith('/') ? image.replace(/\.svg$/, '.png') : image;
const imageUrl = shareImage.startsWith('http') ? shareImage : new URL(withBase(shareImage), siteUrl).toString();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content={siteConfig.author} />
		<meta name="color-scheme" content="light dark" />
		<!-- 地址栏配色：无 JS 时用两条带 media 的 meta（HTML 规范允许 noscript 内含 meta）；
		     有 JS 时由下方内联脚本把不带 media 的那条同步成「实际生效」的主题。 -->
		<meta name="theme-color" content="#faf6f0" />
		<noscript>
			<meta name="theme-color" content="#faf6f0" media="(prefers-color-scheme: light)" />
			<meta name="theme-color" content="#211c16" media="(prefers-color-scheme: dark)" />
		</noscript>
		<!-- 防闪白：必须是 head 内、解析期阻塞的内联脚本。
		     Astro 里必须用 is:inline —— 普通 script 标签会被提升并打包成 module，失去阻塞语义。
		     两态语义：首次访问按系统偏好写入存储，之后只有显式 light/dark；
		     存储值始终存在，页面不再随系统主题自动变化。
		     属性设在 documentElement（不是 body），color-scheme 才能一并切换。 -->
		<script is:inline>
			(() => {
				const mq = window.matchMedia('(prefers-color-scheme: dark)');
				let currentPref;
				const readPref = () => {
					if (currentPref) return currentPref;
					try {
						let p = localStorage.getItem('theme');
						if (p !== 'light' && p !== 'dark') {
							p = mq.matches ? 'dark' : 'light';
							localStorage.setItem('theme', p);
						}
						return p;
					} catch { return mq.matches ? 'dark' : 'light'; }
				};
				const LIGHT = '#faf6f0', DARK = '#211c16';
				const LABELS = {
					light: '主题：浅色（点击切换为深色）',
					dark: '主题：深色（点击切换为浅色）',
				};
				window.__applyTheme = (next) => {
					const pref = next === 'light' || next === 'dark' ? next : readPref();
					currentPref = pref;
					document.documentElement.setAttribute('data-theme', pref);
					const meta = document.querySelector('meta[name="theme-color"]:not([media])');
					if (meta) meta.setAttribute('content', pref === 'dark' ? DARK : LIGHT);
					document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
						btn.setAttribute('data-pref', pref);
						btn.setAttribute('aria-label', LABELS[pref]);
						btn.setAttribute('title', LABELS[pref]);
					});
				};
				window.__applyTheme();
			})();
		</script>
		{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
		{noIndex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{pageTitle}</title>

		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
		{tags.map(tag => <meta property="article:tag" content={tag} />)}
	</head>
	<body id="top">
		<a href="#main-content" class="skip-link">跳到主要内容</a>
		<div class="relative">
			<SiteHeader currentPath={currentPath} />
			<main id="main-content" tabindex="-1" {...(searchWeight !== undefined ? { 'data-pagefind-weight': searchWeight } : {})}>
				<slot />
			</main>
			<SiteFooter />
		</div>
		<Motion />
		{currentPath !== '/search/' && <SearchDialog/>}

	</body>
</html>
