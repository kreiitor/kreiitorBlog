---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Motion from '../components/Motion.astro';
import { siteConfig } from '../data/site';
import '../styles/fonts.css';
import '../styles/global.css';
import { stripBase, withBase } from '../utils/url';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	noIndex?: boolean;
	publishedTime?: Date;
	updatedTime?: Date;
	tags?: string[];
	searchWeight?: number;
	canonicalPath?: string;
}

const {
	title = siteConfig.title,
	description = siteConfig.description,
	image = '/social-card.png',
	type = 'website',
	noIndex = false,
	publishedTime,
	updatedTime,
	tags = [],
	searchWeight,
	canonicalPath,
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} — ${siteConfig.title}`;
const currentPath = stripBase(Astro.url.pathname);
const siteUrl = Astro.site ?? new URL(siteConfig.siteUrl);
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteUrl).toString();
const shareImage = image.startsWith('/') ? image.replace(/\.svg$/, '.png') : image;
const imageUrl = shareImage.startsWith('http') ? shareImage : new URL(withBase(shareImage), siteUrl).toString();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content={siteConfig.author} />
		<meta name="theme-color" content="#f8f9f5" />
		{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
		{noIndex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{pageTitle}</title>

		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
		{tags.map(tag => <meta property="article:tag" content={tag} />)}
	</head>
	<body id="top">
		<a href="#main-content" class="skip-link">跳到主要内容</a>
		<div class="relative">
			<SiteHeader currentPath={currentPath} />
			<main id="main-content" tabindex="-1" {...(searchWeight !== undefined ? { 'data-pagefind-weight': searchWeight } : {})}>
				<slot />
			</main>
			<SiteFooter />
		</div>
		<Motion />

	</body>
</html>
