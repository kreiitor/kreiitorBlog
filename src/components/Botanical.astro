---
interface Props {
 variant?: 'sprig' | 'divider' | 'corner';
 class?: string;
}
const { variant = 'sprig', class: className } = Astro.props;
const classes = ['research-mark', `research-mark-${variant}`, className].filter(Boolean).join(' ');
---
{variant === 'sprig' && (
 <svg class={classes} viewBox="0 0 120 28" width="120" height="28" fill="none" aria-hidden="true">
  <path d="M4 14h112M28 8v12M58 8v12M88 8v12" stroke="currentColor" stroke-width="1"/>
  <circle cx="58" cy="14" r="4" fill="var(--color-counterpoint)"/>
 </svg>
)}
{variant === 'divider' && (
 <svg class={classes} viewBox="0 0 360 24" width="360" height="24" fill="none" aria-hidden="true">
  <path d="M0 12h160m40 0h160" stroke="currentColor" stroke-width="1" opacity=".45"/>
  <circle cx="180" cy="12" r="3" fill="var(--color-counterpoint)"/>
 </svg>
)}
{variant === 'corner' && (
 <svg class={classes} viewBox="0 0 180 140" width="180" height="140" fill="none" aria-hidden="true">
  <path d="M24 112h126M24 112V25M42 94l30-25 24 13 38-43" stroke="currentColor" stroke-width="1.5"/>
  <circle cx="42" cy="94" r="3" fill="currentColor"/><circle cx="72" cy="69" r="3" fill="currentColor"/>
  <circle cx="96" cy="82" r="3" fill="currentColor"/><circle cx="134" cy="39" r="4" fill="var(--color-counterpoint)"/>
 </svg>
)}
