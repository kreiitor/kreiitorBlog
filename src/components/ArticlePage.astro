---
import type { PostEntry } from '../utils/content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReadingTools from './ReadingTools.astro';
import ReadingMemory from './ReadingMemory.astro';
import GiscusComments from './GiscusComments.astro';
import MathLabel from './MathLabel.astro';
import TagLink from './TagLink.astro';
import { getHeadingLabels, getReadingTime, getPostCover, getRelatedPosts } from '../utils/content';
import { DEFAULT_SERIES_COVER, getLearningSeries } from '../utils/series';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';
import { resolveCover } from '../utils/covers';
import { sections } from '../data/sections';
import 'katex/dist/katex.min.css';
import '../styles/code-fonts.css';
interface Props { post: PostEntry; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const sourceLabels = getHeadingLabels(post.body ?? '', 3);
// 目录覆盖 h2 与 h3：实测 57 篇里 48 篇含 h3（共 1211 个），只取 depth===2 会丢掉约四分之三的骨架。
// sourceLabels 与 headings 都取 <=3 且同序，下标对齐才成立。
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3).map((heading, index) => ({ ...heading, text: sourceLabels[index] ?? heading.text }));
// 每个 h3 记下所属的 h2：桌面目录在小节很多时只展开当前章。
let currentParent = '';
const tocEntries = toc.map(heading => {
 if (heading.depth === 2) currentParent = heading.slug;
 return { ...heading, parent: heading.depth === 3 ? currentParent : undefined };
});
const group = post.data.series ? getLearningSeries(await getCollection('series'), await getCollection('posts')).find(item => item.entry.id === post.data.series) : undefined;
const section = sections[post.data.category];
const seriesHref = group ? `/notes/${group.entry.id}/` : section.href;
const chapterIndex = group?.chapters.findIndex(item => item.id === post.id) ?? -1;
const previousChapter = group?.chapters[chapterIndex - 1];
const nextChapter = group?.chapters[chapterIndex + 1];
const previous = previousChapter ? { href: `/blog/${previousChapter.id}/`, title: previousChapter.data.title, label: '上一章' } : undefined;
const next = nextChapter ? { href: `/blog/${nextChapter.id}/`, title: nextChapter.data.title, label: '下一章' } : undefined;
const shareCover = resolveCover(post.data.cover ?? (group ? group.entry.data.cover ?? DEFAULT_SERIES_COVER : getPostCover(post)));
const related = getRelatedPosts(post, await getCollection('posts'), 3);
---
<BaseLayout title={post.data.title} description={post.data.description} image={shareCover} type="article" publishedTime={post.data.pubDate} updatedTime={post.data.updatedDate} tags={post.data.tags} searchWeight={1} compactFooter section={post.data.category}>
 <section class="page-shell reading-shell">
  <a href={withBase(seriesHref)} class="text-link back-link">← {group ? group.entry.data.title : section.label}</a>
  <div class="article-layout">
   <article data-pagefind-body data-reading-article data-article-slug={post.id} data-article-title={post.data.title} data-article-description={post.data.description} data-article-type={section.label} data-pagefind-meta="slug[data-article-slug], title[data-article-title], description[data-article-description], type[data-article-type]">
    <header class="article-header">
     <span data-pagefind-meta="type" class="sr-only">{section.label}</span>
     <p class="eyebrow">{group ? `${group.entry.data.title} · 第 ${chapterIndex + 1} 篇` : section.label}</p>
     <h1 data-pagefind-meta="title" data-pagefind-weight="8">{post.data.title}</h1>
     <p class="article-summary" data-pagefind-meta="description">{post.data.description}</p>
     <div class="card-meta"><span>kreiitor</span><span aria-hidden="true">·</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span aria-hidden="true">·</span><span>{getReadingTime(post)} 分钟阅读</span>{post.data.updatedDate && <><span aria-hidden="true">·</span><span>更新于 {formatDate(post.data.updatedDate)}</span></>}</div>
     <div class="article-tags">{post.data.tags.map(tag => <TagLink tag={tag}/>)}</div>
    </header>
    <ReadingTools/>
    <details class="mobile-toc" data-pagefind-ignore><summary><span class="mobile-toc-label">目录</span><span class="mobile-toc-current" data-toc-current>{toc.length} 个小节</span></summary><nav aria-label="文章目录">{toc.map(h => <a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-h3' : undefined} data-toc-link><MathLabel text={h.text}/></a>)}</nav></details>
    <div class="rich-content article-body"><Content/></div>
    <ReadingMemory/>
    {group && <div class="chapter-progress" data-pagefind-ignore><span>{group.entry.data.title} · 第 {chapterIndex + 1} / {group.chapters.length} 篇</span><span class="chapter-progress-track" aria-hidden="true">{group.chapters.map((_, index) => <span class:list={{ 'is-past': index < chapterIndex, 'is-current': index === chapterIndex }}></span>)}</span></div>}
    {(previous || next) && <nav class:list={["chapter-nav", {"chapter-nav-single": !previous || !next}]} data-pagefind-ignore aria-label="继续阅读"><div>{previous && <a href={withBase(previous.href)}><span>← {previous.label}</span><strong>{previous.title}</strong></a>}</div><div>{next && <a href={withBase(next.href)}><span>{next.label} →</span><strong>{next.title}</strong></a>}</div></nav>}
    {related.length > 0 && <section class="related-posts" data-pagefind-ignore aria-labelledby="related-heading"><h2 id="related-heading">延伸阅读</h2><ul>{related.map(item => <li><a href={withBase(`/blog/${item.id}/`)}><span class="related-title">{item.data.title}</span><span class="related-desc">{item.data.description}</span></a></li>)}</ul></section>}
    <div data-pagefind-ignore><GiscusComments articlePath={withBase(`/blog/${post.id}/`)}/></div>
   </article>
   <aside data-pagefind-ignore><nav class="article-toc" aria-label="本篇目录"><p class="eyebrow">本篇目录</p><div class="toc-links"><span class="toc-indicator" data-toc-indicator aria-hidden="true"></span>{tocEntries.map(h => <a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-h3' : undefined} data-toc-link data-toc-parent={h.parent}><span class="toc-text"><MathLabel text={h.text}/></span></a>)}</div>{group && <a href={withBase(seriesHref)} class="toc-series">回到这卷目录 →</a>}</nav></aside>
  </div>
 </section>
</BaseLayout>
<style>
 .reading-shell { padding-top: 36px; }
 .article-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
 .article-tags :global(.zen-tag) { padding: 2px 10px; font-size: 12px; }
 .chapter-nav { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; margin-bottom: 40px; }
 .chapter-nav a { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 18px 20px; border: 1px solid var(--color-line); border-radius: 14px; font-size: 12.5px; transition: border-color var(--dur-base),background-color var(--dur-base); }
 .chapter-nav a:hover { border-color: var(--color-line-strong); background: var(--color-surface); }
 .chapter-nav a:hover strong { color: var(--color-accent-strong); }
 .chapter-nav strong { font-family: var(--font-display); font-size: 16px; font-weight: 600; line-height: 1.6; transition: color var(--dur-base); }
 .chapter-nav span { color: var(--color-ink-muted); }
 .chapter-nav > div:last-child { text-align: right; }
 .chapter-nav-single { grid-template-columns: 1fr; }
 .chapter-nav-single > div:empty { display: none; }
 .chapter-nav-single > div:last-child { text-align: left; }
 .toc-series { margin-top: 20px; color: var(--color-ink) !important; font-weight: 600; }
 .mobile-toc summary { display: flex; align-items: center; gap: 12px; min-width: 0; }
 .mobile-toc-label { flex-shrink: 0; padding: 1px 10px; border: 1px solid var(--color-line); border-radius: 999px; color: var(--color-ink-soft); font-size: 12px; }
 .mobile-toc-current { min-width: 0; overflow: hidden; color: var(--color-ink); text-overflow: ellipsis; white-space: nowrap; }
 .chapter-progress { display: grid; gap: 10px; margin-bottom: 18px; color: var(--color-ink-muted); font-size: 12.5px; font-variant-numeric: tabular-nums; }
 .chapter-progress-track { display: flex; gap: 4px; }
 .chapter-progress-track > span { flex: 1; height: 3px; border-radius: 3px; background: var(--color-line); }
 .chapter-progress-track > .is-past { background: var(--color-line-strong); }
 .chapter-progress-track > .is-current { background: var(--color-accent); }
 .mobile-toc nav a { display: flex; align-items: center; min-width: 0; min-height: 44px; padding-block: 4px; overflow-wrap: anywhere; }
 .mobile-toc .toc-h3 { padding-left: 16px; }
 .mobile-toc a[aria-current="location"] { color: var(--color-ink); font-weight: 600; }
 .related-posts { margin-bottom: 40px; }
 .related-posts h2 { padding-bottom: 12px; border-bottom: 1px solid var(--color-line); color: var(--color-sage); font-family: var(--font-sans); font-size: 12.5px; font-weight: 600; letter-spacing: .06em; }
 .related-posts ul { display: grid; margin: 0; padding: 0; list-style: none; }
 .related-posts li a { display: grid; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--color-line); }
 .related-posts li a:hover .related-title { color: var(--color-accent-strong); }
 .related-title { font-family: var(--font-display); font-size: 17px; font-weight: 600; line-height: 1.6; transition: color var(--dur-base); }
 .related-desc { color: var(--color-ink-soft); font-size: 13.5px; line-height: 1.8; }
 @media (max-width: 600px) { .reading-shell { padding-top: 24px; } .chapter-nav { grid-template-columns: 1fr; } .chapter-nav > div:last-child { text-align: left; } }
</style>
