---
import type { PostEntry } from '../utils/content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReadingTools from './ReadingTools.astro';
import GiscusComments from './GiscusComments.astro';
import MathLabel from './MathLabel.astro';
import TagLink from './TagLink.astro';
import { getHeadingLabels, getReadingTime, getPostCover, getRelatedPosts } from '../utils/content';
import { DEFAULT_SERIES_COVER, getLearningSeries } from '../utils/series';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';
import 'katex/dist/katex.min.css';
import '../styles/code-fonts.css';
interface Props { post: PostEntry; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const sourceLabels = getHeadingLabels(post.body ?? '', 3);
// 目录覆盖 h2 与 h3：实测 57 篇里 48 篇含 h3（共 1211 个），只取 depth===2 会丢掉约四分之三的骨架。
// sourceLabels 与 headings 都取 <=3 且同序，下标对齐才成立。
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3).map((heading, index) => ({ ...heading, text: sourceLabels[index] ?? heading.text }));
const group = post.data.series ? getLearningSeries(await getCollection('series'), await getCollection('posts')).find(item => item.entry.id === post.data.series) : undefined;
const seriesHref = group ? `/notes/${group.entry.id}/` : '/blog/';
const chapterIndex = group?.chapters.findIndex(item => item.id === post.id) ?? -1;
const previousChapter = group?.chapters[chapterIndex - 1];
const nextChapter = group?.chapters[chapterIndex + 1];
const previous = previousChapter ? { href: `/blog/${previousChapter.id}/`, title: previousChapter.data.title, label: '上一章' } : undefined;
const next = nextChapter ? { href: `/blog/${nextChapter.id}/`, title: nextChapter.data.title, label: '下一章' } : undefined;
const cover = post.data.category === 'writing' ? getPostCover(post) : undefined;
const shareCover = cover ?? post.data.cover ?? (group ? group.entry.data.cover ?? DEFAULT_SERIES_COVER : getPostCover(post));
const related = getRelatedPosts(post, await getCollection('posts'), 3);
---
<BaseLayout title={post.data.title} description={post.data.description} image={shareCover} type="article" publishedTime={post.data.pubDate} updatedTime={post.data.updatedDate} tags={post.data.tags} searchWeight={1}>
 <section class="page-shell reading-shell">
  <a href={withBase(seriesHref)} class="text-link back-link">← {group ? group.entry.data.title : '全部札记'}</a>
  <div class="article-layout">
   <article data-pagefind-body data-reading-article data-article-slug={post.id} data-article-title={post.data.title} data-article-description={post.data.description} data-article-type={post.data.category === 'course' ? '学习笔记' : '博客文章'} data-pagefind-meta="slug[data-article-slug], title[data-article-title], description[data-article-description], type[data-article-type]">
    <header class="article-header">
     <span data-pagefind-meta="type" class="sr-only">{post.data.category === 'course' ? '学习笔记' : '博客文章'}</span>
     <p class="eyebrow">{group ? `${group.entry.data.englishTitle ?? group.entry.data.title} / ${String(chapterIndex + 1).padStart(2,'0')}` : 'FIELD NOTES'}</p>
     <h1 data-pagefind-meta="title" data-pagefind-weight="8">{post.data.title}</h1>
     <p class="article-summary" data-pagefind-meta="description">{post.data.description}</p>
     <div class="card-meta"><span>kreiitor</span><span aria-hidden="true">·</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>· {getReadingTime(post)} 分钟阅读</span>{post.data.updatedDate && <span>· 更新于 {formatDate(post.data.updatedDate)}</span>}</div>
     <div class="article-tags">{post.data.tags.map(tag => <TagLink tag={tag}/>)}</div>
    </header>
    <ReadingTools/>
    <details class="mobile-toc" data-pagefind-ignore><summary>本篇目录 · {toc.length} 个小节</summary><nav aria-label="文章目录">{toc.map(h => <a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-h3' : undefined} data-toc-link><MathLabel text={h.text}/></a>)}</nav></details>
    {cover && <img src={withBase(cover)} alt="" class="article-cover" width="800" height="420" fetchpriority="high"/>}
    <div class="rich-content article-body"><Content/></div>
    {(previous || next) && <nav class="chapter-nav" data-pagefind-ignore aria-label="继续阅读"><div>{previous && <a href={withBase(previous.href)}><span>← {previous.label}</span><strong>{previous.title}</strong></a>}</div><div>{next && <a href={withBase(next.href)}><span>{next.label} →</span><strong>{next.title}</strong></a>}</div></nav>}
    {related.length > 0 && <section class="related-posts" data-pagefind-ignore aria-labelledby="related-heading"><h2 id="related-heading">延伸阅读</h2><ul>{related.map(item => <li><a href={withBase(`/blog/${item.id}/`)}><span class="related-title">{item.data.title}</span><span class="related-desc">{item.data.description}</span></a></li>)}</ul></section>}
    <div data-pagefind-ignore><GiscusComments articlePath={withBase(`/blog/${post.id}/`)}/></div>
   </article>
   <aside data-pagefind-ignore><nav class="article-toc" aria-label="本篇目录"><p class="eyebrow">ON THIS PAGE / 本篇目录</p>{toc.map(h => <a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-h3' : undefined} data-toc-link><MathLabel text={h.text}/></a>)}{group && <a href={withBase(seriesHref)} class="toc-series">完整学习路径 ↗</a>}</nav></aside>
  </div>
 </section>
</BaseLayout>
<style>
 .reading-shell { padding-top: 32px; }
 .article-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
 .article-tags :global(.zen-tag) { padding: 2px 9px; font-size: 12px; }
 .article-cover { margin-top: 22px; max-height: 240px; }
 .chapter-nav { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 28px; border-block: 1px solid var(--color-line); padding: 26px 0; margin-bottom: 36px; }
 .chapter-nav a { display: flex; flex-direction: column; gap: 10px; font-size: 12px; }
 .chapter-nav strong { font-weight: 500; font-size: 15px; line-height: 1.8; }
 .chapter-nav span { color: var(--color-ink-soft); }
 .chapter-nav > div:last-child { text-align: right; }
 .toc-series { margin-top: 24px; }
 .mobile-toc nav a { min-width: 0; padding-block: 4px; overflow-wrap: anywhere; }
 .mobile-toc .toc-h3 { padding-left: 16px; }
 .mobile-toc a[aria-current="location"] { color: var(--color-accent-strong); font-weight: 600; }
 .related-posts { margin-bottom: 36px; }
 .related-posts h2 { font-size: 13px; font-family: var(--font-sans); font-weight: 500; letter-spacing: .09em; text-transform: uppercase; color: var(--color-accent); padding-bottom: 14px; border-bottom: 1px solid var(--color-line); }
 .related-posts ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 2px; }
 .related-posts li a { display: grid; gap: 6px; padding: 16px 0; border-bottom: 1px solid var(--color-line); transition: color var(--dur-base) var(--ease-smooth); }
 .related-posts li a:hover { color: var(--color-accent); }
 .related-title { font-family: var(--font-display); font-size: 17px; line-height: 1.65; }
 .related-desc { font-size: 13px; line-height: 1.8; color: var(--color-ink-soft); }
 @media (max-width: 600px) { .reading-shell { padding-top: 22px; } .chapter-nav { gap: 18px; } }
</style>
