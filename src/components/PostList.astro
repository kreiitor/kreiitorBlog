---
import type { PostEntry } from '../utils/content';
import { getReadingTime } from '../utils/content';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';
import Icon from './Icon.astro';
import { sections } from '../data/sections';
// label：混排多个栏目时标栏目名；同一栏目内标首个标签。
interface Props { posts: PostEntry[]; interactive?: boolean; label?: 'section' | 'tag'; }
const { posts, interactive = false, label = 'section' } = Astro.props;
const initial = new Set(posts.slice(0,12).map(post => post.id));
---
<div class="post-list" data-post-list>
 {posts.map(post => <a class="post-row" href={withBase(`/blog/${post.id}/`)} data-post-row data-category={post.data.category} data-tags={post.data.tags.join('|')} hidden={interactive && !initial.has(post.id)}>
  <div><div class="row-meta"><span class="row-category">{label === 'tag' ? post.data.tags[0] : sections[post.data.category].label}</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>{getReadingTime(post)} 分钟阅读</span></div><h2>{post.data.title}</h2><p class="row-description">{post.data.description}</p></div><span class="row-arrow" aria-hidden="true"><Icon name="arrow"/></span>
 </a>)}
</div>
<style>
 .post-list { border-top: 1px solid var(--color-line); }
 .post-row { position: relative; display: grid; grid-template-columns: minmax(0,1fr) 40px; align-items: center; gap: 24px; padding: 22px 16px; margin-inline: -16px; border-radius: var(--radius-card); border-bottom: 1px solid var(--color-line); transition: background-color var(--dur-base) var(--ease-smooth); }
 .row-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; color: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12px; font-variant-numeric: tabular-nums; }
 .row-category { color: var(--color-accent-strong); font-family: var(--font-sans); font-weight: 600; }
 .post-row h2 { margin-top: 8px; font-size: 21px; line-height: 1.42; transition: color var(--dur-base) var(--ease-smooth); }
 .row-description { max-width: 72ch; margin-top: 8px; color: var(--color-ink-soft); font-size: 14.5px; line-height: 1.8; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
 .row-arrow { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--color-line-strong); border-radius: 50%; background: var(--color-surface-soft); color: var(--color-ink); transition: transform var(--dur-base) var(--ease-out-expo),background-color var(--dur-base),color var(--dur-base),border-color var(--dur-base); }
 .post-row:is(:hover,:focus-visible) { background: var(--color-surface); }
 .post-row:is(:hover,:focus-visible) h2 { color: var(--color-accent-strong); }
 .post-row:is(:hover,:focus-visible) .row-arrow { transform: translateX(3px); background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
 @media (max-width: 600px) { .post-row { gap: 12px; padding: 20px 0; margin-inline: 0; border-radius: 0; grid-template-columns: minmax(0,1fr) 36px; } .post-row h2 { font-size: 19px; } .row-arrow { width: 36px; height: 36px; } }
</style>
