---
import Icon from './Icon.astro';
---
<a href="#top" class="back-to-top" data-back-to-top aria-label="回到页面顶部" aria-hidden="true" tabindex="-1"><Icon name="up"/></a>
<script>
 const preference = matchMedia('(prefers-reduced-motion: reduce)');
 const header = document.querySelector<HTMLElement>('.site-header');
 const topLink = document.querySelector<HTMLAnchorElement>('[data-back-to-top]');
 let framePending = false;
 let lastScrolled: boolean | null = null;
 let lastVisible: boolean | null = null;
 let lastY = window.scrollY;
 function updateScroll() {
  framePending = false;
  const y = window.scrollY;
  if (header) {
   const scrolled = y > 20;
   if (scrolled !== lastScrolled) { lastScrolled = scrolled; header.dataset.scrolled = String(scrolled); }
  }
  if (topLink) {
   // Avoid covering article text while reading down; reveal it on the way back up
   // and near the end of the page, where returning to the top is the likely action.
   const nearBottom = y + window.innerHeight >= document.documentElement.scrollHeight - 8;
   const visible = y > 650 && (y < lastY || nearBottom);
   if (visible !== lastVisible) {
    lastVisible = visible;
    topLink.dataset.visible = String(visible);
    topLink.setAttribute('aria-hidden', String(!visible));
    topLink.tabIndex = visible ? 0 : -1;
   }
  }
  lastY = y;
 }
 function schedule() { if (!framePending) { framePending = true; requestAnimationFrame(updateScroll); } }
 window.addEventListener('scroll',schedule,{passive:true});
 window.addEventListener('resize',schedule,{passive:true});
 preference.addEventListener('change',() => {
  updateScroll();
 });
 updateScroll();

 // 首页：页头透明地压在深色主视觉上，主视觉离开页头下沿后换回纸色底。
 const hero = document.querySelector<HTMLElement>('[data-home-hero]');
 if (header && hero && 'IntersectionObserver' in window) {
  const height = header.getBoundingClientRect().height;
  new IntersectionObserver(entries => {
   for (const entry of entries) {
    if (entry.isIntersecting) header.dataset.overHero = 'true';
    else delete header.dataset.overHero;
   }
  },{ rootMargin: `-${Math.round(height)}px 0px 0px 0px` }).observe(hero);
 }

 // 卡片柔光跟随指针：只写两个自定义属性，绘制完全交给 CSS。
 if (matchMedia('(hover: hover)').matches) {
  document.addEventListener('pointermove',event => {
   if (event.pointerType !== 'mouse' || !(event.target instanceof Element)) return;
   const card = event.target.closest<HTMLElement>('.zen-card,[data-spotlight]');
   if (!card) return;
   const rect = card.getBoundingClientRect();
   card.style.setProperty('--mx',`${event.clientX - rect.left}px`);
   card.style.setProperty('--my',`${event.clientY - rect.top}px`);
  },{ passive: true });
 }
</script>
<style is:global>
 .site-header[data-scrolled="true"]:not([data-over-hero]) { box-shadow: 0 8px 28px -18px var(--color-head-shadow); }
 .back-to-top { position: fixed; bottom: 28px; right: 28px; z-index: 30; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1px solid var(--color-line); border-radius: 50%; background: var(--color-surface); color: var(--color-ink); box-shadow: var(--shadow-soft); opacity: 0; visibility: hidden; translate: 0 8px; transition: opacity var(--dur-base) var(--ease-smooth),visibility var(--dur-base) var(--ease-smooth),translate var(--dur-base) var(--ease-out-expo),background-color var(--dur-base) var(--ease-smooth),color var(--dur-base) var(--ease-smooth); }
 .back-to-top[data-visible="true"] { opacity: 1; visibility: visible; translate: 0 0; }
 .back-to-top:is(:hover,:focus-visible) { background: var(--color-primary); color: var(--color-on-primary); border-color: var(--color-primary); }
 .back-to-top:active { translate: 0 1px; }
 @view-transition { navigation: auto; }
 ::view-transition-old(root),::view-transition-new(root) { animation-duration: var(--dur-base); }
 @media (max-width: 600px) { .back-to-top { width: 44px; height: 44px; right: 16px; bottom: 18px; } }
 @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }
</style>
