---
import Icon from './Icon.astro';
---
<a href="#top" class="back-to-top" data-back-to-top aria-label="回到页面顶部" aria-hidden="true" tabindex="-1"><Icon name="up"/></a>
<script>
 import { enhanceAnchor } from '../utils/smooth-scroll';
 const preference = matchMedia('(prefers-reduced-motion: reduce)');
 const header = document.querySelector<HTMLElement>('.site-header');
 const footerBottom = document.querySelector<HTMLElement>('.footer-bottom');
 const topLink = document.querySelector<HTMLAnchorElement>('[data-back-to-top]');
 if (topLink) enhanceAnchor(topLink);
 let framePending = false;
 let lastScrolled: boolean | null = null;
 let lastVisible: boolean | null = null;
 let lastY = window.scrollY;
 let movingUp = false;
 function updateScroll() {
  framePending = false;
  const y = window.scrollY;
  if (header) {
   const scrolled = y > 20;
   if (scrolled !== lastScrolled) { lastScrolled = scrolled; header.dataset.scrolled = String(scrolled); }
  }
  if (topLink) {
   const footerLinkVisible = footerBottom ? footerBottom.getBoundingClientRect().top < window.innerHeight - 8 : false;
   const visible = y > 650 && movingUp && !footerLinkVisible;
   if (visible !== lastVisible) {
    lastVisible = visible;
    topLink.dataset.visible = String(visible);
    topLink.setAttribute('aria-hidden', String(!visible));
    topLink.tabIndex = visible ? 0 : -1;
   }
  }
 }
 function schedule() { if (!framePending) { framePending = true; requestAnimationFrame(updateScroll); } }
 window.addEventListener('scroll',() => {
  const y = window.scrollY;
  if (y !== lastY) movingUp = y < lastY;
  lastY = y;
  schedule();
 },{passive:true});
 window.addEventListener('resize',schedule,{passive:true});
 preference.addEventListener('change',() => { updateScroll(); });
 updateScroll();
</script>
<style is:global>
 .back-to-top { position: fixed; bottom: 28px; right: 28px; z-index: 30; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1px solid var(--color-line-strong); border-radius: 50%; background: var(--color-surface); color: var(--color-ink); box-shadow: var(--shadow-soft); opacity: 0; visibility: hidden; translate: 0 8px; transition: opacity var(--dur-base) var(--ease-smooth),visibility var(--dur-base) var(--ease-smooth),translate var(--dur-base) var(--ease-out-expo),background-color var(--dur-base) var(--ease-smooth),color var(--dur-base) var(--ease-smooth),border-color var(--dur-base) var(--ease-smooth); }
 .back-to-top[data-visible="true"] { opacity: 1; visibility: visible; translate: 0 0; }
 .back-to-top:is(:hover,:focus-visible) { background: var(--color-accent); color: var(--color-on-accent); border-color: var(--color-accent); }
 @media (hover: hover) { .back-to-top[data-visible="true"]:hover { translate: 0 -2px; box-shadow: var(--shadow-lift); } }
 .back-to-top:active { translate: 0 1px; }
 @view-transition { navigation: auto; }
 ::view-transition-old(root),::view-transition-new(root) { animation-duration: var(--dur-base); }
 @media (max-width: 600px) { .back-to-top { width: 44px; height: 44px; right: 16px; bottom: 18px; } }
 @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }
</style>
