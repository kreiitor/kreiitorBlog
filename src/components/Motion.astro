---
import Icon from './Icon.astro';
---
<a href="#top" class="back-to-top" data-back-to-top aria-label="回到页面顶部" aria-hidden="true" tabindex="-1"><Icon name="up"/></a>
<script>
 const preference = matchMedia('(prefers-reduced-motion: reduce)');
 const header = document.querySelector<HTMLElement>('.site-header');
 const topLink = document.querySelector<HTMLAnchorElement>('[data-back-to-top]');
 const art = document.querySelector<HTMLElement>('.hero-visual');
 const heroEnglish = document.querySelector<HTMLElement>('.hero-english');
 const revealTargets = document.querySelectorAll('.section-heading,.post-card,.project-card,.series-card,.garden-aside,.course-intro,.chapter-row');
 const entrances = new Set<Animation>();
 let framePending = false;
 let lastScrolled: boolean | null = null;
 let lastVisible: boolean | null = null;
 function updateScroll() {
  framePending = false;
  const y = window.scrollY;
  if (header) {
   const scrolled = y > 20;
   if (scrolled !== lastScrolled) { lastScrolled = scrolled; header.dataset.scrolled = String(scrolled); }
  }
  if (topLink) {
   const visible = y > 650;
   if (visible !== lastVisible) {
    lastVisible = visible;
    topLink.dataset.visible = String(visible);
    topLink.setAttribute('aria-hidden', String(!visible));
    topLink.tabIndex = visible ? 0 : -1;
   }
  }
  if (art) art.style.translate = preference.matches || innerWidth < 700 ? '0 0' : `0 ${-Math.min(10,y*.03)}px`;
  if (heroEnglish) heroEnglish.style.translate = preference.matches || innerWidth < 700 ? '0 0' : `0 ${Math.min(5,y*.015)}px`;
 }
 function schedule() { if (!framePending) { framePending = true; requestAnimationFrame(updateScroll); } }
 window.addEventListener('scroll',schedule,{passive:true});
 window.addEventListener('resize',schedule,{passive:true});
 preference.addEventListener('change',() => {
  if (preference.matches) { entrances.forEach(animation => animation.cancel()); entrances.clear(); }
  updateScroll();
 });
 updateScroll();
 if (!preference.matches && 'IntersectionObserver' in window && revealTargets.length) {
  const staggerCache = new Map();
  const observer = new IntersectionObserver(entries => {
   for (const entry of entries) {
    if (!entry.isIntersecting) continue;
    if (preference.matches) { observer.unobserve(entry.target); continue; }
    const element = entry.target;
    let stagger = staggerCache.get(element);
    if (stagger === undefined) {
     stagger = element.matches('.post-card,.project-card,.series-card') ? Array.from(element.parentElement?.children ?? []).indexOf(element)%3*70 : 0;
     staggerCache.set(element, stagger);
    }
    const heading = element.matches('.section-heading');
    const project = element.matches('.project-card');
    const series = element.matches('.series-card');
    const animation = element.animate([
     {opacity:heading ? .65 : .4,transform:project ? 'translateX(10px)' : `translateY(${heading ? 6 : 12}px)`},
     {opacity:1,transform:'translate(0,0)'}
    ],{duration:heading ? 340 : series ? 520 : 420,delay:stagger,easing:'cubic-bezier(.16,1,.3,1)',fill:'backwards'});
    entrances.add(animation);
    animation.finished.then(() => entrances.delete(animation),() => entrances.delete(animation));
    observer.unobserve(element);
    staggerCache.delete(element);
   }
  },{threshold:.07,rootMargin:'0px 0px -16px 0px'});
  revealTargets.forEach(element => observer.observe(element));
 }
</script>
<style is:global>
 .site-header[data-scrolled="true"] { box-shadow: 0 5px 22px var(--color-head-shadow); }
 .back-to-top { position: fixed; bottom: 28px; right: 28px; z-index: 30; display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; border: 1px solid var(--color-line-strong); border-radius: 8px; background: var(--color-paper); color: var(--color-accent-strong); box-shadow: var(--shadow-soft); opacity: 0; visibility: hidden; translate: 0 8px; transition: opacity .25s var(--ease-smooth),visibility .25s var(--ease-smooth),translate .25s var(--ease-out-expo),background-color .2s var(--ease-smooth); }
 .back-to-top[data-visible="true"] { opacity: 1; visibility: visible; translate: 0 0; }
 .back-to-top:hover { background: var(--color-accent-soft); }
 @view-transition { navigation: auto; }
 ::view-transition-old(root),::view-transition-new(root) { animation-duration: .18s; }
 @media (max-width: 600px) { .back-to-top { width: 44px; height: 44px; right: 16px; bottom: 18px; } }
 @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }
</style>
