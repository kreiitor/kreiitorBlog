---
import type { ProjectEntry } from '../utils/content';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';
import TagLink from './TagLink.astro';

interface Props {
	project: ProjectEntry;
}

const { project } = Astro.props;
---

<article class="zen-card group flex h-full flex-col overflow-hidden">
	{project.data.cover && (
		<a href={withBase(`/projects/${project.id}/`)} class="block overflow-hidden">
			<img
				src={withBase(project.data.cover)}
				alt={project.data.title}
				class="h-36 w-full object-cover transition duration-500 group-hover:scale-[1.02]"
				loading="lazy"
			/>
		</a>
	)}
	<div class="flex h-full flex-col gap-4 p-5 sm:p-6">
		<!-- Status + Date -->
		<div class="flex items-center gap-2.5 text-xs">
			<span class="rounded-full bg-[color:var(--color-accent-soft)] px-2.5 py-0.5 font-medium text-[color:var(--color-accent-strong)]">
				{project.data.status}
			</span>
			<span class="text-[color:var(--color-ink-muted)]">
				<time datetime={project.data.pubDate.toISOString()}>{formatDate(project.data.pubDate)}</time>
			</span>
		</div>

		<!-- Title -->
		<h3 class="font-display text-lg font-semibold leading-snug text-[color:var(--color-ink)]">
			<a href={withBase(`/projects/${project.id}/`)} class="transition group-hover:text-[color:var(--color-accent-strong)]">
				{project.data.title}
			</a>
		</h3>

		<!-- Summary -->
		<p class="text-sm leading-7 text-[color:var(--color-ink-soft)] zen-truncate">{project.data.summary}</p>

		<!-- Footer -->
		<div class="mt-auto flex items-center justify-between gap-3 pt-2">
			<div class="flex flex-wrap gap-1.5">
				{project.data.tags.slice(0, 3).map((tag) => (
					<TagLink tag={tag} />
				))}
			</div>
			<a
				href={withBase(`/projects/${project.id}/`)}
				class="shrink-0 text-xs font-medium text-[color:var(--color-ink-muted)] transition group-hover:text-[color:var(--color-accent-strong)]"
			>
				查看 &rarr;
			</a>
		</div>
	</div>
</article>
