---
import type { ProjectEntry } from '../utils/content';
import { withBase } from '../utils/url';
import TagLink from './TagLink.astro';
import Icon from './Icon.astro';
interface Props { project: ProjectEntry; showcase?: boolean; headingLevel?: 'h2' | 'h3'; }
const { project, showcase = false, headingLevel: Heading = 'h3' } = Astro.props;
const href = withBase(`/projects/${project.id}/`);
---
<article class:list={['zen-card','project-card',{'project-showcase':showcase}]}>
 <div class="card-content">
  <div class="card-meta"><span class:list={['project-status', {'is-complete':project.data.status === '已完成', 'is-planned':project.data.status === '规划中'}]}><span aria-hidden="true"></span>{project.data.status}</span></div>
  <Heading><a href={href}>{project.data.title}</a></Heading>
  <p class="card-description zen-truncate">{project.data.summary}</p>
  <div class="card-bottom"><div class="flex flex-wrap gap-1.5">{project.data.tags.slice(0,2).map(tag => <TagLink tag={tag}/>)}</div><a href={href} class="card-arrow" tabindex="-1" aria-hidden="true"><Icon name="arrow"/></a></div>
 </div>
</article>
<style>
 .project-card { display: flex; flex-direction: column; }
 .project-card .card-content { min-width: 0; gap: 12px; }
 .project-card :is(h2,h3) { font-size: 21px; line-height: 1.45; }
 .project-status { display: inline-flex; align-items: center; gap: 8px; padding: 2px 10px 2px 8px; border: 1px solid var(--color-line); border-radius: 999px; color: var(--color-counterpoint-ink); font-size: 12.5px; font-weight: 600; }
 .project-status span { position: relative; width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background: currentColor; }
 .project-status:not(.is-complete):not(.is-planned) span::after { content: ''; position: absolute; inset: -3px; border: 1px solid currentColor; border-radius: 50%; animation: status-pulse 2.2s var(--ease-smooth) infinite; }
 .project-status.is-complete { color: var(--color-sage); }
 .project-status.is-planned { color: var(--color-ink-muted); }
 .project-showcase .card-content { padding: 26px 28px 28px; }
 .project-showcase :is(h2,h3) { font-size: 24px; }
 .project-showcase .card-description { line-height: 1.85; }
 @keyframes status-pulse { from { opacity: .8; transform: scale(.6); } to { opacity: 0; transform: scale(2); } }
 @media (max-width: 600px) {
  .project-card .card-content,.project-showcase .card-content { padding: 22px; }
  .project-card :is(h2,h3),.project-showcase :is(h2,h3) { font-size: 21px; }
  .project-card .card-description { -webkit-line-clamp: 4; }
 }
</style>
