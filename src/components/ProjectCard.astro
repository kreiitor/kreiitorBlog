---
import type { ProjectEntry } from '../utils/content';
import { withBase } from '../utils/url';
import TagLink from './TagLink.astro';
interface Props { project: ProjectEntry; }
const { project } = Astro.props;
const href = withBase(`/projects/${project.id}/`);
---
<article class="zen-card project-card">
 <a href={href} class="project-image" tabindex="-1" aria-hidden="true"><img src={withBase(project.data.cover ?? '/covers/project-benchmark.svg')} alt="" loading="lazy" width="800" height="420"/></a>
 <div class="card-content">
  <div class="card-meta"><span class="project-status"><span aria-hidden="true"></span>{project.data.status}</span><span>RESEARCH PROJECT</span></div>
  <h3><a href={href}>{project.data.title}</a></h3>
  <p class="card-description zen-truncate">{project.data.summary}</p>
  <div class="card-bottom"><div class="flex flex-wrap gap-1.5">{project.data.tags.slice(0,2).map(tag => <TagLink tag={tag}/>)}</div><a href={href} class="card-arrow" aria-label={`查看项目：${project.data.title}`}>↗</a></div>
 </div>
</article>
<style>
 .project-card { display: grid; grid-template-columns: 170px minmax(0,1fr); overflow: hidden; }
 .project-image { height: 100%; background: var(--color-paper-cool); overflow: hidden; border-right: 1px solid var(--color-line); }
 .project-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .55s var(--ease-out-expo); }
 .project-card:hover .project-image img { transform: scale(1.04); }
 .project-status { display: flex; align-items: center; gap: 6px; color: var(--color-accent-strong); font-weight: 500; }
 .project-status span { width: 6px; height: 6px; background: var(--color-accent); border-radius: 50%; flex-shrink: 0; }
 @media (max-width: 1100px) { .project-card { grid-template-columns: 130px minmax(0,1fr); } }
 @media (max-width: 600px) { .project-card { grid-template-columns: minmax(0,1fr); } .project-image { height: 150px; border-right: 0; border-bottom: 1px solid var(--color-line); } }
</style>
