---
import { navLinks, siteConfig } from '../data/site';
import { withBase } from '../utils/url';
import Icon from './Icon.astro';
import brandSvg from '../../public/logo.svg?raw';
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const active = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header class="site-header" data-over-hero={currentPath === '/' ? 'true' : undefined}>
 <div class="page-shell header-inner">
  <a href={withBase('/')} class="brand" title="首页">
   <span class="brand-mark" aria-hidden="true" set:html={brandSvg}/>
   <span class="brand-name">kreiitor<span class="brand-subtitle">研究札记</span></span>
   <span class="sr-only">，首页</span>
  </a>
  <nav class="desktop-nav" aria-label="主导航">
   {navLinks.map(item => <a href={withBase(item.href)} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <div class="header-actions">
   <a href={withBase('/search/')} class="header-search" aria-label="搜索文章" data-search-link>
    <Icon name="search" size={20}/>
    <span>搜索</span><kbd aria-hidden="true">⌘ K</kbd>
   </a>
   <button type="button" class="theme-toggle" data-theme-toggle aria-label="主题：浅色" title="主题：浅色">
    <svg class="icon-light" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"/></svg>
    <svg class="icon-dark" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
   </button>
   <a href={siteConfig.socialLinks[0].href} class="header-github" target="_blank" rel="noreferrer" aria-label="GitHub 主页">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.45-1.11-1.45-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
   </a>
   <details class="mobile-menu">
    <summary aria-label="展开导航"><span class="menu-icon menu-icon-open"><Icon name="menu"/></span><span class="menu-icon menu-icon-close"><Icon name="close"/></span></summary>
    <nav aria-label="移动端导航">{navLinks.map(item => <a href={withBase(item.href)} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}<a href={withBase('/archive/')}>文章归档</a></nav>
   </details>
  </div>
 </div>
 <button type="button" class="menu-backdrop" aria-label="关闭导航" tabindex="-1"></button>
</header>
<script>
 const searchLink = document.querySelector<HTMLAnchorElement>('[data-search-link]');
 const shortcut = searchLink?.querySelector('kbd');
 if (shortcut && !/Mac|iPhone|iPad/.test(navigator.userAgent)) shortcut.textContent = 'Ctrl K';
 function search() {
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  if (dialog) document.dispatchEvent(new Event('search:request'));
  else { const input = document.querySelector<HTMLInputElement>('[data-search-input]'); if (input) { input.focus(); input.select(); } }
 }
 searchLink?.addEventListener('click',event=>{ if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return; if(document.querySelector('[data-search-dialog]')||document.querySelector('[data-search-input]')){event.preventDefault();search();} });
 document.addEventListener('keydown', event => {
  if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k' && searchLink) {
   event.preventDefault();
   search();
  }
  if (event.key === 'Escape') { const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu'); if(menu?.open){menu.open=false;menu.querySelector('summary')?.focus();} }
 });
 const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu');
 matchMedia('(min-width: 901px)').addEventListener('change',event=>{if(event.matches&&menu)menu.open=false;});
 menu?.addEventListener('toggle',()=>{menu.querySelector('summary')?.setAttribute('aria-expanded',String(menu.open));menu.querySelector('summary')?.setAttribute('aria-label',menu.open?'收起导航':'展开导航');document.documentElement.classList.toggle('menu-is-open',menu.open);});
 menu?.addEventListener('focusout',()=>{setTimeout(()=>{if(menu.open&&!menu.contains(document.activeElement))menu.open=false;},0);});
 menu?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));
 document.addEventListener('click', event => {
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
 });

 // 两态循环：浅色 ⇄ 深色。首次访问由 BaseLayout 按系统偏好写入存储，
 // 之后按钮只在这两个显式值之间切换（语义见 BaseLayout 的防闪白脚本）。
 document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(btn => {
  btn.addEventListener('click', () => {
   const cur = btn.getAttribute('data-pref') === 'dark' ? 'dark' : 'light';
   const next = cur === 'dark' ? 'light' : 'dark';
   try { localStorage.setItem('theme', next); } catch { /* 隐私模式下存储不可用，仍就地切换生效 */ }
   if (typeof window.__applyTheme === 'function') window.__applyTheme(next);
   else document.documentElement.setAttribute('data-theme', next);
  });
 });
 // 首帧同步按钮状态（head 内联脚本执行时按钮还不存在）
 if (typeof window.__applyTheme === 'function') window.__applyTheme();
</script>
<style>
 .site-header { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb,var(--color-paper) 82%,transparent); border-bottom: 1px solid var(--color-line); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); transition: background-color var(--dur-slow) var(--ease-smooth),border-color var(--dur-slow) var(--ease-smooth); view-transition-name: site-header; }
 /* 首页主视觉上方：透明底，取暗色令牌；离开主视觉后由 Motion.astro 去掉 data-over-hero。 */
 .site-header[data-over-hero="true"] { background: transparent; border-bottom-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
 /* 高度固定：滚动越过阈值时改变高度会让整页内容跳动。 */
 .header-inner { height: var(--header-height); display: flex; justify-content: space-between; align-items: center; gap: 30px; }
 .brand { display: flex; gap: 12px; align-items: center; color: var(--color-ink); }
 .brand-mark { display: flex; align-items: center; transition: transform var(--dur-slow) var(--ease-out-expo); }
 .brand-mark :global(svg) { width: 32px; height: 32px; display: block; }
 .brand-mark :global(path) { fill: var(--color-ink); transition: fill var(--dur-base); }
 .brand-mark :global(circle) { fill: var(--color-accent); transform-origin: 52px 12px; transition: transform var(--dur-slow) var(--ease-out-expo); }
 .brand:is(:hover,:focus-visible) .brand-mark { transform: rotate(-4deg); }
 .brand:is(:hover,:focus-visible) .brand-mark :global(circle) { transform: scale(1.5); }
 .brand-name { display: flex; align-items: baseline; font-family: var(--font-display); font-size: 20px; font-weight: 600; letter-spacing: -.01em; line-height: 1.2; }
 .brand-subtitle { margin-left: 12px; padding-left: 12px; border-left: 1px solid var(--color-line-strong); color: var(--color-ink-soft); font-family: var(--font-sans); font-size: 12.5px; font-weight: 500; letter-spacing: .08em; white-space: nowrap; }
 .desktop-nav { display: flex; gap: 4px; align-items: center; padding: 4px; border: 1px solid var(--color-line); border-radius: 999px; background: color-mix(in srgb,var(--color-surface) 55%,transparent); }
 .desktop-nav a { position: relative; z-index: 0; display: inline-flex; align-items: center; min-height: 36px; padding: 0 16px; border-radius: 999px; color: var(--color-ink-soft); font-size: 14px; font-weight: 500; transition: color var(--dur-base) var(--ease-smooth); }
 .desktop-nav a::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: var(--color-surface-hover); opacity: 0; transform: scale(.85); transition: opacity var(--dur-base),transform var(--dur-base) var(--ease-out-expo); }
 .desktop-nav a:is(:hover,:focus-visible) { color: var(--color-ink); }
 .desktop-nav a:is(:hover,:focus-visible)::before { opacity: 1; transform: none; }
 .desktop-nav a[aria-current] { color: var(--color-on-primary); font-weight: 600; }
 .desktop-nav a[aria-current]::before { background: var(--color-primary); opacity: 1; transform: none; }
 .header-actions { display: flex; align-items: center; gap: 6px; }
 .header-search { display: flex; min-width: 44px; justify-content: center; min-height: 40px; gap: 10px; align-items: center; padding: 0 8px 0 14px; border: 1px solid var(--color-line); border-radius: 999px; color: var(--color-ink-soft); font-size: 13px; transition: color var(--dur-base),border-color var(--dur-base),background-color var(--dur-base); }
 .header-search:hover { color: var(--color-ink); border-color: var(--color-line-strong); background: var(--color-surface); }
 kbd { padding: 1px 7px; border: 1px solid var(--color-line); border-radius: 6px; background: var(--color-surface-soft); font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-muted); }
 .header-github,.theme-toggle { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; border-radius: 999px; color: var(--color-ink-soft); transition: color var(--dur-base),background-color var(--dur-base); }
 .header-github:hover,.theme-toggle:hover { color: var(--color-ink); background: var(--color-surface-hover); }
 /* 两态主题切换：data-pref 未设置时默认显示浅色图标，避免 JS 未跑时按钮空白。 */
 .theme-toggle svg { display: none; }
 .theme-toggle .icon-light { display: block; }
 .theme-toggle[data-pref="light"] .icon-dark,
 .theme-toggle[data-pref="dark"] .icon-light { display: none; }
 .theme-toggle[data-pref="dark"] .icon-dark { display: block; }
 .theme-toggle:active svg { transform: rotate(-30deg) scale(.9); }
 .theme-toggle svg { transition: transform var(--dur-slow) var(--ease-out-expo); }
 .mobile-menu { display: none; }
 .menu-backdrop { display: none; }
 @media (max-width: 900px) {
  .header-inner { gap: 16px; }
  .brand-name { font-size: 18px; } .brand-mark :global(svg) { width: 28px; height: 28px; }
  .desktop-nav,.header-search span,kbd,.header-github { display: none; }
  .header-search { padding: 0; border: 0; min-height: 44px; }
  .header-actions { gap: 2px; }
  .mobile-menu { display: block; }
  .mobile-menu summary { display: flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; padding: 10px; cursor: pointer; list-style: none; border-radius: 999px; transition: background-color var(--dur-base) var(--ease-smooth); }
  .mobile-menu summary:hover { background: var(--color-surface-hover); }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu .menu-icon { display: flex; align-items: center; justify-content: center; }
  .mobile-menu .menu-icon-close { display: none; }
  .mobile-menu[open] .menu-icon-open { display: none; }
  .mobile-menu[open] .menu-icon-close { display: flex; }
  .site-header:has(.mobile-menu[open]) .menu-backdrop { display: block; position: absolute; top: 100%; left: 0; width: 100%; height: calc(100dvh - var(--header-height)); background: var(--color-overlay); z-index: -1; }
  .mobile-menu nav { position: absolute; top: 100%; z-index: 1; left: 0; width: 100%; max-height: calc(100dvh - var(--header-height)); overflow-y: auto; overscroll-behavior: contain; padding: 8px max(24px,env(safe-area-inset-right)) max(24px,env(safe-area-inset-bottom)) max(24px,env(safe-area-inset-left)); background: var(--color-paper); border-bottom: 1px solid var(--color-line); box-shadow: var(--shadow-soft); animation: menuSlide var(--dur-base) var(--ease-out-expo); }
  .mobile-menu nav a { display: flex; align-items: center; justify-content: space-between; min-height: 52px; border-bottom: 1px solid var(--color-line); font-family: var(--font-display); font-size: 18px; transition: color var(--dur-base) var(--ease-smooth),padding-left var(--dur-base) var(--ease-out-expo); }
  .mobile-menu nav a::after { content: '→'; color: var(--color-ink-muted); font-family: var(--font-sans); font-size: 14px; }
  .mobile-menu nav a:is(:hover,:focus-visible) { color: var(--color-accent); padding-left: 4px; }
  .mobile-menu nav a[aria-current] { color: var(--color-accent); }
 }
 @media (max-width: 400px) { .brand-subtitle { display: none; } }
 @keyframes menuSlide { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
</style>
