---
import { navLinks, siteConfig } from '../data/site';
import { withBase } from '../utils/url';

interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-[color:var(--color-line)] bg-[rgba(250,247,242,0.82)] backdrop-blur-xl backdrop-saturate-[180%]">
	<div class="page-shell flex h-14 items-center justify-between gap-4">
		<!-- Logo -->
		<a href={withBase('/')} class="group flex items-center gap-2.5 transition hover:opacity-80">
			<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[color:var(--color-ink)] font-display text-[0.65rem] font-semibold tracking-wider text-[color:var(--color-paper)] transition group-hover:bg-[color:var(--color-accent-strong)]">
				AI
			</div>
			<span class="hidden font-display text-base font-semibold text-[color:var(--color-ink)] sm:block">
				{siteConfig.title}
			</span>
		</a>

		<!-- Navigation -->
		<nav class="flex items-center gap-1">
			{navLinks.map((item) => {
				const active =
					item.href === '/'
						? currentPath === '/'
						: currentPath.startsWith(item.href.replace(/\/$/, ''));

				return (
					<a
						href={withBase(item.href)}
						class:list={[
							'relative rounded-full px-3.5 py-1.5 text-[0.8125rem] font-medium transition-all duration-200',
							active
								? 'bg-[color:var(--color-ink)] text-[color:var(--color-paper)]'
								: 'text-[color:var(--color-ink-soft)] hover:text-[color:var(--color-ink)] hover:bg-[rgba(44,40,37,0.04)]',
						]}
					>
						{item.label}
					</a>
				);
			})}
		</nav>

		<!-- Search -->
		<a
			href={withBase('/search/')}
			class="flex h-8 w-8 items-center justify-center rounded-full text-[color:var(--color-ink-soft)] transition hover:bg-[rgba(44,40,37,0.04)] hover:text-[color:var(--color-ink)]"
			aria-label="搜索"
			title="搜索"
		>
			<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current stroke-[1.8]">
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m20 20-3.5-3.5"></path>
			</svg>
		</a>
	</div>
</header>
