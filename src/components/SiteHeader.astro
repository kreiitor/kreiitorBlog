---
import { navLinks, siteConfig } from '../data/site';
import { withBase } from '../utils/url';
import Icon from './Icon.astro';
import brandSvg from '../../public/logo.svg?raw';
interface Props { currentPath: string; section?: string; }
const { currentPath, section } = Astro.props;
const active = (item: { href: string; section?: string }) => section ? item.section === section : item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
---
<header class="site-header">
 <div class="page-shell header-inner">
  <a href={withBase('/')} class="brand" title="首页">
   <span class="brand-mark" aria-hidden="true" set:html={brandSvg}/>
   <span class="brand-name">千羽<span class="brand-subtitle">senbazuru</span></span>
   <span class="sr-only">，首页</span>
  </a>
  <nav class="desktop-nav" aria-label="主导航">
   {navLinks.map(item => <a href={withBase(item.href)} aria-current={active(item) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <div class="header-actions">
   <a href={withBase('/search/')} class="header-search" aria-label="搜索文章" data-search-link>
    <Icon name="search" size={16}/>
    <span>搜索</span><kbd aria-hidden="true">⌘K</kbd>
   </a>
   <button type="button" class="theme-toggle" data-theme-toggle aria-label="主题：浅色" title="主题：浅色">
    <svg class="icon-light" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"/></svg>
    <svg class="icon-dark" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
   </button>
   <a href={siteConfig.socialLinks[0].href} class="header-github" target="_blank" rel="noreferrer" aria-label="GitHub 主页">
    <Icon name="github" size={17}/>
   </a>
   <details class="mobile-menu">
    <summary aria-label="展开导航" aria-expanded="false"><span class="menu-icon menu-icon-open"><Icon name="menu"/></span><span class="menu-icon menu-icon-close"><Icon name="close"/></span></summary>
    <nav aria-label="移动端导航">{navLinks.map(item => <a href={withBase(item.href)} aria-current={active(item) ? 'page' : undefined}>{item.label}</a>)}<a href={withBase('/projects/')}>研究项目</a><a href={withBase('/archive/')}>归档</a></nav>
   </details>
  </div>
 </div>
 <button type="button" class="menu-backdrop" aria-label="关闭导航" tabindex="-1"></button>
</header>
<script>
 const searchLink = document.querySelector<HTMLAnchorElement>('[data-search-link]');
 const shortcut = searchLink?.querySelector('kbd');
 if (shortcut && !/Mac|iPhone|iPad/.test(navigator.userAgent)) shortcut.textContent = 'Ctrl K';
 function search() {
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  if (dialog) document.dispatchEvent(new Event('search:request'));
  else { const input = document.querySelector<HTMLInputElement>('[data-search-input]'); if (input) { input.focus(); input.select(); } }
 }
 searchLink?.addEventListener('click',event=>{ if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return; if(document.querySelector('[data-search-dialog]')||document.querySelector('[data-search-input]')){event.preventDefault();search();} });
 document.addEventListener('keydown', event => {
  if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k' && searchLink) {
   event.preventDefault();
   search();
  }
  if (event.key === 'Escape') { const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu'); if(menu?.open){menu.open=false;menu.querySelector('summary')?.focus();} }
 });
 const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu');
 matchMedia('(min-width: 901px)').addEventListener('change',event=>{if(event.matches&&menu)menu.open=false;});
 menu?.addEventListener('toggle',()=>{menu.querySelector('summary')?.setAttribute('aria-expanded',String(menu.open));menu.querySelector('summary')?.setAttribute('aria-label',menu.open?'收起导航':'展开导航');document.documentElement.classList.toggle('menu-is-open',menu.open);});
 menu?.addEventListener('focusout',()=>{setTimeout(()=>{if(menu.open&&!menu.contains(document.activeElement))menu.open=false;},0);});
 menu?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));
 document.addEventListener('click', event => {
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
 });

 document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(btn => {
  btn.addEventListener('click', () => {
   const cur = btn.getAttribute('data-pref') === 'dark' ? 'dark' : 'light';
   const next = cur === 'dark' ? 'light' : 'dark';
   try { localStorage.setItem('theme', next); } catch {}
   const root = document.documentElement;
   root.classList.add('theme-switching');
   if (typeof window.__applyTheme === 'function') window.__applyTheme(next);
   else root.setAttribute('data-theme', next);
   requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')));
  });
 });
 if (typeof window.__applyTheme === 'function') window.__applyTheme();
</script>
<style>
 /* Warm Porcelain Sticky Header */
 .site-header { position: sticky; top: 0; z-index: 40; background: var(--color-glass); border-bottom: 1px solid var(--color-line); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2); transition: background-color var(--dur-base) var(--ease-smooth),border-color var(--dur-base) var(--ease-smooth),box-shadow var(--dur-base) var(--ease-smooth); view-transition-name: site-header; }
 .site-header[data-scrolled="true"] { background: var(--color-glass-strong); box-shadow: 0 6px 20px -14px var(--color-head-shadow); }
 .header-inner { height: var(--header-height); display: flex; justify-content: space-between; align-items: center; gap: 24px; }
 .brand { display: flex; gap: 11px; align-items: center; color: var(--color-ink); }
 .brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--color-line); background: var(--color-surface); box-shadow: var(--shadow-whisper); transition: transform var(--dur-slow) var(--ease-out-expo),border-color var(--dur-base); }
 .brand-mark :global(svg) { width: 22px; height: 22px; display: block; }
 .brand-mark :global(.brand-ink) { fill: var(--color-ink); transition: fill var(--dur-base); }
 .brand-mark :global(.brand-accent) { fill: var(--color-vermilion); }
 .brand-mark :global(.brand-far-wing) { transition: fill-opacity var(--dur-base); }
 .brand:is(:hover,:focus-visible) .brand-mark { transform: translateY(-1px) rotate(-4deg); border-color: var(--color-accent); }
 .brand-name { display: flex; align-items: baseline; font-family: var(--font-display); font-size: 18px; font-weight: 700; letter-spacing: .04em; line-height: 1.2; }
 .brand-subtitle { margin-left: 10px; padding-left: 10px; border-left: 1px solid var(--color-line-strong); color: var(--color-ink-muted); font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: .08em; white-space: nowrap; }
 .desktop-nav { display: flex; gap: 4px; align-items: center; padding: 4px; border: 1px solid var(--color-line); border-radius: 999px; background: var(--color-surface); box-shadow: var(--shadow-whisper); }
 .desktop-nav a { position: relative; z-index: 0; display: inline-flex; align-items: center; min-height: 34px; padding: 0 15px; border-radius: 999px; color: var(--color-ink-soft); font-size: 13.5px; font-weight: 500; transition: color var(--dur-base) var(--ease-smooth),background-color var(--dur-base) var(--ease-smooth); }
 .desktop-nav a:is(:hover,:focus-visible) { color: var(--color-ink); background: var(--color-surface-soft); }
 .desktop-nav a[aria-current] { color: var(--color-nav-current-ink); background: var(--color-nav-current-bg); font-weight: 600; }
 .header-actions { display: flex; align-items: center; gap: 6px; }
 .header-search { display: flex; min-width: 44px; justify-content: center; min-height: 38px; gap: 8px; align-items: center; padding: 0 8px 0 14px; border: 1px solid var(--color-line-strong); border-radius: 999px; background: var(--color-surface); box-shadow: var(--shadow-whisper); color: var(--color-ink-soft); font-size: 13px; transition: color var(--dur-base),border-color var(--dur-base),background-color var(--dur-base); }
 .header-search:hover { color: var(--color-ink); border-color: var(--color-accent); background: var(--color-surface-soft); }
 kbd { padding: 1px 7px; border: 1px solid var(--color-line); border-radius: 999px; background: var(--color-surface-soft); font-family: var(--font-mono); font-size: 10.5px; color: var(--color-ink-muted); }
 .header-github,.theme-toggle { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; min-height: 40px; border: 1px solid var(--color-line); border-radius: 999px; background: var(--color-surface); box-shadow: var(--shadow-whisper); color: var(--color-ink-soft); transition: color var(--dur-base),background-color var(--dur-base),border-color var(--dur-base); }
 .header-github:hover,.theme-toggle:hover { color: var(--color-accent-strong); border-color: var(--color-accent); background: var(--color-surface-soft); }
 .theme-toggle svg { display: none; transition: transform var(--dur-slow) var(--ease-out-expo); }
 .theme-toggle .icon-light { display: block; }
 .theme-toggle[data-pref="light"] .icon-dark,
 .theme-toggle[data-pref="dark"] .icon-light { display: none; }
 .theme-toggle[data-pref="dark"] .icon-dark { display: block; }
 .theme-toggle:active svg { transform: rotate(-30deg) scale(.9); }
 .mobile-menu { display: none; }
 .menu-backdrop { display: none; }
 @media (max-width: 900px) {
  .header-inner { gap: 12px; }
  .brand-name { font-size: 17px; }
  .desktop-nav,.header-search span,kbd,.header-github { display: none; }
  .header-search { padding: 0; border-color: var(--color-line); min-height: 40px; width: 40px; }
  .header-actions { gap: 6px; }
  .mobile-menu { display: block; }
  .mobile-menu summary { display: flex; min-width: 40px; min-height: 40px; align-items: center; justify-content: center; border: 1px solid var(--color-line); border-radius: 999px; background: var(--color-glass-strong); cursor: pointer; list-style: none; transition: background-color var(--dur-base) var(--ease-smooth); }
  .mobile-menu summary:hover { background: var(--color-surface); }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu .menu-icon { display: flex; align-items: center; justify-content: center; }
  .mobile-menu .menu-icon-close { display: none; }
  .mobile-menu[open] .menu-icon-open { display: none; }
  .mobile-menu[open] .menu-icon-close { display: flex; }
  .site-header:has(.mobile-menu[open]) .menu-backdrop { display: block; position: absolute; top: 100%; left: 0; width: 100%; height: calc(100dvh - var(--header-height)); background: var(--color-overlay); backdrop-filter: blur(8px); z-index: -1; }
  .mobile-menu nav { position: absolute; top: 100%; z-index: 1; left: 0; width: 100%; max-height: calc(100dvh - var(--header-height)); overflow-y: auto; overscroll-behavior: contain; padding: 12px max(24px,env(safe-area-inset-right)) max(28px,env(safe-area-inset-bottom)) max(24px,env(safe-area-inset-left)); background: var(--color-paper); border-bottom: 1px solid var(--color-line); box-shadow: var(--shadow-lift); animation: menuSlide var(--dur-base) var(--ease-out-expo); }
  .mobile-menu nav a { display: flex; align-items: center; justify-content: space-between; min-height: 52px; border-bottom: 1px solid var(--color-line); font-family: var(--font-display); font-size: 17px; font-weight: 600; transition: color var(--dur-base) var(--ease-smooth),padding-left var(--dur-base) var(--ease-out-expo); }
  .mobile-menu nav a::after { content: '→'; color: var(--color-ink-muted); font-family: var(--font-mono); font-size: 13px; }
  .mobile-menu nav a:is(:hover,:focus-visible) { color: var(--color-accent); padding-left: 4px; }
  .mobile-menu nav a[aria-current] { color: var(--color-accent); }
 }
 @media (max-width: 420px) { .brand-subtitle { display: none; } }
 @keyframes menuSlide { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
</style>
