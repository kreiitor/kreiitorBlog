---
import { giscusConfig, isGiscusConfigured } from '../utils/giscus';
import { siteConfig } from '../data/site';
---
<section class="zen-card-flat p-6 sm:p-8">
 <p class="eyebrow">CONTINUE THE CONVERSATION</p><h2 class="mt-3 text-xl">讨论与反馈</h2><p class="mt-3 text-sm text-[color:var(--color-ink-soft)]">欢迎围绕文章里的问题、思路和实现细节继续交流。</p>
 {isGiscusConfigured ? <div id="giscus-container" class="mt-6"></div> : <a href={`mailto:${siteConfig.email}`} class="text-link mt-5">通过邮件交流 ↗</a>}
</section>
{isGiscusConfigured && <script is:inline define:vars={{ giscusConfig }}>
 const host=document.getElementById('giscus-container');
 if(host && !host.querySelector('script')) {
  const script=document.createElement('script');script.src='https://giscus.app/client.js';script.async=true;script.crossOrigin='anonymous';
  const attributes={'repo':giscusConfig.repo,'repo-id':giscusConfig.repoId,'category':giscusConfig.category,'category-id':giscusConfig.categoryId,'mapping':giscusConfig.mapping,'strict':giscusConfig.strict,'reactions-enabled':giscusConfig.reactionsEnabled,'emit-metadata':giscusConfig.emitMetadata,'input-position':giscusConfig.inputPosition,'theme':'light','lang':giscusConfig.lang};
  Object.entries(attributes).forEach(([key,value])=>script.setAttribute('data-'+key,value));host.append(script);
 }
</script>}
