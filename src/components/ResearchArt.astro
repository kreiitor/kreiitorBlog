   <circle cx="299" cy="248" r="4" fill="var(--color-accent)"/>
   <path d="M174 318h48m12 0h48m12 0h36" stroke="var(--color-line-strong)" stroke-linecap="round"/>
  </g></g>
  <!-- 简洁几何徽记：打开的书 -->
  <g class="art-layer art-layer-badges">
  <g transform="translate(88 148)">
   <circle r="26" fill="var(--color-surface)" stroke="var(--color-line-strong)"/>
   <path d="M-11-6c4-2.5 7-2.5 11 0 4-2.5 7-2.5 11 0v13c-4-2.5-7-2.5-11 0-4 2.5-7 2.5-11 0v-13Z M0-6v13" stroke="var(--color-sage)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  </g>
