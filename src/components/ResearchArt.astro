   <text class="art-detail" x="174" y="150" font-family="Georgia,serif" font-size="30" fill="var(--color-ink)">Read. Build.</text>
   <text class="art-detail" x="174" y="188" font-family="Georgia,serif" font-size="29" font-style="italic" fill="var(--color-accent)">Then verify.</text>
   <g class="art-mobile-mark" stroke="var(--color-sage)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M212 202h80M212 202v-78m8 58 22-29 21 12 25-36"/>
    <circle cx="288" cy="129" r="6" fill="var(--color-accent)" stroke="none"/>
