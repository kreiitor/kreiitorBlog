   <rect x="152" y="66" width="200" height="268" rx="6" fill="var(--color-ink)" opacity=".07" transform="translate(5 8)"/>
   <rect x="152" y="66" width="200" height="268" rx="6" fill="var(--color-surface)" stroke="var(--color-line-strong)"/>
   <path d="M174 100h156" stroke="var(--color-line)"/>
