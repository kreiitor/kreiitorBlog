<figure class="research-art" aria-label="从论文阅读到实验求证的研究手记插画">
 <div class="art-top"><span>Research notebook</span><span>Paper / Code</span></div>
 <svg viewBox="0 0 500 400" width="500" height="400" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs><pattern id="garden-grid" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".65" fill="var(--color-line-strong)" opacity=".4"/></pattern></defs>
  <rect width="500" height="400" fill="url(#garden-grid)"/>
