  <circle cx="458" cy="330" r="4" fill="var(--color-accent)"/>
 </svg>
 <figcaption><span>阅读 · 实验 · 写作</span><span>从问题出发，用实验求证。</span></figcaption>
</figure>
<style>
 .research-art { --color-surface: var(--color-hero-paper); --color-paper-warm: #f6b18f; --color-ink: var(--color-hero-ink); --color-ink-muted: #665064; --color-line: #d9bcac; --color-line-strong: var(--color-hero-line); --color-sage: #293ccb; --color-accent: #293ccb; background: var(--color-hero-panel); border: 1px solid rgb(255 255 255 / .12); border-radius: 4px; padding: 22px 24px 18px; overflow: hidden; box-shadow: 10px 10px 0 var(--color-counterpoint); }
 .art-top { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; letter-spacing: .025em; color: #f5f1ff; }
 svg { display: block; width: 100%; height: auto; margin-block: 6px; }
 .art-mobile-mark { display: none; }
 figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; padding-top: 13px; border-top: 1px solid rgb(255 255 255 / .3); font-size: 12px; color: #fff4df; }
 figcaption span { white-space: nowrap; }
 .art-layer { transform-box: fill-box; transform-origin: center; animation: art-settle 720ms var(--ease-out-expo) both; transition: translate 320ms var(--ease-out-expo),rotate 320ms var(--ease-out-expo); }
 .art-layer-note { animation-delay: 60ms; }
 .art-layer-paper { animation-delay: 160ms; }
 .art-layer-badges { animation-delay: 280ms; }
 .art-orbit { transform-box: fill-box; transform-origin: center; animation: art-orbit-arrive 900ms 120ms var(--ease-out-expo) both; }
 .art-route { animation: art-route-arrive 1100ms var(--ease-out-expo) both; }
 @keyframes art-settle { from { opacity: 0; transform: translateY(16px) rotate(2deg); } to { opacity: 1; transform: translateY(0) rotate(0); } }
 @keyframes art-orbit-arrive { from { opacity: .25; transform: scale(.95); } to { opacity: 1; transform: scale(1); } }
 @keyframes art-route-arrive { from { stroke-dashoffset: 30; } to { stroke-dashoffset: 0; } }
 @media (hover: hover) and (prefers-reduced-motion: no-preference) { .research-art:hover .art-layer-note { translate: 3px -3px; rotate: 1deg; } .research-art:hover .art-layer-paper { translate: 0 -3px; } .research-art:hover .art-layer-badges { translate: -2px 1px; } }
 @media (prefers-reduced-motion: reduce) { .art-layer,.art-orbit,.art-route { animation: none; translate: none; rotate: none; } }
 /* SVG colors inherit both the manual theme and the system preference. */
 @media (max-width: 700px) { .research-art { padding: 12px 18px; display: grid; grid-template-columns: minmax(0, 1fr) 72px; align-items: center; border-radius: 4px; } .art-top { display: block; font-size: 10px; letter-spacing: .04em; } .art-top span:last-child { display: none; } svg { grid-column: 2; grid-row: 1 / 3; width: 88px; max-width: none; margin: 0 -8px; } .art-detail { display: none; } .art-mobile-mark { display: block; } figcaption { grid-column: 1; display: block; font-size: 11px; line-height: 1.7; border: 0; padding-top: 4px; } figcaption span { display: block; } }
</style>
