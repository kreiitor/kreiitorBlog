---
import Icon from './Icon.astro';
import { withBase } from '../utils/url';
---
<aside class="research-art" aria-label="从一个问题开始探索">
 <div class="art-top"><span>研究从一个问题开始</span><svg viewBox="0 0 36 36" width="36" height="36" aria-hidden="true"><path d="M18 3v30M3 18h30M7.4 7.4l21.2 21.2M7.4 28.6 28.6 7.4" stroke="currentColor" stroke-width="3"/></svg></div>
 <div class="art-papers">
  <a class="question-paper art-layer" href={withBase('/blog/llm-eval-pipeline/')}>
   <span class="paper-label">一个值得追问的问题</span>
   <strong>怎样判断，<br/>模型真的有用？</strong>
   <span class="paper-description">把评测做成可持续迭代的实验。</span>
   <span class="paper-link">从研究札记开始 <Icon name="arrow" size={20}/></span>
   <span class="paper-mobile">研究札记 <Icon name="arrow" size={16}/></span>
  </a>
  <a class="reading-paper art-layer" href={withBase('/blog/paper-reading-notes/')}><Icon name="book" size={22}/><span><strong>读一篇论文</strong><small>把阅读变成自己的理解</small></span><Icon name="arrow" size={18}/></a>
  <a class="experiment-paper art-layer" href={withBase('/projects/paper-replication-workbench/')}><Icon name="layers" size={22}/><span><strong>跑一次实验</strong><small>让想法与证据相遇</small></span><Icon name="arrow" size={18}/></a>
 </div>
 <p class="art-caption">阅读给出线索，实验留下证据。</p>
</aside>
<style>
 .research-art { padding: 20px; border-radius: 6px; background: var(--color-hero-panel); color: white; position: relative; }
 .art-top { display: flex; justify-content: space-between; align-items: center; gap: 20px; font-size: 13px; }
 .art-top > svg { color: var(--color-highlight); }
 .art-papers { display: grid; gap: 10px; margin-top: 16px; }
 .question-paper { display: block; position: relative; background: var(--color-highlight); color: var(--color-hero-ink); padding: 18px; border-radius: 3px; transform: rotate(-2deg); box-shadow: 5px 7px 0 rgb(0 0 0 / .14); }
 .paper-label { display: block; font-size: 12px; margin-bottom: 6px; }
 .question-paper strong { display: block; font-family: var(--font-title); font-size: clamp(23px,2vw,27px); font-weight: 600; line-height: 1.35; }
 .paper-description { display: none; font-size: 12px; margin-top: 12px; }
 .paper-link { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; padding-top: 10px; border-top: 1px solid currentColor; font-size: 13px; }
 .paper-mobile { display: none; }
 .reading-paper,.experiment-paper { display: flex; align-items: center; gap: 12px; padding: 10px 14px; min-height: 48px; border-radius: 3px; color: var(--color-hero-ink); background: #fdfefb; }
 .reading-paper > span,.experiment-paper > span { flex: 1; }
 .art-papers strong { font-weight: 600; }
 .reading-paper strong,.experiment-paper strong { font-size: 14px; }
 small { display: none; font-size: 11px; margin-top: 2px; color: #526078; }
 .art-caption { margin-top: 14px; color: white; font-size: 12px; }
 .art-layer { transition: transform var(--dur-base) var(--ease-out-expo),box-shadow var(--dur-base); }
 .art-layer:focus-visible { outline-color: white; outline-offset: 5px; }
 @media(hover:hover) and (prefers-reduced-motion:no-preference) { .question-paper:hover { transform: rotate(0) translateY(-3px); box-shadow: 5px 10px 0 rgb(0 0 0 / .15); } .reading-paper:hover,.experiment-paper:hover { transform: translateX(4px); } }
 @media (max-width:700px) {
  .research-art { padding: 16px; }
  .art-top { font-size: 12px; }
  .art-top > svg { width: 22px; height: 22px; }
  .art-papers { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8px; margin-top: 12px; }
  .question-paper,.reading-paper,.experiment-paper { display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 8px 4px; transform: none; box-shadow: none; }
  .question-paper > :not(.paper-mobile),.reading-paper > :global(svg),.experiment-paper > :global(svg),small,.art-caption { display: none; }
  .paper-mobile { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; }
  .reading-paper strong,.experiment-paper strong { font-size: 12px; }
  .reading-paper > span,.experiment-paper > span { flex: initial; }
 }
 @media (prefers-reduced-motion:reduce) { .art-layer { animation: none; transition: none; } }
</style>
