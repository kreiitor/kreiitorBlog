   <text class="art-detail" x="344" y="282" font-family="sans-serif" font-size="9" letter-spacing=".5" fill="var(--color-ink-muted)">HYPOTHESIS</text>
  </g></g>
  <!-- 主纸张：进行中的工作 -->
