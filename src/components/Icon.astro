---
interface Props { name: 'arrow' | 'external' | 'back' | 'search' | 'menu' | 'close' | 'book' | 'layers' | 'branch' | 'up' | 'chevron'; size?: number; }
const { name, size = 20 } = Astro.props;
const paths = {
 arrow: 'M4 12h16m-6-6 6 6-6 6', external: 'M7 17 17 7M7 7h10v10', back: 'M20 12H4m6-6-6 6 6 6',
 search: 'm16 16 5 5', menu: 'M4 7h16M4 12h16M4 17h16', close: 'm6 6 12 12M6 18 18 6',
 book: 'M12 5v15M12 5C9 3 5 3 3 4v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-2-1-6-1-9 1Z',
 layers: 'm12 3 9 5-9 5-9-5 9-5ZM3 12l9 5 9-5M3 16l9 5 9-5',
 branch: 'M6 7v10M6 12h6a6 6 0 0 0 6-6', up: 'M12 20V4m-6 6 6-6 6 6', chevron: 'm6 9 6 6 6-6'
};
---
<svg class="icon" aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d={paths[name]}/>{name === 'search' && <circle cx="10.5" cy="10.5" r="6.5"/>}{name === 'branch' && <><circle cx="6" cy="4" r="3"/><circle cx="6" cy="20" r="3"/><circle cx="18" cy="3" r="2"/></>}</svg>
<style>.icon { display: inline-block; flex-shrink: 0; vertical-align: middle; }</style>
