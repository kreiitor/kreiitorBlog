---
const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
interface Props { title?: string; description?: string; compact?: boolean; }
const { title='寻找一条线索。', description='从标题、摘要与正文中，找到你想读的内容。' } = Astro.props;
---
<section class="search-panel">
 <p class="eyebrow">SEARCH THE JOURNAL</p><h1>{title}</h1><p class="search-description">{description}</p>
 <div data-search-root>
  <form class="search-form" data-search-form role="search">
   <label class="sr-only" for="journal-query">搜索关键词</label>
   <input id="journal-query" data-search-input type="search" name="q" placeholder="试试：线性模型、LLM、论文阅读…" class="zen-input" autocomplete="off"/>
   <button type="submit" class="zen-btn zen-btn-primary">搜索 ↗</button>
  </form>
  <div class="search-suggestions"><span>试着搜索</span>{['线性模型','LLM','论文阅读','Python'].map(query => <button type="button" data-query={query}>{query}</button>)}</div>
  <p data-search-status class="search-status" role="status" aria-live="polite">输入至少 2 个字符开始搜索。</p>
  <div data-search-results class="search-results"></div>
 </div>
</section>
<script is:inline define:vars={{ normalizedBaseUrl }}>
 const root = document.querySelector('[data-search-root]');
 if (root instanceof HTMLElement) {
  const form = root.querySelector('[data-search-form]');
  const input = root.querySelector('[data-search-input]');
  const status = root.querySelector('[data-search-status]');
  const results = root.querySelector('[data-search-results]');
  let enginePromise, timer, generation = 0;
  const setStatus = message => { if (status) status.textContent = message; };
  const escape = text => String(text).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;');
  async function runSearch(value) {
   const request = ++generation;
   const query = value.trim();
   const url = new URL(location.href); if (query) url.searchParams.set('q',query); else url.searchParams.delete('q'); history.replaceState(null,'',url);
   results.replaceChildren();
   if (query.length < 2) { setStatus('输入至少 2 个字符开始搜索。'); return; }
   setStatus(`正在寻找「${query}」…`);
   try {
    if (!enginePromise) enginePromise = import(`${normalizedBaseUrl}pagefind/pagefind.js`).then(async engine => { await engine.options({excerptLength:30,baseUrl:normalizedBaseUrl}); return engine; });
    const engine = await enginePromise;
    const response = await engine.search(query);
    const items = response?.results ?? [];
    const data = await Promise.all(items.slice(0,30).map(item => item.data()));
    if (request !== generation) return;
    setStatus(items.length ? `找到 ${items.length} 条结果${items.length > 30 ? '，展示前 30 条' : ''}。` : '没有找到匹配内容，试试换一个关键词。');
    const fragment = document.createDocumentFragment();
    for (const item of data) {
     const article = document.createElement('article'); article.className = 'search-result';
     const excerpt = escape(item.excerpt ?? '').replaceAll('&lt;mark&gt;','<mark>').replaceAll('&lt;/mark&gt;','</mark>');
     article.innerHTML = `<p class="eyebrow">${escape(item.meta?.type ?? '札记')}</p><h2><a href="${escape(item.url)}">${escape(item.meta?.title ?? item.url)} <span aria-hidden="true">↗</span></a></h2><p>${excerpt}</p>`;
     fragment.append(article);
    }
    results.replaceChildren(fragment);
   } catch {
    enginePromise = undefined;
    if (request === generation) setStatus('搜索暂时无法加载，请稍后重试；也可以从文章归档浏览。');
   }
  }
  if (input instanceof HTMLInputElement) {
   input.value = new URLSearchParams(location.search).get('q') ?? '';
   input.addEventListener('input',() => { clearTimeout(timer); ++generation; timer = setTimeout(() => runSearch(input.value),220); });
   form.addEventListener('submit',event => { event.preventDefault(); clearTimeout(timer); runSearch(input.value); });
   document.querySelectorAll('[data-query]').forEach(button => button.addEventListener('click',() => { clearTimeout(timer); input.value = button.dataset.query; input.focus(); runSearch(input.value); }));
   if (input.value.trim().length >= 2) runSearch(input.value);
  }
 }
</script>
<style is:global>
 .search-panel h1 { font-size: clamp(32px,4vw,46px); margin-top: 14px; }
 .search-description { margin-top: 16px; color: var(--color-ink-soft); font-size: 14px; }
 .search-form { display: flex; gap: 10px; margin-top: 35px; } .search-form button { flex-shrink: 0; }
 .search-suggestions { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 18px; font-size: 10px; color: var(--color-ink-soft); }
 .search-suggestions button { border: 1px solid var(--color-line); border-radius: 4px; padding: 3px 9px; }
 .search-suggestions button:hover { background: var(--color-accent-soft); }
 .search-status { border-top: 1px solid var(--color-line); margin-top: 30px; padding-top: 22px; font-size: 12px; color: var(--color-ink-soft); }
 .search-result { padding: 25px 0; border-bottom: 1px solid var(--color-line); }
 .search-result h2 { margin-top: 9px; font-size: 20px; } .search-result h2 span { font-family: var(--font-sans); font-size: 14px; color: var(--color-accent); }
 .search-result > p:last-child { color: var(--color-ink-soft); font-size: 12px; line-height: 2; margin-top: 13px; }
 .search-result mark { color: var(--color-accent-strong); background: var(--color-accent-soft); border-radius: 2px; padding-inline: 2px; }
 @media (max-width: 600px) { .search-form button { padding-inline: 14px; } .search-form input { font-size: 12px; } }
</style>
