---
const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;

interface Props {
	title?: string;
	description?: string;
	compact?: boolean;
}

const {
	title = '站内搜索',
	description = '基于 Pagefind 的静态搜索，兼容 GitHub Pages，无需额外后端服务。',
	compact = false,
} = Astro.props;
---

<section class="zen-card-flat p-5 sm:p-6">
	<div class="space-y-3">
		<p class="zen-kicker">Search</p>
		<h2 class:list={['font-display font-semibold text-[color:var(--color-ink)]', compact ? 'text-xl' : 'text-2xl']}>
			{title}
		</h2>
		<p class="max-w-2xl text-sm leading-7 text-[color:var(--color-ink-soft)]">{description}</p>
	</div>

	<div class="mt-6 space-y-4" data-search-root>
		<form class="flex gap-2.5" data-search-form>
			<input
				data-search-input
				type="search"
				name="q"
				placeholder="观自在..."
				class="zen-input flex-1"
			/>
			<button
				type="submit"
				class="zen-btn zen-btn-primary shrink-0"
			>
				搜索
			</button>
		</form>

		<div class="flex flex-wrap gap-2 text-xs text-[color:var(--color-ink-muted)]">
			<span class="rounded-full bg-[color:var(--color-paper)] px-2.5 py-1">标题 + 摘要 + 正文</span>
			<span class="rounded-full bg-[color:var(--color-paper)] px-2.5 py-1">构建时自动生成索引</span>
		</div>

		<p data-search-status class="text-sm leading-7 text-[color:var(--color-ink-muted)]">
			输入至少 2 个字符开始搜索。
		</p>
		<div data-search-results class="grid gap-4"></div>
	</div>
</section>

<script is:inline define:vars={{ normalizedBaseUrl }}>
	const root = document.querySelector('[data-search-root]');

	if (root instanceof HTMLElement) {
		const form = root.querySelector('[data-search-form]');
		const input = root.querySelector('[data-search-input]');
		const status = root.querySelector('[data-search-status]');
		const results = root.querySelector('[data-search-results]');
		const searchParams = new URLSearchParams(window.location.search);
		const initialQuery = searchParams.get('q')?.trim() ?? '';
		let pagefind;
		let timer;

		const setStatus = (message) => {
			if (status instanceof HTMLElement) {
				status.textContent = message;
			}
		};

		const updateUrl = (value) => {
			const nextUrl = new URL(window.location.href);
			if (value) {
				nextUrl.searchParams.set('q', value);
			} else {
				nextUrl.searchParams.delete('q');
			}
			window.history.replaceState({}, '', nextUrl);
		};

		const escapeHtml = (value) =>
			value
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;')
				.replaceAll("'", '&#39;');

		const renderResults = async (items) => {
			if (!(results instanceof HTMLElement)) return;
			results.innerHTML = '';

			if (!items.length) {
				results.innerHTML =
					'<div class="zen-card-flat border-dashed p-5 text-sm text-[color:var(--color-ink-muted)]">没有找到匹配内容，试试换一个关键词。</div>';
				return;
			}

			for (const item of items) {
				const data = await item.data();
				const type = escapeHtml(data.meta?.type ?? '内容');
				const title = escapeHtml(data.meta?.title ?? data.url);
				const excerpt = data.excerpt ?? '';
				const article = document.createElement('article');
				article.className = 'zen-card-flat p-4 transition hover:shadow-[var(--shadow-soft)]';
				article.innerHTML = `
					<p class="zen-kicker">${type}</p>
					<h3 class="mt-2 font-display text-base font-semibold text-[color:var(--color-ink)]">
						<a href="${data.url}" class="hover:text-[color:var(--color-accent-strong)]">${title}</a>
					</h3>
					<p class="mt-2 text-sm leading-7 text-[color:var(--color-ink-soft)]">${excerpt}</p>
				`;
				results.append(article);
			}
		};

		const loadPagefind = async () => {
			if (pagefind) return pagefind;

			try {
				const pagefindUrl = `${normalizedBaseUrl}pagefind/pagefind.js`;
				pagefind = await import(pagefindUrl);
				await pagefind.options({ excerptLength: 20 });
				return pagefind;
			} catch (error) {
				setStatus('搜索资源加载失败，请刷新页面重试。');
				return null;
			}
		};

		const runSearch = async (value) => {
			const query = value.trim();
			updateUrl(query);

			if (query.length < 2) {
				setStatus('输入至少 2 个字符开始搜索。');
				if (results instanceof HTMLElement) {
					results.innerHTML = '';
				}
				return;
			}

			const engine = await loadPagefind();
			if (!engine) return;

			setStatus(`正在搜索 "${query}"...`);
			const response = await engine.search(query);
			const items = response?.results ?? [];
			setStatus(`找到 ${items.length} 条结果。`);
			await renderResults(items);
		};

		if (input instanceof HTMLInputElement) {
			input.value = initialQuery;

			input.addEventListener('input', () => {
				window.clearTimeout(timer);
				timer = window.setTimeout(() => {
					void runSearch(input.value);
				}, 180);
			});
		}

		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			if (input instanceof HTMLInputElement) {
				void runSearch(input.value);
			}
		});

		if (initialQuery.length >= 2 && input instanceof HTMLInputElement) {
			void runSearch(input.value);
		}
	}
</script>
