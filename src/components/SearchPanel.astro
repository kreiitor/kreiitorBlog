---
interface Props { title?: string; description?: string; modal?: boolean; }
const { title='寻找一条线索。', description='从标题、摘要与正文中，找到你想读的内容。', modal=false } = Astro.props;
const queryId = modal ? 'quick-query' : 'journal-query';
const resultId = modal ? 'quick-results' : 'search-results';
---
<section class="search-panel">
 <p class="eyebrow">寻找线索</p>{modal ? <h2 id="quick-search-title">{title}</h2> : <h1>{title}</h1>}<p class="search-description">{description}</p>
 <div data-search-root data-search-modal={modal ? 'true' : undefined}>
  <form class="search-form" data-search-form role="search"><label class="sr-only" for={queryId}>搜索关键词</label><input id={queryId} data-search-input type="search" name="q" placeholder="线性模型、LLM、论文阅读…" class="zen-input" autocomplete="off" aria-controls={resultId}/><button type="submit" class="zen-btn zen-btn-primary">搜索 →</button></form>
  <div class="search-suggestions"><span>试着搜索</span>{['线性模型','LLM','论文阅读','Python'].map(query => <button type="button" data-query={query}>{query}</button>)}</div>
  <p data-search-status class="search-status" role="status" aria-live="polite">输入至少 2 个字符开始搜索。</p>
  <button type="button" data-search-retry class="text-link" hidden>重试搜索 →</button>
  <div data-search-results class="search-results" id={resultId}></div>
  <button type="button" data-search-more class="zen-btn zen-btn-secondary more-results" hidden>查看更多结果 ↓</button>
 </div>
</section>
<script>
 import { rankSearchEntries, titleMatchScore } from '../utils/search.mjs';
 interface Entry { slug:string; title:string; description:string; type:string; url:string; }
 const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
 let enginePromise:Promise<any> | undefined, catalogPromise:Promise<Entry[]> | undefined;
 document.querySelectorAll<HTMLElement>('[data-search-root]').forEach(root => {
 const modal = root.dataset.searchModal === 'true';
 const input = root?.querySelector<HTMLInputElement>('[data-search-input]');
 const form = root?.querySelector<HTMLFormElement>('[data-search-form]');
 const status = root?.querySelector<HTMLElement>('[data-search-status]');
 const results = root?.querySelector<HTMLElement>('[data-search-results]');
 const more = root?.querySelector<HTMLButtonElement>('[data-search-more]');
 const retry = root.querySelector<HTMLButtonElement>('[data-search-retry]');
 let generation = 0, timer:ReturnType<typeof setTimeout>, query = '', limit = 12, cursor = 0;
 let hits:any[] = [], entries = new Map<string,Entry>(), catalog = new Map<string,Entry>();
 let loadingMore = false;
 const setStatus = (message:string) => { if (status) status.textContent = message; };
 function highlight(element:HTMLElement, text:string, term:string) {
  const start = text.toLocaleLowerCase().indexOf(term.toLocaleLowerCase());
  if (start < 0) { element.textContent = text; return; }
  element.append(document.createTextNode(text.slice(0,start)));
  const mark = document.createElement('mark'); mark.textContent = text.slice(start,start+term.length); element.append(mark,document.createTextNode(text.slice(start+term.length)));
 }
 function renderResults() {
  if (!results || !more) return;
  const ranked = rankSearchEntries(Array.from(entries.values()),query) as Entry[];
  const fragment = document.createDocumentFragment();
  for (const item of ranked.slice(0,limit)) {
   const article = document.createElement('article'); article.className = 'search-result';
   const type = document.createElement('p'); type.className = 'eyebrow'; type.textContent = item.type;
   const heading = document.createElement('h2'); const link = document.createElement('a'); link.href = item.url; highlight(link,item.title,query); heading.append(link);
   const summary = document.createElement('p'); summary.textContent = item.description;
   article.append(type,heading,summary); fragment.append(article);
  }
  results.replaceChildren(fragment);
  results.removeAttribute('aria-busy');
  more.hidden = ranked.length <= limit && cursor >= hits.length;
  more.disabled = false;
  setStatus(ranked.length ? `已找到 ${ranked.length} 条结果${cursor < hits.length ? '，可继续查看更多' : ''} · 显示 ${Math.min(limit,ranked.length)} 条。` : '没有找到匹配内容，试试换一个关键词。');
 }
 async function collect(request:number) {
  while (entries.size < limit && cursor < hits.length) {
   const chunk = hits.slice(cursor,cursor+12);
   const data = await Promise.all(chunk.map(hit => hit.data()));
   if (request !== generation) return;
   cursor += chunk.length;
   for (const item of data) {
    const slug = item.meta?.slug;
    const known = catalog.get(slug);
    if (!known || entries.has(slug)) continue;
    entries.set(slug,{ ...known, url:item.url || known.url });
   }
  }
 }
 async function runSearch(value:string) {
  const request = ++generation;
  query = value.trim(); limit = 12; cursor = 0; hits = []; entries = new Map();
  try { sessionStorage.setItem('garden-search-query', query); } catch {}
  if (!modal) { const url = new URL(location.href); if (query) url.searchParams.set('q',query); else url.searchParams.delete('q'); url.searchParams.delete('focus'); history.replaceState(null,'',url); }
  if (retry) retry.hidden = true;
  if (query.length < 2) { results?.replaceChildren();results?.removeAttribute('aria-busy'); if (more) more.hidden = true; setStatus('输入至少 2 个字符开始搜索。'); return; }
  setStatus(`正在寻找「${query}」…`); results?.replaceChildren();results?.setAttribute('aria-busy','true');if (more) more.hidden = true;
  try {
   catalogPromise ??= fetch(`${base}search-catalog.json`).then(response => { if (!response.ok) throw new Error('Catalog unavailable'); return response.json(); });
   enginePromise ??= import(/* @vite-ignore */ `${base}pagefind/pagefind.js`).then(async engine => { await engine.options({ excerptLength:40, baseUrl:base }); return engine; });
   const [engine, data] = await Promise.all([enginePromise,catalogPromise]);
   const response = await engine.search(query);
   if (request !== generation) return;
   catalog = new Map(data.map((entry:Entry) => [entry.slug,entry]));
   entries = new Map(data.filter((entry:Entry) => titleMatchScore(entry.title,query) > 0).map((entry:Entry) => [entry.slug,entry]));
   hits = response?.results ?? [];
   await collect(request);
   if (request === generation) renderResults();
  } catch {
   if (request !== generation) return;
   enginePromise = undefined; catalogPromise = undefined;
   if (retry) retry.hidden = false;
   results?.removeAttribute('aria-busy');
   setStatus('搜索暂时无法加载，请稍后重试；也可以从文章归档浏览。');
  }
 }
 if (input && form) {
  const params = new URLSearchParams(location.search);
  let saved = ''; try { saved = sessionStorage.getItem('garden-search-query') ?? ''; } catch {}
  input.value = params.get('q') ?? saved;
  if (!modal && (params.has('focus') || window.innerWidth > 700)) input.focus();
  if (params.has('focus')) { const url = new URL(location.href); url.searchParams.delete('focus'); history.replaceState(null,'',url); }
  input.addEventListener('input',() => { clearTimeout(timer); ++generation; timer = setTimeout(() => runSearch(input.value),220); });
  form.addEventListener('submit',event => { event.preventDefault(); clearTimeout(timer); runSearch(input.value); });
  root?.querySelectorAll<HTMLButtonElement>('[data-query]').forEach(button => button.addEventListener('click',() => { clearTimeout(timer); input.value = button.dataset.query ?? ''; input.focus(); runSearch(input.value); }));
  root?.addEventListener('keydown',event => {
   if (event.key === 'Escape' && !modal) { event.preventDefault(); clearTimeout(timer); input.value = ''; runSearch(''); input.focus(); }
   if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
    const links = Array.from(results?.querySelectorAll<HTMLAnchorElement>('h2 a') ?? []);
    if (!links.length) return;
    event.preventDefault(); const index = links.indexOf(document.activeElement as HTMLAnchorElement);
    const target = event.key === 'ArrowDown' ? (index + 1) % links.length : (index < 0 ? links.length - 1 : (index - 1 + links.length) % links.length);
    links[target].focus();
   }
  });
  more?.addEventListener('click',async () => { if (loadingMore) return; loadingMore = true; const request = generation; limit += 12; more.disabled = true; try { await collect(request); if (request === generation) renderResults(); } catch { if (request === generation) setStatus('更多结果暂时无法加载，请重试。'); } finally { loadingMore = false; more.disabled = false; } });
  retry?.addEventListener('click', () => runSearch(input.value));
  root.addEventListener('search:open', () => { input.focus(); input.select(); if (input.value.trim().length >= 2) runSearch(input.value); });
  if (!modal && input.value.trim().length >= 2) runSearch(input.value);
 }
 });
</script>
<style is:global>
 .search-panel h1 { font-size: clamp(32px,4vw,46px); margin-top: 14px; }
 .search-panel h2#quick-search-title { font-size: 29px; margin-top: 10px; }
 .search-description { margin-top: 16px; color: var(--color-ink-soft); font-size: 15px; }
 .search-form { display: flex; gap: 10px; margin-top: 30px; } .search-form button { flex-shrink: 0; }
 .search-form input { font-size: 16px; }
 .search-suggestions { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 16px; font-size: 12px; color: var(--color-ink-soft); }
 .search-suggestions button { min-height: 36px; border: 1px solid var(--color-line); border-radius: 4px; padding: 5px 10px; }
 .search-suggestions button:hover { background: var(--color-accent-soft); }
 .search-status { border-top: 1px solid var(--color-line); margin-top: 28px; padding-top: 20px; font-size: 13px; color: var(--color-ink-soft); }
 .search-result { padding: 24px 0; border-bottom: 1px solid var(--color-line); }
 .search-result h2 { margin-top: 8px; font-size: 21px; line-height: 1.8; }
 .search-result > p:last-child { color: var(--color-ink-soft); font-size: 14px; line-height: 1.9; margin-top: 10px; }
 .search-result mark { color: var(--color-accent-strong); background: var(--color-accent-soft); border-radius: 2px; padding-inline: 2px; }
 .more-results { margin-top: 28px; }
 @media (max-width: 600px) { .search-form button { padding-inline: 14px; } .search-result h2 { font-size: 20px; } }
</style>
