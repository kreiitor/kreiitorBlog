---
import { siteConfig } from '../data/site';
import { withBase } from '../utils/url';
---

<footer class="mt-24 border-t border-[color:var(--color-line)]">
	<div class="page-shell py-16">
		<div class="grid gap-12 md:grid-cols-[1fr_auto]">
			<!-- Brand -->
			<div class="max-w-md space-y-4">
				<p class="font-display text-lg font-semibold text-[color:var(--color-ink)]">{siteConfig.title}</p>
				<p class="text-sm leading-7 text-[color:var(--color-ink-soft)]">
					{siteConfig.description}
				</p>
			</div>

			<!-- Links -->
			<div class="flex flex-col items-start gap-6 text-sm md:items-end">
				<div class="flex flex-wrap gap-4">
					<a href={withBase('/archive/')} class="text-[color:var(--color-ink-soft)] transition hover:text-[color:var(--color-ink)]">归档</a>
					<a href={withBase('/search/')} class="text-[color:var(--color-ink-soft)] transition hover:text-[color:var(--color-ink)]">搜索</a>
					<a href={withBase('/rss.xml')} class="text-[color:var(--color-ink-soft)] transition hover:text-[color:var(--color-ink)]">RSS</a>
				</div>
				<div class="flex flex-wrap gap-4">
					{siteConfig.socialLinks.map((link) => (
						<a href={link.href} target="_blank" rel="noreferrer" class="text-[color:var(--color-ink-soft)] transition hover:text-[color:var(--color-accent-strong)]">
							{link.label}
						</a>
					))}
				</div>
				<p class="text-xs text-[color:var(--color-ink-muted)]">
					&copy; {new Date().getFullYear()} {siteConfig.author}
				</p>
			</div>
		</div>
	</div>
</footer>
