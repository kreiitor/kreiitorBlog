---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
import { siteConfig } from '../data/site';
import { withBase } from '../utils/url';
type FooterLink = { label: string; href: string; external?: boolean };
const groups: { title: string; links: FooterLink[] }[] = [
 { title: '内容', links: [{ label: '札记', href: withBase('/blog/') }, { label: '长卷', href: withBase('/notes/') }, { label: '闲笔', href: withBase('/jottings/') }, { label: '研究项目', href: withBase('/projects/') }, { label: '时间归档', href: withBase('/archive/') }, { label: '话题索引', href: withBase('/tags/') }] },
 { title: '联系', links: [...siteConfig.socialLinks.map(link => ({ ...link, external: true })), { label: 'RSS 订阅', href: withBase('/rss.xml'), external: true }] },
 { title: '站点', links: [{ label: '关于我', href: withBase('/about/') }, { label: '站内搜索', href: withBase('/search/') }] },
];
const built = new Date().toISOString().slice(0, 10);
---
<footer class:list={['site-footer','wash', { 'site-footer-compact': compact }]}>
 <div class="page-shell">
  <div class="footer-panel">
   <div class="footer-brand">
    <p class="footer-name">{siteConfig.author}<span class="footer-dot" aria-hidden="true"></span></p>
    <p class="footer-motto">{siteConfig.tagline}。</p>
    <p class="footer-note">关于 AI、软件工程与学习的长期记录。</p>
   </div>
   <nav class="footer-links" aria-label="页脚导航">
    {groups.map((group, index) => <div>
     <p class="footer-label"><span>{String(index + 1).padStart(2, '0')}</span>{group.title}</p>
     <ul>{group.links.map(link => <li><a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>{link.label}{link.external && <span aria-hidden="true"> ↗</span>}</a></li>)}</ul>
    </div>)}
   </nav>
  </div>
  <div class="footer-bottom">
   <p>© {new Date().getFullYear()} {siteConfig.author} · {siteConfig.location} · 更新于 <time datetime={built}>{built}</time></p>
   <a href="#top" class="text-link">回到顶部 ↑</a>
  </div>
 </div>
</footer>
<style>
 .site-footer { margin-top: 120px; padding: 48px 0 24px; }
 :global(.home-page) + .site-footer,:global(main:has(.home-page)) + .site-footer { margin-top: 72px; }
 .footer-panel { position: relative; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.6fr); gap: 40px 64px; padding: 36px 0 28px; border-top: 1px solid var(--color-line-strong); }
 .footer-name { display: inline-flex; align-items: baseline; gap: 4px; color: var(--color-ink); font-family: var(--font-display); font-size: 24px; font-weight: 600; line-height: 1.2; }
 .footer-dot { width: 6px; height: 6px; border-radius: 1px; background: var(--color-accent); }
 .footer-motto { margin-top: 10px; color: var(--color-ink-soft); font-size: 14px; }
 .footer-note { margin-top: 6px; color: var(--color-ink-muted); font-size: 13px; }
 .footer-links { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
 .footer-label { display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px; color: var(--color-ink-muted); font-size: 12.5px; }
 .footer-label span { color: var(--color-ink-muted); font-family: var(--font-mono); font-size: 11.5px; }
 .footer-links ul { margin: 0; padding: 0; list-style: none; }
 .footer-links a { position: relative; display: inline-flex; align-items: center; min-height: 36px; color: var(--color-ink-soft); font-size: 14px; transition: color var(--dur-base) var(--ease-smooth); }
 .footer-links a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 8px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform var(--dur-slow) var(--ease-out-expo); }
 .footer-links a:is(:hover,:focus-visible) { color: var(--color-accent-strong); }
 .footer-links a:is(:hover,:focus-visible)::after { transform: none; }
 .footer-bottom { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px 16px; padding-top: 6px; border-top: 1px solid var(--color-line); color: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12px; }
 .footer-bottom .text-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-ink-soft); font-family: var(--font-sans); font-weight: 500; }
 .footer-bottom .text-link:hover { color: var(--color-ink); }
 .site-footer-compact { margin-top: 80px; }
 .site-footer-compact .footer-panel { padding-block: 28px 22px; }
 @media (max-width: 900px) { .footer-panel { grid-template-columns: minmax(0,1fr); } }
 @media (max-width: 600px) {
  .site-footer { margin-top: 80px; }
  .footer-panel,.site-footer-compact .footer-panel { padding-block: 26px 22px; }
  .footer-links { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }
  .footer-links a { font-size: 13.5px; }
 }
</style>
