---
import type { PostEntry } from '../utils/content';
import { getReadingTime } from '../utils/content';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';
import TagLink from './TagLink.astro';

interface Props {
	post: PostEntry;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article class:list={['zen-card group flex h-full flex-col overflow-hidden', featured && 'md:col-span-2 xl:col-span-1']}>
	{post.data.cover && (
		<a href={withBase(`/blog/${post.id}/`)} class="block overflow-hidden">
			<img
				src={withBase(post.data.cover)}
				alt={post.data.title}
				class="h-36 w-full object-cover transition duration-500 group-hover:scale-[1.02]"
				loading="lazy"
			/>
		</a>
	)}
	<div class="flex h-full flex-col gap-4 p-5 sm:p-6">
		<!-- Meta -->
		<div class="flex items-center gap-2.5 text-xs text-[color:var(--color-ink-muted)]">
			<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
			<span class="h-0.5 w-0.5 rounded-full bg-[color:var(--color-ink-muted)]"></span>
			<span>{getReadingTime(post)} min</span>
		</div>

		<!-- Title -->
		<h3 class="font-display text-lg font-semibold leading-snug text-[color:var(--color-ink)]">
			<a href={withBase(`/blog/${post.id}/`)} class="transition group-hover:text-[color:var(--color-accent-strong)]">
				{post.data.title}
			</a>
		</h3>

		<!-- Description -->
		<p class="text-sm leading-7 text-[color:var(--color-ink-soft)] zen-truncate">{post.data.description}</p>

		<!-- Footer -->
		<div class="mt-auto flex items-center justify-between gap-3 pt-2">
			<div class="flex flex-wrap gap-1.5">
				{post.data.tags.slice(0, 3).map((tag) => (
					<TagLink tag={tag} />
				))}
			</div>
		</div>
	</div>
</article>
