---
import type { PostEntry } from '../utils/content';
import { getReadingTime, getPostCover } from '../utils/content';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';
import TagLink from './TagLink.astro';
import Icon from './Icon.astro';
interface Props { post: PostEntry; featured?: boolean; featuredLabel?: string; }
const { post, featured = false, featuredLabel = '精选札记' } = Astro.props;
const href = withBase(`/blog/${post.id}/`);
const cover = getPostCover(post);
---
<article class:list={['zen-card','post-card',{'post-featured':featured}]} data-post-tags={JSON.stringify(post.data.tags)}>
 <a href={href} class="card-cover" tabindex="-1" aria-hidden="true"><img src={withBase(cover)} alt="" loading="lazy" width="800" height="420"/></a>
 <div class="card-content">
  {featured && <p class="featured-label">{featuredLabel}</p>}
  <div class="card-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span aria-hidden="true">·</span><span>{getReadingTime(post)} 分钟阅读</span></div>
  <h3><a href={href}>{post.data.title}</a></h3>
  <p class="card-description zen-truncate">{post.data.description}</p>
  <div class="card-bottom"><div class="flex flex-wrap gap-1.5">{post.data.tags.slice(0,2).map(tag => <TagLink tag={tag}/>)}</div><a href={href} class="card-arrow" tabindex="-1" aria-hidden="true"><Icon name="arrow"/></a></div>
 </div>
</article>
<style>
 .post-featured { border: 0; border-radius: 0; background: transparent; box-shadow: none; }
 .post-featured .card-content { padding: 24px 0 0; }
 .featured-label { align-self: start; color: var(--color-counterpoint-ink); font-size: var(--text-caption); font-weight: 400; font-style: italic; }
 .post-featured .card-meta { order: 1; }
 .post-featured .card-bottom { order: 2; }
 .post-featured h3 { color: var(--color-ink); }
 .post-featured .card-cover { order: -1; aspect-ratio: 2 / 1; border: 1px solid var(--color-blossom-line); border-radius: 16px; }
 .post-featured .card-cover img { object-fit: cover; }
 @media (hover: hover) { .post-featured:hover { translate: none; box-shadow: none; border-color: transparent; } }
 @media (max-width: 700px) {
  .post-featured .card-content { order: -2; gap: 10px; padding: 0 0 20px; }
 }
</style>
