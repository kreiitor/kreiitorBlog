---
import type { PostEntry } from '../utils/content';
import { getReadingTime } from '../utils/content';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';
import TagLink from './TagLink.astro';
import Icon from './Icon.astro';
interface Props { post: PostEntry; featured?: boolean; featuredLabel?: string; }
const { post, featured = false, featuredLabel = '精选札记' } = Astro.props;
const href = withBase(`/blog/${post.id}/`);
---
<article class:list={['zen-card','post-card',{'post-featured':featured}]} data-post-tags={JSON.stringify(post.data.tags)}>
 <div class="card-content">
  {featured && <p class="featured-label">{featuredLabel}</p>}
  <div class="card-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span aria-hidden="true">·</span><span>{getReadingTime(post)} 分钟阅读</span></div>
  <h3><a href={href}>{post.data.title}</a></h3>
  <p class="card-description zen-truncate">{post.data.description}</p>
  <div class="card-bottom"><div class="flex flex-wrap gap-1.5">{post.data.tags.slice(0,2).map(tag => <TagLink tag={tag}/>)}</div><a href={href} class="card-arrow" tabindex="-1" aria-hidden="true"><Icon name="arrow"/></a></div>
 </div>
</article>
<style>
 .featured-label { align-self: start; color: var(--color-sage); font-size: 12.5px; font-weight: 600; letter-spacing: .06em; }
 .post-featured .card-meta { order: 1; }
 .post-featured .card-bottom { order: 2; }
</style>
