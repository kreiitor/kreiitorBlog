---
// 首屏四周的折纸山水。整幅画按 1440×900 的设计画布构图，以 xMidYMax slice 铺满首屏：中间留给文字，窄屏只露出中下部。
// 静止的部分（四层山、雾、海面）画在一张底图上，只栅格化一次。会动的部分（日、云、线描鹤、浪、船、竹、梅）
// 各自是一个裁到自身包围盒的小图层，由合成器平移、旋转，不会让底图逐帧重绘。
// 包围盒用画布坐标写成 --x/--y/--w/--h，样式里按与 slice 相同的比例 --u 换算成像素。
type P = [number, number];
type Box = { x: number; y: number; w: number; h: number };
const BASE = 900;
const f = (n: number) => Math.round(n * 10) / 10;
const pt = ([x, y]: P) => `${f(x)} ${f(y)}`;
const poly = (...ps: P[]) => `M${ps.map(pt).join('L')}Z`;
const rad = (deg: number) => deg * Math.PI / 180;
const boxVars = ({ x, y, w, h }: Box) => `--x:${f(x)};--y:${f(y)};--w:${f(w)};--h:${f(h)}`;
const viewBox = ({ x, y, w, h }: Box) => `${f(x)} ${f(y)} ${f(w)} ${f(h)}`;

// 山脊：关键点之间插两个带抖动的细节点，再用 Catmull-Rom 样条连成曲线。远山抖得多、显得嶙峋，近山抖得少、显得圆缓。
// 抖动用固定种子，每次构建结果一致。每座主峰向右下折出背光面：上沿就是山脊曲线，下沿是一道微弯的折痕。
function seeded(seed: number) {
 let s = seed;
 return () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;
}
function ridge(keys: P[], { rough, seed }: { rough: number; seed: number }) {
 const rand = seeded(seed);
 const pts: P[] = [], keyAt: number[] = [];
 keys.forEach((key, i) => {
  keyAt.push(pts.length);
  pts.push(key);
  const next = keys[i + 1];
  if (!next) return;
  for (const t of [.34, .68]) pts.push([key[0] + (next[0] - key[0]) * t + (rand() - .5) * 14, key[1] + (next[1] - key[1]) * t + (rand() - .5) * rough]);
 });
 const seg = (i: number) => {
  const p0 = pts[i - 1] ?? pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] ?? p2;
  return `C${pt([p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6])} ${pt([p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6])} ${pt(p2)}`;
 };
 const span = (from: number, to: number) => Array.from({ length: to - from }, (_, k) => seg(from + k)).join('');
 const top = `M${pt(pts[0])}${span(0, pts.length - 1)}`;
 const shade: string[] = [], crease: string[] = [];
 keys.forEach(([x, y], k) => {
  const prev = keys[k - 1], next = keys[k + 1];
  if (!prev || !next || y >= prev[1] || y >= next[1]) return;
  const foot: P = [x + (next[0] - x) * .22, BASE];
  const bend: P = [x + (foot[0] - x) * .5 + 10, y + (BASE - y) * .5];
  shade.push(`M${pt([x, y])}${span(keyAt[k], keyAt[k + 1])}L${pt([next[0], BASE])}L${pt(foot)}Q${pt(bend)} ${pt([x, y])}Z`);
  crease.push(`M${pt([x, y])}Q${pt(bend)} ${pt(foot)}`);
 });
 return { fill: `${top}L1460 ${BASE}L-20 ${BASE}Z`, top, shade: shade.join(''), crease: crease.join('') };
}
// 中间 470–970 的峰都压在 y≥736 以下，保证不碰到文字；最远一层只在两侧露出山头。
const distant = ridge([[-20, 662], [110, 590], [230, 640], [300, 626], [420, 700], [700, 772], [1000, 724], [1120, 652], [1240, 586], [1360, 632], [1460, 602]], { rough: 12, seed: 7 });
const far = ridge([[-20, 760], [90, 646], [200, 704], [330, 606], [452, 708], [560, 748], [680, 736], [780, 754], [880, 742], [990, 712], [1100, 618], [1210, 682], [1320, 596], [1460, 700]], { rough: 22, seed: 11 });
const mid = ridge([[-20, 806], [120, 716], [262, 784], [400, 702], [540, 800], [660, 772], [760, 808], [900, 776], [1020, 806], [1150, 720], [1280, 782], [1380, 728], [1460, 792]], { rough: 14, seed: 23 });
const near = ridge([[-20, 852], [160, 796], [330, 848], [520, 812], [700, 858], [880, 816], [1060, 860], [1240, 802], [1460, 852]], { rough: 6, seed: 41 });

// 日轮：圆面分八片折面，隔一片压暗；外面一圈圈细环向外变淡，奇偶环分两层反向慢转。
const sun = { x: 250, y: 236, r: 60 };
const sunBox: Box = { x: 30, y: 16, w: 440, h: 440 };
const onSun = (deg: number): P => [sun.x + sun.r * Math.cos(rad(deg)), sun.y + sun.r * Math.sin(rad(deg))];
const sunShade = Array.from({ length: 4 }, (_, k) => poly([sun.x, sun.y], onSun(k * 90 - 45), onSun(k * 90))).join('');
const sunRays = Array.from({ length: 8 }, (_, k) => `M${pt([sun.x, sun.y])}L${pt(onSun(k * 45 - 45))}`).join('');
const rings = [82, 100, 122, 148, 178, 212].map((r, i) => ({ r, i }));

// 竹：三竿，竿上有节；叶子沿主脉分成受光与背光两半，主脉单独描一道线。
const bambooBox: Box = { x: -20, y: 240, w: 320, h: 660 };
const stalks: { from: P; to: P; w: number }[] = [
 { from: [92, 900], to: [128, 300], w: 8 },
 { from: [168, 900], to: [190, 410], w: 6 },
 { from: [36, 900], to: [26, 460], w: 5 },
];
const nodes = stalks.flatMap(({ from, to, w }) => {
 const marks: string[] = [];
 for (let t = .12; t < .98; t += .11) {
  const x = from[0] + (to[0] - from[0]) * t, y = from[1] + (to[1] - from[1]) * t;
  marks.push(`M${f(x - w * .9)} ${f(y)}h${f(w * 1.8)}`);
 }
 return marks;
}).join('');
const leaf = ([x, y, deg, len, w]: number[]) => {
 const dx = Math.cos(rad(deg)), dy = Math.sin(rad(deg));
 const tip: P = [x + dx * len, y + dy * len], m: P = [x + dx * len * .36, y + dy * len * .36];
 return { lit: poly([x, y], [m[0] - dy * w, m[1] + dx * w], tip), shade: poly([x, y], tip, [m[0] + dy * w, m[1] - dx * w]), rib: `M${pt([x, y])}L${pt(tip)}` };
};
const leaves = [
 [127, 316, -62, 70, 7], [127, 316, -18, 96, 9], [123, 380, 16, 104, 10], [123, 380, -150, 64, 7], [119, 444, 38, 92, 9], [115, 508, 58, 84, 8], [115, 508, -130, 60, 6],
 [189, 430, -40, 84, 8], [189, 430, 4, 98, 9], [186, 494, 30, 90, 9], [183, 558, 52, 78, 8],
 [26, 480, -120, 72, 7], [26, 480, -80, 60, 6], [28, 540, -150, 66, 7],
].map(leaf);

// 梅：主枝从右上角斜伸进来，越往梢越细；花是五瓣折纸梅，花心一圈线描花蕊。
const plumBox: Box = { x: 1030, y: 40, w: 440, h: 330 };
const branches = [
 { d: 'M1470 70C1400 96 1352 132 1300 150S1196 196 1150 224 1080 270 1040 304', w: 7 },
 { d: 'M1300 150C1310 196 1286 248 1250 280S1228 330 1236 352', w: 4.6 },
 { d: 'M1196 190C1180 160 1168 140 1150 118', w: 3.6 },
 { d: 'M1380 116C1400 96 1420 70 1440 60', w: 3 },
 { d: 'M1110 250C1118 226 1130 214 1126 196', w: 2.6 },
];
const blossoms = [
 { x: 1062, y: 298, s: 1, hue: 'plum', r: 8 }, { x: 1122, y: 252, s: 1.25, hue: 'peach', r: -12 },
 { x: 1150, y: 112, s: 1.05, hue: 'plum', r: 20 }, { x: 1238, y: 346, s: 1.15, hue: 'plum', r: -4 },
 { x: 1264, y: 268, s: .85, hue: 'gold', r: 30 }, { x: 1318, y: 146, s: 1.3, hue: 'peach', r: 6 },
 { x: 1396, y: 106, s: .9, hue: 'plum', r: -18 }, { x: 1196, y: 196, s: .8, hue: 'plum', r: 14 },
 { x: 1440, y: 58, s: 1.1, hue: 'peach', r: 0 },
];
const buds: P[] = [[1090, 284], [1178, 150], [1288, 300], [1356, 128], [1214, 210], [1128, 196]];

// 祥云：卷云头加一道拖尾，只用线条和一层很淡的底色。云的局部坐标覆盖 (-24,-54)–(108,28)。
// 三朵都放在页头下沿以下，往复时也碰不到梅枝和文字。
const cloudPath = 'M0 0c-18 0-26-20-12-30 4-16 26-20 34-6 8-14 32-10 34 8 16-2 24 18 10 28Z';
const cloudCurl = 'M10-12a9 9 0 1 1 14 6M40-8a7 7 0 1 1 10 6M-6-4c-10 0-14 10-6 16h60c20 0 34 6 50 2';
const clouds = [{ x: 360, y: 120, s: 1, dur: 44 }, { x: 960, y: 150, s: .78, dur: 52 }, { x: 70, y: 420, s: .62, dur: 38 }]
 .map(c => ({ ...c, box: { x: c.x - 24 * c.s, y: c.y - 54 * c.s, w: 132 * c.s, h: 82 * c.s } }));

// 青海波：五排鳞片，奇数排错开半个，横移一个周期（48）正好无缝；图层两侧各多铺一片。
const waveBox: Box = { x: -72, y: 840, w: 1608, h: 60 };
const waveRows = Array.from({ length: 5 }, (_, row) => ({ y: 864 + row * 9, xs: Array.from({ length: 33 }, (_, i) => -48 + i * 48 + (row % 2 ? 24 : 0)) }));

// 船：图层原点在船底中线，航行时整层横移；底下的 svg 再单独摇晃。
const boats = [
 { name: 'a', s: 1, y: 858, dur: 80, delay: -22, rest: 980 },
 { name: 'b', s: .7, y: 846, dur: 110, delay: -70, rest: 380 },
].map(b => ({ ...b, box: { x: -26 * b.s, y: b.y - 34 * b.s, w: 52 * b.s, h: 46 * b.s } }));

// 线描纸鹤：用站标的折面，只描边不填色。放在文字栏两侧，远离统计条和社交图标。
const craneOutline = 'M19 40 32 32 45 40 32 51ZM20.5 39 32 33 15 5ZM17 39.5 29 49 8 20ZM47 39.5 35 49 59 22ZM32 33 43.5 39 49 5Z';
const lineCranes = [{ x: 400, y: 560, s: .62, d: 0 }, { x: 1010, y: 600, s: .48, d: -3 }, { x: 1300, y: 470, s: .56, d: -1.5 }]
 .map(c => ({ ...c, box: { x: c.x, y: c.y, w: 64 * c.s, h: 56 * c.s } }));

// 落英与星点：位置、大小、速度各不相同，负延迟让它们首帧就散落在半空。
const petals = [
 { x: 6, size: 9, dur: 17, delay: -3, drift: 60, hue: 'plum' }, { x: 13, size: 7, dur: 21, delay: -11, drift: 90, hue: 'peach' },
 { x: 21, size: 10, dur: 19, delay: -7, drift: 40, hue: 'plum' }, { x: 79, size: 8, dur: 18, delay: -5, drift: -70, hue: 'peach' },
 { x: 86, size: 11, dur: 23, delay: -14, drift: -40, hue: 'plum' }, { x: 93, size: 7, dur: 16, delay: -9, drift: -90, hue: 'gold' },
 { x: 72, size: 6, dur: 25, delay: -18, drift: -30, hue: 'peach' }, { x: 30, size: 6, dur: 24, delay: -20, drift: 50, hue: 'gold' },
];
const stars = [
 { x: 9, y: 12, s: 3, d: -1 }, { x: 18, y: 30, s: 2, d: -3 }, { x: 27, y: 9, s: 2.5, d: -2 }, { x: 66, y: 14, s: 2, d: -4 },
 { x: 74, y: 6, s: 3, d: -1.5 }, { x: 91, y: 22, s: 2.5, d: -2.5 }, { x: 83, y: 36, s: 2, d: -3.5 }, { x: 4, y: 44, s: 2, d: -.5 },
];
---
<div class="scenery">
 <!-- 日轮：两层反向慢转的同心细环 + 八片折面；暗色下变成月亮。整组一起缓慢浮沉。 -->
 <div class="layer sun" style={boxVars(sunBox)}>
  {[0, 1].map(odd => <svg class={`rings rings-${odd ? 'b' : 'a'}`} viewBox={viewBox(sunBox)}>{rings.filter(({ i }) => i % 2 === odd).map(({ r, i }) => <circle cx={sun.x} cy={sun.y} r={r} style={`--i:${i}`}/>)}</svg>)}
  <svg class="sun-disc" viewBox={viewBox(sunBox)}>
   <circle class="sun-face" cx={sun.x} cy={sun.y} r={sun.r}/><path class="sun-shade" d={sunShade}/><path class="sun-fold" d={sunRays}/><circle class="sun-edge" cx={sun.x} cy={sun.y} r={sun.r}/>
  </svg>
 </div>

 <!-- 祥云与线描纸鹤：各自一个小图层，在山的后面缓慢往复。 -->
 {clouds.map(c => <svg class="layer cloud" style={`${boxVars(c.box)};--dur:${c.dur}s`} viewBox="-24 -54 132 82"><path class="cloud-fill" d={cloudPath}/><path class="cloud-line" d={cloudPath}/><path class="cloud-line" d={cloudCurl}/></svg>)}
 {lineCranes.map(c => <svg class="layer line-crane" style={`${boxVars(c.box)};--d:${c.d}s`} viewBox="0 0 64 56"><path d={craneOutline}/></svg>)}

 <!-- 底图：远山、远山、中山、近山（受光面 + 背光面实色与排线 + 折痕 + 山脊线），层间夹雾，最下是海面。 -->
 <svg class="scene-base" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice">
  <defs>
   <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(38)"><path class="hatch-line" d="M0 0v7"/></pattern>
   <pattern id="hatch-wide" width="11" height="11" patternUnits="userSpaceOnUse" patternTransform="rotate(-24)"><path class="hatch-line" d="M0 0v11"/></pattern>
   <linearGradient id="mist" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="mist-stop" stop-opacity="0"/><stop offset=".55" class="mist-stop" stop-opacity=".75"/><stop offset="1" class="mist-stop" stop-opacity="0"/></linearGradient>
   <symbol id="blossom" viewBox="-16 -16 32 32" overflow="visible">
    {[0, 72, 144, 216, 288].map(r => <g transform={`rotate(${r})`}><path class="pt-lit" d="M0 0-5.8-8.4 0-14.8Z"/><path class="pt-shade" d="M0 0 0-14.8 5.8-8.4Z"/></g>)}
    {[36, 108, 180, 252, 324].map(r => <g transform={`rotate(${r})`}><path class="stamen" d="M0-2.6V-7.8"/><circle class="anther" cy="-8.6" r="1.1"/></g>)}
    <circle class="heart" r="2.3"/>
   </symbol>
   <symbol id="scale" viewBox="-24 -24 48 24" overflow="visible">
    <path class="scale-fill" d="M-24 0A24 24 0 0 1 24 0Z"/>
    <path class="scale-line" d="M-24 0A24 24 0 0 1 24 0M-17 0A17 17 0 0 1 17 0M-10 0A10 10 0 0 1 10 0M-3.5 0A3.5 3.5 0 0 1 3.5 0"/>
   </symbol>
   <symbol id="boat" viewBox="-26 -34 52 46" overflow="visible">
    <path class="boat-hull" d="M-24 0H24L16 10H-16Z"/><path class="boat-fold" d="M0 0H24L16 10H0Z"/>
    <path class="boat-mast" d="M1 0V-32"/><path class="boat-sail" d="M3-30V-3L20-4Z"/><path class="boat-jib" d="M-1-26V-4L-15-5Z"/>
   </symbol>
  </defs>
  <g class="hills">
   <path class="hill distant" d={distant.fill}/><path class="hill-ridge distant" d={distant.top}/>
   <path class="hill far" d={far.fill}/><path class="hill-shade far" d={far.shade}/><path class="hill-hatch" d={far.shade}/>
   <path class="hill-crease" d={far.crease}/><path class="hill-ridge" d={far.top}/>
   <rect class="mist" x="0" y="690" width="1440" height="90" fill="url(#mist)"/>
   <path class="hill mid" d={mid.fill}/><path class="hill-shade mid" d={mid.shade}/><path class="hill-hatch wide" d={mid.shade}/>
   <path class="hill-crease" d={mid.crease}/><path class="hill-ridge" d={mid.top}/>
   <rect class="mist" x="0" y="760" width="1440" height="80" fill="url(#mist)"/>
   <path class="hill near" d={near.fill}/><path class="hill-shade near" d={near.shade}/><path class="hill-hatch" d={near.shade}/>
   <path class="hill-crease" d={near.crease}/><path class="hill-ridge" d={near.top}/>
  </g>
  <rect class="sea-ground" x="0" y="852" width="1440" height="60"/>
 </svg>

 <!-- 青海波：五排鳞纹，整层缓慢横移。船：外层航行，内层摇晃。 -->
 <svg class="layer waves" style={boxVars(waveBox)} viewBox={viewBox(waveBox)}>{waveRows.map(row => row.xs.map(x => <use href="#scale" x={x - 24} y={row.y - 24} width="48" height="24"/>))}</svg>
 {boats.map(b => <div class={`layer boat boat-${b.name}`} style={`${boxVars(b.box)};--sail:${b.dur}s;--sail-delay:${b.delay}s;--rest:${b.rest}`}><svg viewBox="-26 -34 52 46"><use href="#boat" x="-26" y="-34" width="52" height="46"/></svg></div>)}

 <!-- 竹与梅：各自整丛摇曳；梅花在梅枝图层内轻轻开合。 -->
 <svg class="layer bamboo" style={boxVars(bambooBox)} viewBox={viewBox(bambooBox)}>
  {stalks.map(s => <path class="stalk" d={`M${pt(s.from)}L${pt(s.to)}`} style={`--w:${s.w}`}/>)}
  <path class="stalk-node" d={nodes}/>
  {leaves.map(l => <><path class="leaf-lit" d={l.lit}/><path class="leaf-shade" d={l.shade}/><path class="leaf-rib" d={l.rib}/></>)}
 </svg>
 <!-- 梅花不单独开合，随整枝摇曳即可，图层内部没有逐帧重绘。 -->
 <svg class="layer plum-tree" style={boxVars(plumBox)} viewBox={viewBox(plumBox)}>
  {branches.map(b => <path class="bough" d={b.d} style={`--w:${b.w}`}/>)}
  {buds.map(([x, y]) => <circle class="bud" cx={x} cy={y} r="4.2"/>)}
  {blossoms.map(b => <g class={`blossom ${b.hue}`} transform={`translate(${b.x} ${b.y}) rotate(${b.r}) scale(${b.s})`}><use href="#blossom" x="-16" y="-16" width="32" height="32"/></g>)}
 </svg>

 <div class="petals">{petals.map(p => <span class={`petal ${p.hue}`} style={`--x:${p.x}%;--s:${p.size}px;--dur:${p.dur}s;--delay:${p.delay}s;--drift:${p.drift}px`}></span>)}</div>
 <div class="stars">{stars.map(s => <span class="star" style={`--x:${s.x}%;--y:${s.y}%;--s:${s.s}px;--d:${s.d}s`}></span>)}</div>
</div>
<style>
 /* 色板：宣纸淡彩——梅红、杏、藤黄、石青、松绿、黛蓝，压低饱和度。线条统一用 --scene-line，
    比填色深一档，图案靠线条出层次，不靠亮度。 */
 .scenery {
  --scene-plum: #d39aa0; --scene-peach: #e2b597; --scene-gold: #d8bd7c; --scene-azure: #a9bccb;
  --scene-pine: #a3bfa9; --scene-teal: #9cbcbc; --scene-ink: #7d8aa0; --scene-sun: #ebc29f;
  --scene-bough: #8c7867; --scene-line: #6d7c92; --scene-paper: var(--color-paper);
  --scene-alpha: .62; --line-alpha: .5; --scene-ring-alpha: .55;
  position: absolute; inset: 0; overflow: hidden; pointer-events: none; container-type: size;
 }
 :global(:root[data-theme="dark"]) .scenery {
  --scene-plum: #9f6f76; --scene-peach: #a7836c; --scene-gold: #a08a5c; --scene-azure: #4d6074;
  --scene-pine: #4d6658; --scene-teal: #456466; --scene-ink: #3c4759; --scene-sun: #d8cfb9;
  --scene-bough: #7a6a5c; --scene-line: #8c9ab0; --scene-alpha: .62; --line-alpha: .38; --scene-ring-alpha: .42;
 }
 @media (prefers-color-scheme: dark) {
  :global(:root:not([data-theme])) .scenery {
   --scene-plum: #9f6f76; --scene-peach: #a7836c; --scene-gold: #a08a5c; --scene-azure: #4d6074;
   --scene-pine: #4d6658; --scene-teal: #456466; --scene-ink: #3c4759; --scene-sun: #d8cfb9;
   --scene-bough: #7a6a5c; --scene-line: #8c9ab0; --scene-alpha: .62; --line-alpha: .38; --scene-ring-alpha: .42;
  }
 }
 /* --u：一个画布单位对应的像素，和底图 slice 的缩放一致；画布水平居中、底边对齐。 */
 .scenery > * { --u: max(100cqw / 1440, 100cqh / 900); }
 .scene-base { position: absolute; inset: 0; width: 100%; height: 100%; }
 .layer { position: absolute; left: calc(50% + (var(--x) - 720) * var(--u)); top: calc(100% - (900 - var(--y)) * var(--u)); width: calc(var(--w) * var(--u)); height: calc(var(--h) * var(--u)); overflow: visible; }
