---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagSummaries } from '../../utils/content';
import { withBase } from '../../utils/url';
const tags = getTagSummaries(await getCollection('posts'),await getCollection('projects'));
---
<BaseLayout title="话题索引" description="沿着研究、数学与工程实践的话题，找到下一篇值得读的札记。">
 <div data-pagefind-ignore>
  <section class="page-shell page-intro"><p class="eyebrow">TOPICS / FOLLOW YOUR CURIOSITY</p><h1>循着好奇心，继续读。</h1><p>从一个熟悉的话题出发，也许会遇见另一个值得追问的问题。</p></section>
  <section class="page-shell topics-grid" aria-label="全部话题">{tags.map(tag => <a class="topic-entry" href={withBase(`/tags/${encodeURIComponent(tag.tag)}/`)}><h2>{tag.tag}</h2><p>{tag.postCount} 篇札记{tag.projectCount > 0 && ` · ${tag.projectCount} 个项目`}</p><span aria-hidden="true">↗</span></a>)}</section>
 </div>
</BaseLayout>
<style>
 .topics-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,240px),1fr)); gap: 18px; margin-top: 36px; }
 .topic-entry { position: relative; min-width: 0; border: 1px solid var(--color-line); border-radius: 8px; padding: 24px; background: var(--color-surface); transition: background-color .2s,border-color .2s; }
 .topic-entry:hover { background: var(--color-accent-soft); border-color: var(--color-line-strong); }
 .topic-entry h2 { padding-right: 24px; font-size: 22px; }
 .topic-entry p { font-size: 12px; color: var(--color-ink-soft); margin-top: 12px; }
 .topic-entry > span { position: absolute; right: 24px; top: 24px; color: var(--color-accent); }
</style>
