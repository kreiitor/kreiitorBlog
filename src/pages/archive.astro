---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArchiveGroups } from '../utils/content';
import { formatYearMonth } from '../utils/date';
import { withBase } from '../utils/url';

const posts = await getCollection('posts');
const groups = getArchiveGroups(posts);
---

<BaseLayout title="归档" description="按年份归档浏览全部博客文章。">
	<div data-pagefind-ignore>
		<section class="page-shell pt-16 sm:pt-20" data-zen-reveal>
			<div class="max-w-2xl space-y-4">
				<p class="zen-kicker">Archive</p>
				<h1 class="font-display text-3xl font-semibold text-[color:var(--color-ink)] sm:text-4xl">归档</h1>
				<p class="text-[0.9375rem] leading-7 text-[color:var(--color-ink-soft)]">
					按时间线浏览全部文章。
				</p>
			</div>
		</section>

		<section class="page-shell mt-12 space-y-10">
			{groups.map((group) => (
				<div data-zen-reveal>
					<h2 class="font-display text-2xl font-semibold text-[color:var(--color-ink)]">{group.year}</h2>
					<div class="mt-6 space-y-3">
						{group.items.map((post) => (
							<a href={withBase(`/blog/${post.id}/`)} class="group block rounded-xl border border-[color:var(--color-line)] bg-[color:var(--color-surface)] p-4 transition hover:border-[color:var(--color-line-strong)] hover:shadow-[var(--shadow-whisper)]">
								<p class="text-xs text-[color:var(--color-ink-muted)]">{formatYearMonth(post.data.pubDate)}</p>
								<p class="mt-1.5 text-sm font-medium text-[color:var(--color-ink)] transition group-hover:text-[color:var(--color-accent-strong)]">
									{post.data.title}
								</p>
							</a>
						))}
					</div>
				</div>
			))}
		</section>
	</div>
</BaseLayout>
