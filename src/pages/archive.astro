---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArchiveGroups } from '../utils/content';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';
const groups=getArchiveGroups(await getCollection('posts'));
---
<BaseLayout title="时间归档" description="沿着时间线浏览所有研究札记和学习记录。">
 <div data-pagefind-ignore><section class="page-shell page-intro"><p class="eyebrow">THE ARCHIVE / A TRAIL OF THOUGHTS</p><h1>时间，留下了这些。</h1><p>思考不是突然发生的。沿着时间线，看看那些逐渐积累的痕迹。</p></section><section class="page-shell archive-list">{groups.map(group => <div class="archive-year"><div><h2>{group.year}</h2><p>{group.items.length} 篇札记</p></div><div>{group.items.map(post => <a href={withBase(`/blog/${post.id}/`)} class="archive-row"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><h3>{post.data.title}</h3><span aria-hidden="true">↗</span></a>)}</div></div>)}</section></div>
</BaseLayout>
<style>
 .archive-list { margin-top: 35px; } .archive-year { display: grid; grid-template-columns: 170px minmax(0,1fr); gap: 35px; margin-bottom: 50px; }
 .archive-year h2 { font-family: var(--font-editorial); font-size: 48px; font-weight: 400; color: var(--color-accent-strong); } .archive-year > div > p { font-size: var(--text-caption); color: var(--color-ink-muted); }
 .archive-row { display: grid; grid-template-columns: 110px minmax(0,1fr) 15px; gap: 20px; align-items: center; padding: 20px 12px; margin-inline: -12px; border-bottom: 1px solid var(--color-line); border-radius: 8px; transition: background-color .2s var(--ease-smooth); }
 .archive-row:hover { background: var(--color-surface-hover); }
 .archive-row time { font-size: var(--text-caption); color: var(--color-ink-muted); } .archive-row h3 { font-family: var(--font-sans); font-size: 13px; font-weight: 500; line-height: 1.9; transition: color .2s var(--ease-smooth); }
 .archive-row span { color: var(--color-accent); transition: transform .25s var(--ease-out-expo); }
 .archive-row:hover h3 { color: var(--color-accent); }
 .archive-row:hover span { transform: translate(3px,-3px); }
 @media (max-width: 700px) { .archive-year { grid-template-columns: 1fr; gap: 12px; } .archive-row { grid-template-columns: 85px minmax(0,1fr) 12px; gap: 10px; padding: 16px 8px; margin-inline: -8px; } }
</style>
