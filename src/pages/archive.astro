---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArchiveGroups } from '../utils/content';
import { withBase } from '../utils/url';
const groups = getArchiveGroups(await getCollection('posts')).map(group => ({
 ...group,
 months: [...new Set(group.items.map(post => post.data.pubDate.getUTCMonth()))].map(month => ({
  month: month + 1, items: group.items.filter(post => post.data.pubDate.getUTCMonth() === month),
 })),
}));
---
<BaseLayout title="时间归档" description="沿着时间线浏览所有研究札记和学习记录。">
 <section class="page-shell archive-layout" data-pagefind-ignore>
  <header class="archive-intro"><p class="eyebrow">写作归档</p><h1>时间，<br/>留下了这些。</h1><p>思考不是突然发生的。<br/>这里留着逐渐积累的痕迹。</p><a class="text-link" href={withBase('/blog/')}>按栏目浏览 →</a></header>
  <div class="archive-list">{groups.map(group => <section class="archive-year" aria-label={`${group.year} 年札记`}>
   <div class="archive-year-heading"><h2>{group.year}</h2><span>{group.items.length} 篇札记</span></div>
   {group.months.map(month => <section class="archive-month"><h3>{month.month} 月 <span>{month.items.length} 篇</span></h3><div>{month.items.map(post => <a href={withBase(`/blog/${post.id}/`)} class="archive-row"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.getUTCDate()} 日</time><h4>{post.data.title}</h4><span aria-hidden="true">→</span></a>)}</div></section>)}
  </section>)}</div>
 </section>
</BaseLayout>
<style>
 .archive-layout { display: grid; grid-template-columns: minmax(200px, .7fr) minmax(0,2fr); gap: 80px; padding-top: 56px; }
 .archive-intro { align-self: start; position: sticky; top: 120px; }
 .archive-intro h1 { font-size: clamp(32px,3.5vw,44px); margin-block: 16px 24px; }
 .archive-intro > p:not(.eyebrow) { color: var(--color-ink-soft); font-size: 14px; line-height: 2; }
 .archive-intro > a { margin-top: 16px; }
 .archive-year + .archive-year { margin-top: 48px; }
 .archive-year-heading { display: flex; align-items: baseline; gap: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--color-line-strong); }
 .archive-year-heading h2 { font-family: var(--font-editorial); font-size: clamp(48px,6vw,76px); line-height: 1.1; font-weight: 400; color: var(--color-accent-strong); font-variant-numeric: tabular-nums; }
 .archive-year-heading > span,.archive-month h3 span { font-family: var(--font-sans); font-size: 13px; font-weight: 400; color: var(--color-ink-soft); }
 .archive-month h3 { position: sticky; top: 89px; z-index: 1; display: flex; gap: 16px; align-items: baseline; padding-block: 18px; font-size: 20px; background: var(--color-paper); border-bottom: 1px solid var(--color-line); }
 .archive-row { display: grid; grid-template-columns: 45px minmax(0,1fr) 18px; gap: 16px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--color-line); }
 .archive-row time { color: var(--color-ink-soft); font-size: 13px; font-variant-numeric: tabular-nums; }
 .archive-row h4 { font-family: var(--font-sans); font-size: 15px; line-height: 1.9; font-weight: 400; }
 .archive-row:hover h4 { color: var(--color-accent); }
 .archive-row > span { color: var(--color-accent); opacity: 0; transition: opacity var(--dur-base); }
 .archive-row:is(:hover,:focus-visible) > span { opacity: 1; }
 @media (max-width: 900px) { .archive-layout { gap: 36px; grid-template-columns: 180px minmax(0,1fr); } .archive-month h3 { top: 75px; } }
 @media (max-width: 640px) { .archive-layout { grid-template-columns: 1fr; padding-top: 36px; gap: 32px; } .archive-intro { position: static; } .archive-intro h1 br { display: none; } .archive-intro h1 { margin-block: 12px 16px; } .archive-row { gap: 10px; } }
</style>
