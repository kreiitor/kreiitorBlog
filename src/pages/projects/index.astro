---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../utils/content';

const projects = getProjects(await getCollection('projects'));
---

<BaseLayout title="项目" description="展示论文、实验与工具型项目条目。">
	<div data-pagefind-ignore>
		<section class="page-shell pt-16 sm:pt-20" data-zen-reveal>
			<div class="max-w-2xl space-y-4">
				<p class="zen-kicker">Projects</p>
				<h1 class="font-display text-3xl font-semibold text-[color:var(--color-ink)] sm:text-4xl">项目</h1>
				<p class="text-[0.9375rem] leading-7 text-[color:var(--color-ink-soft)]">
					论文摘要、实验进展与工具型项目，独立承载于 projects 集合。
				</p>
			</div>
		</section>

		<section class="page-shell mt-12" data-zen-reveal>
			<div class="section-grid">
				{projects.map((project) => (
					<ProjectCard project={project} />
				))}
			</div>
		</section>
	</div>
</BaseLayout>
