---
import { getCollection,render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingTools from '../../components/ReadingTools.astro';
import TagLink from '../../components/TagLink.astro';
import { getProjects } from '../../utils/content';
import { formatDate } from '../../utils/date';
import { withBase } from '../../utils/url';
export async function getStaticPaths() { return getProjects(await getCollection('projects')).map(project=>({params:{slug:project.id},props:{project}})); }
const { project }=Astro.props;
const { Content }=await render(project);
---
<BaseLayout title={project.data.title} description={project.data.summary} image={project.data.cover ?? '/social-card.svg'}>
 <ReadingTools/>
 <section class="page-shell pt-10 sm:pt-14"><a href={withBase('/projects/')} class="text-link back-link">← 返回研究项目</a><div class="article-layout"><article data-pagefind-body data-reading-article><header class="article-header"><span data-pagefind-meta="type" class="hidden">研究项目</span><p class="eyebrow">RESEARCH & PRACTICE / {project.data.status}</p><h1 data-pagefind-meta="title">{project.data.title}</h1><p class="article-summary">{project.data.summary}</p><div class="card-meta"><span>kreiitor</span><span>·</span><time datetime={project.data.pubDate.toISOString()}>{formatDate(project.data.pubDate)}</time></div><div class="mt-5 flex flex-wrap gap-2">{project.data.tags.map(tag=><TagLink tag={tag}/>)}</div></header>{project.data.cover && <img src={withBase(project.data.cover)} alt="" class="article-cover mt-8" width="800" height="420"/>}<div class="rich-content article-body"><Content/></div></article><aside data-pagefind-ignore><div class="article-toc"><p class="eyebrow mb-4">PROJECT LINKS</p>{project.data.repoUrl && <a href={project.data.repoUrl} target="_blank" rel="noreferrer">GitHub 仓库 ↗</a>}{project.data.demoUrl && <a href={project.data.demoUrl} target="_blank" rel="noreferrer">在线演示 ↗</a>}<a href={withBase('/projects/')}>全部研究项目 ↗</a></div></aside></div></section>
</BaseLayout>
