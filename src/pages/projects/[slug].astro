---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingTools from '../../components/ReadingTools.astro';
import TagLink from '../../components/TagLink.astro';
import { getProjects } from '../../utils/content';
import { formatDate } from '../../utils/date';
import { withBase } from '../../utils/url';
import { resolveCover } from '../../utils/covers';
import { siteConfig } from '../../data/site';
import 'katex/dist/katex.min.css';
import '../../styles/code-fonts.css';
export async function getStaticPaths() { return getProjects(await getCollection('projects')).map(project => ({ params:{ slug:project.id }, props:{ project } })); }
const { project } = Astro.props;
const { Content } = await render(project);
const cover = project.data.cover ? resolveCover(project.data.cover) : undefined;
---
<BaseLayout title={project.data.title} description={project.data.summary} image={cover}>
 <section class="page-shell project-reading"><a href={withBase('/projects/')} class="text-link back-link">← 研究项目</a><div class="article-layout"><article data-pagefind-body data-reading-article data-article-slug={`project:${project.id}`} data-pagefind-meta="slug[data-article-slug]"><header class="article-header"><span data-pagefind-meta="type" class="sr-only">研究项目</span><p class="eyebrow">Research & practice / {project.data.status}</p><h1 data-pagefind-meta="title" data-pagefind-weight="8">{project.data.title}</h1><p class="article-summary" data-pagefind-meta="description">{project.data.summary}</p><div class="card-meta"><span>kreiitor</span><span aria-hidden="true">·</span><time datetime={project.data.pubDate.toISOString()}>{formatDate(project.data.pubDate)}</time></div><div class="project-tags">{project.data.tags.map(tag => <TagLink tag={tag}/>)}</div><div class="project-actions" data-pagefind-ignore>{project.data.repoUrl && <a href={project.data.repoUrl} class="zen-btn zen-btn-primary" target="_blank" rel="noreferrer">GitHub 仓库 ↗</a>}{project.data.demoUrl && <a href={project.data.demoUrl} class="zen-btn zen-btn-secondary" target="_blank" rel="noreferrer">在线演示 ↗</a>}<a href={`mailto:${siteConfig.email}?subject=${encodeURIComponent(project.data.title)}`} class="text-link">交流这个项目 ↗</a></div></header><ReadingTools/>{cover && <img src={withBase(cover)} alt="" class="article-cover project-cover" width="2048" height="1152" fetchpriority="high"/>}<div class="rich-content article-body"><Content/></div></article><aside data-pagefind-ignore><div class="article-toc"><p class="eyebrow">Keep exploring</p><a href={withBase('/projects/')}>全部研究项目 →</a><a href={withBase('/blog/')}>研究与思考 →</a></div></aside></div></section>
</BaseLayout>
<style>
 .project-reading { padding-top: 48px; }
 .project-tags,.project-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; align-items: center; }
 .project-actions { margin-top: 24px; }
 .project-cover { margin-top: 28px; }
 @media (max-width: 600px) { .project-reading { padding-top: 32px; } }
</style>
