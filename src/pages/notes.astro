---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SeriesCard from '../components/SeriesCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getLearningSeries } from '../utils/series';
import { formatDate } from '../utils/date';
import { sections } from '../data/sections';
const posts = await getCollection('posts');
const series = getLearningSeries(await getCollection('series'), posts);
// 最近有新章节的专题放在最前面做主卡，其余按配置顺序排成索引行。
const updatedAt = (group: typeof series[number]) => Math.max(...group.chapters.map(post => (post.data.updatedDate ?? post.data.pubDate).valueOf()));
const lead = [...series].sort((a, b) => updatedAt(b) - updatedAt(a))[0];
const rest = series.filter(group => group !== lead);
---
<BaseLayout title={sections.course.label} description="成体系的学习笔记：沿着章节从概念、推导读到工程实践。">
 <div data-pagefind-ignore>
  <PageIntro eyebrow="成体系的学习笔记" title={sections.course.label} mark="path"><p>从概念和推导到工程实践，沿着章节逐步深入。{series.length} 卷，每一卷都可以从第一篇慢慢读下去。</p></PageIntro>
  {lead && <section class="page-shell editorial-section notes-lead" aria-labelledby="lead-label">
   <p id="lead-label" class="eyebrow">最近更新 · {formatDate(new Date(updatedAt(lead)))}</p>
   <div class="notes-lead-card"><SeriesCard series={lead} headingLevel="h2"/></div>
  </section>}
  <section class="page-shell editorial-section notes-index">
   <SectionHeading kicker="目录" title="全部长卷" description="可以从第一篇开始，也可以按章节挑着读。"/>
   <div class="notes-rows">{rest.map(item => <SeriesCard series={item} presentation="index" headingLevel="h3"/>)}</div>
   {series.length === 0 && <p class="section-description">学习笔记正在整理中。</p>}
  </section>
 </div>
</BaseLayout>
<style>
 .notes-lead { margin-top: 48px; }
 .notes-lead .eyebrow { margin-bottom: 14px; }
 .notes-lead-card :global(.series-card) { padding-bottom: 26px; }
 .notes-lead-card :global(.series-heading :is(h2,h3)) { font-size: clamp(26px,1.2rem + 1vw,32px); }
 .notes-lead-card :global(.series-description) { max-width: 46em; font-size: 15.5px; }
 .notes-index :global(.section-heading) { border-bottom: 0; }
 .notes-rows { border-top: 1px solid var(--color-line); }
</style>
