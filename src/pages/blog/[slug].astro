---
import { getCollection, render } from 'astro:content';
import GiscusComments from '../../components/GiscusComments.astro';
import TagLink from '../../components/TagLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getReadingTime } from '../../utils/content';
import { formatDate } from '../../utils/date';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
	const posts = await getCollection('posts');

	return getPublishedPosts(posts).map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 2);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	image={post.data.cover ?? '/social-card.svg'}
	type="article"
	publishedTime={post.data.pubDate}
	updatedTime={post.data.updatedDate}
	tags={post.data.tags}
>
	<section class="page-shell pt-12 sm:pt-16">
		<!-- Back link -->
		<a href={withBase('/blog/')} class="zen-btn zen-btn-ghost text-xs mb-8 inline-flex">
			<svg aria-hidden="true" viewBox="0 0 20 20" class="h-3.5 w-3.5 fill-none stroke-current stroke-[1.8]">
				<path d="M13 4l-6 6 6 6" />
			</svg>
			返回博客
		</a>

		<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_220px]">
			<article data-pagefind-body class="space-y-8">
				<!-- Article Header -->
				<header class="space-y-5" data-zen-reveal>
					<span data-pagefind-meta="type" class="hidden">博客文章</span>
					<div class="flex items-center gap-2.5 text-xs text-[color:var(--color-ink-muted)]">
						<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
						<span class="h-0.5 w-0.5 rounded-full bg-[color:var(--color-ink-muted)]"></span>
						<span>{getReadingTime(post)} min read</span>
						{post.data.updatedDate && (
							<>
								<span class="h-0.5 w-0.5 rounded-full bg-[color:var(--color-ink-muted)]"></span>
								<span>更新于 {formatDate(post.data.updatedDate)}</span>
							</>
						)}
					</div>
					<h1 data-pagefind-meta="title" class="font-display text-3xl font-semibold leading-tight text-[color:var(--color-ink)] sm:text-4xl">
						{post.data.title}
					</h1>
					<p class="max-w-2xl text-base leading-8 text-[color:var(--color-ink-soft)]">{post.data.description}</p>
					<div class="flex flex-wrap gap-1.5">
						{post.data.tags.map((tag) => (
							<TagLink tag={tag} />
						))}
					</div>
				</header>

				<!-- Cover Image -->
				{post.data.cover && (
					<img
						src={withBase(post.data.cover)}
						alt={post.data.title}
						class="h-72 w-full rounded-2xl object-cover"
					/>
				)}

				<!-- Article Body -->
				<div class="zen-card p-6 sm:p-8" data-zen-reveal>
					<div class="rich-content">
						<Content />
					</div>
				</div>

				<GiscusComments />
			</article>

			<!-- Sidebar TOC -->
			<aside data-pagefind-ignore class="hidden lg:block" data-zen-reveal>
				<div class="sticky top-20 zen-card-flat p-5">
					<p class="zen-kicker">目录</p>
					{tocHeadings.length > 0 ? (
						<ul class="mt-4 space-y-2.5 text-sm leading-7 text-[color:var(--color-ink-soft)]">
							{tocHeadings.map((heading) => (
								<li>
									<a href={`#${heading.slug}`} class="transition hover:text-[color:var(--color-accent-strong)]">
										{heading.text}
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="mt-4 text-sm text-[color:var(--color-ink-muted)]">暂无目录</p>
					)}
				</div>
			</aside>
		</div>
	</section>
</BaseLayout>
