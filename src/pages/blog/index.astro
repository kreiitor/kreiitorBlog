---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/content';
import { getLearningSeries } from '../../utils/series';
import { withBase } from '../../utils/url';
const allPosts = await getCollection('posts');
const posts = getPublishedPosts(allPosts);
const series = getLearningSeries(await getCollection('series'), allPosts);
const categories = [{ key:'all', label:'全部札记' },{ key:'writing', label:'研究与思考' },{ key:'knowledge', label:'知识笔记' },{ key:'course', label:'系列学习' }];
---
<BaseLayout title="博客" description="研究与思考、实践知识与成体系的学习笔记。">
 <div data-pagefind-ignore>
  <section class="page-shell page-intro"><p class="eyebrow">THE JOURNAL / WRITING & LEARNING</p><h1>把思考，留在纸上。</h1><p>论文里的灵感，工具里的门道，数学里的直觉。<br/>从一篇札记开始，也可以沿着一条学习路径读下去。</p></section>
  <section class="page-shell blog-content">
   <div class="blog-toolbar"><div class="filter-tabs" role="group" aria-label="按栏目筛选">{categories.map(item => <button type="button" data-category-filter={item.key} aria-pressed={item.key === 'all'}>{item.label}<span>{item.key === 'all' ? posts.length : posts.filter(post => post.data.category === item.key).length}</span></button>)}</div><a href={withBase('/search/')} class="text-link">搜索内容 ↗</a></div>
   <details data-blog-series class="blog-series"><summary><span><span class="eyebrow">LEARNING PATHS</span><span class="series-summary-title">浏览 {series.length} 个学习专题</span></span><span class="series-disclosure" aria-hidden="true">＋</span></summary><div class="series-grid">{series.map(group => <SeriesCard series={group} compact/>)}</div></details>
   <p class="filter-status" data-filter-status aria-live="polite">{posts.filter(post => !post.data.series).length} 篇独立札记 · 系列章节可从上方专题阅读</p>
   <PostList posts={posts} interactive/>
   <nav class="list-pagination" data-list-pagination aria-label="文章列表翻页"><button type="button" class="zen-btn zen-btn-secondary" data-list-previous disabled>← 上一页</button><span data-list-page>1 / 2</span><button type="button" class="zen-btn zen-btn-secondary" data-list-next>下一页 →</button></nav>
   <noscript><style>[data-post-row][hidden] { display: grid !important; } [data-list-pagination],.filter-tabs { display: none; }</style><p class="filter-status">所有札记已展示；也可通过学习专题和时间归档浏览。</p></noscript>
  </section>
 </div>
</BaseLayout>
<script>
 const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'));
 const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-post-row]'));
 const status = document.querySelector('[data-filter-status]');
 const series = document.querySelector<HTMLDetailsElement>('[data-blog-series]');
 const wideLayout = matchMedia('(min-width: 701px)');
 if (series) series.open = wideLayout.matches;
 const previous = document.querySelector<HTMLButtonElement>('[data-list-previous]');
 const next = document.querySelector<HTMLButtonElement>('[data-list-next]');
 const pageLabel = document.querySelector('[data-list-page]');
 const pagination = document.querySelector<HTMLElement>('[data-list-pagination]');
 const pageSize = 12;
 let category = 'all', page = 1;
 function render(animate = false) {
  const selected = rows.filter(row => category === 'all' ? !row.dataset.series : row.dataset.category === category);
  const pages = Math.max(1,Math.ceil(selected.length / pageSize));
  page = Math.max(1,Math.min(page,pages));
  const visible = new Set(selected.slice((page - 1) * pageSize,page * pageSize));
  rows.forEach(row => { row.hidden = !visible.has(row); });
  if (animate && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelector('[data-post-list]')?.animate([{opacity:.5,transform:'translateY(4px)'},{opacity:1,transform:'translateY(0)'}],{duration:220,easing:'cubic-bezier(.2,.7,.2,1)'});
  buttons.forEach(button => button.setAttribute('aria-pressed',String(button.dataset.categoryFilter === category)));
  if (series) series.hidden = category !== 'all' && category !== 'course';
  if (status) status.textContent = category === 'all' ? `${selected.length} 篇独立札记 · 系列章节可从上方专题阅读` : `${selected.length} 篇札记 · 按时间排列`;
  if (previous) previous.disabled = page === 1;
  if (next) next.disabled = page === pages;
  if (pageLabel) pageLabel.textContent = `${page} / ${pages}`;
  if (pagination) pagination.hidden = pages <= 1;
  const url = new URL(location.href);
  if (category === 'all') url.searchParams.delete('category'); else url.searchParams.set('category',category);
  if (page === 1) url.searchParams.delete('page'); else url.searchParams.set('page',String(page));
  history.replaceState(null,'',url);
 }
 buttons.forEach(button => button.addEventListener('click',() => { category = button.dataset.categoryFilter ?? 'all'; page = 1; if (series) series.open = category === 'course' || wideLayout.matches; render(true); }));
 function changePage(delta: number) { page += delta; render(true); const list=document.querySelector<HTMLElement>('[data-post-list]');if(list){list.tabIndex=-1;list.focus({preventScroll:true});list.scrollIntoView({ block:'start', behavior:matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });} }
 previous?.addEventListener('click',() => changePage(-1));
 next?.addEventListener('click',() => changePage(1));
 const params = new URLSearchParams(location.search);
 if (buttons.some(button => button.dataset.categoryFilter === params.get('category'))) category = params.get('category')!;
 const requestedPage = Number(params.get('page'));
 if (Number.isInteger(requestedPage) && requestedPage > 0) page = requestedPage;
 if (series && category === 'course') series.open = true;
 render();
</script>
<style>
 .blog-content { padding-top: 28px; }
 .blog-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
 .filter-tabs { display: flex; flex-wrap: wrap; gap: 6px; }
 .filter-tabs button { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 8px 14px; border: 1px solid transparent; border-radius: 5px; font-size: 13px; color: var(--color-ink-soft); }
 .filter-tabs button[aria-pressed="true"] { color: var(--color-on-primary); background: var(--color-primary); }
 .filter-tabs button { transition: color 160ms, background-color 160ms, border-color 160ms; }
 .filter-tabs button:not([aria-pressed="true"]):hover { border-color: var(--color-line); background: var(--color-accent-soft); }
 .filter-tabs span { font-size: 12px; }
 .blog-series { margin-top: 24px; padding: 16px 0; border-block: 1px solid var(--color-line); }
 .blog-series summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; list-style: none; min-height: 44px; }
 .blog-series summary::-webkit-details-marker { display: none; }
 .blog-series summary > span:first-child { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
 .blog-series summary .eyebrow { font-size: 11px; }
 .series-summary-title { font-size: 14px; color: var(--color-ink); }
 .series-disclosure { color: var(--color-sage); font-size: 22px; transition: transform var(--dur-base) var(--ease-smooth); }
 .blog-series[open] .series-disclosure { transform: rotate(45deg); }
 .blog-series .series-grid { margin-top: 18px; }
 .filter-status { font-size: 12px; color: var(--color-ink-soft); margin: 24px 0 8px; }
 .list-pagination { display: flex; justify-content: center; align-items: center; gap: 24px; padding-top: 32px; font-size: 12px; }
 .list-pagination button:disabled { opacity: .5; cursor: default; }
 @media (max-width: 700px) {
  .blog-content { padding-top: 18px; }
  .blog-toolbar { display: block; }
  .blog-toolbar > a { display: none; }
  .filter-tabs { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 6px; }
  .filter-tabs button { justify-content: space-between; padding-inline: 12px; border-color: var(--color-line); }
  .blog-series { margin-top: 18px; padding-block: 8px; }
  .blog-series summary > span:first-child { gap: 4px 12px; }
  .blog-series summary .eyebrow { font-size: 10px; }
  .filter-status { margin-top: 18px; }
  .list-pagination { gap: 14px; }
 }
</style>
