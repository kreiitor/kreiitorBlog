---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getPublishedPosts } from '../../utils/content';
import { withBase } from '../../utils/url';
import { sections } from '../../data/sections';
const posts = getPublishedPosts(await getCollection('posts')).filter(post => post.data.category === 'knowledge');
// 札记之间不分子类，只靠共享标签串联；筛选只列篇数最多的几个标签。
const tagCounts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
const filters = [{ key: 'all', label: '全部', count: posts.length }, ...[...tagCounts].filter(([, count]) => count > 1).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh')).slice(0, 6).map(([tag, count]) => ({ key: tag, label: tag, count }))];
---
<BaseLayout title={sections.knowledge.label} description="零散的知识与教训：工具、算法、工程实践与踩过的坑。">
 <div data-pagefind-ignore>
  <PageIntro eyebrow="零散的知识与教训" title={sections.knowledge.label} mark="writing"><p>工具、算法、工程实践与踩过的坑，一篇讲清一件事。它们之间没有先后，靠标签彼此串联；成体系的学习笔记在<a class="text-link" href={withBase(sections.course.href)}>{sections.course.label}</a>里。</p></PageIntro>
  <section class="page-shell blog-content">
   <div class="blog-toolbar"><div class="filter-tabs" role="group" aria-label="按标签筛选">{filters.map(item => <button type="button" data-tag-filter={item.key} aria-pressed={item.key === 'all'}>{item.label}<span>{item.count}</span></button>)}</div><a href={withBase('/tags/')} class="text-link">全部标签 →</a></div>
   <p class="filter-status" data-filter-status aria-live="polite">{posts.length} 篇札记 · 按时间排列</p>
   <PostList posts={posts} interactive label="tag"/>
   <nav class="list-pagination" data-list-pagination aria-label="文章列表翻页"><button type="button" class="zen-btn zen-btn-secondary" data-list-previous disabled>← 上一页</button><span data-list-page>1 / 2</span><button type="button" class="zen-btn zen-btn-secondary" data-list-next>下一页 →</button></nav>
   <noscript><style>[data-post-row][hidden] { display: grid !important; } [data-list-pagination],.filter-tabs { display: none; }</style><p class="filter-status">所有札记已展示；也可以按标签或时间归档浏览。</p></noscript>
  </section>
 </div>
</BaseLayout>
<script>
 const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tag-filter]'));
 const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-post-row]'));
 const status = document.querySelector('[data-filter-status]');
 const previous = document.querySelector<HTMLButtonElement>('[data-list-previous]');
 const next = document.querySelector<HTMLButtonElement>('[data-list-next]');
 const pageLabel = document.querySelector('[data-list-page]');
 const pagination = document.querySelector<HTMLElement>('[data-list-pagination]');
 const pageSize = 12;
 let tag = 'all', page = 1;
 function apply() {
  const selected = rows.filter(row => tag === 'all' || (row.dataset.tags ?? '').split('|').includes(tag));
  const pages = Math.max(1,Math.ceil(selected.length / pageSize));
  page = Math.max(1,Math.min(page,pages));
  const visible = new Set(selected.slice((page - 1) * pageSize,page * pageSize));
  rows.forEach(row => { row.hidden = !visible.has(row); });
  buttons.forEach(button => button.setAttribute('aria-pressed',String(button.dataset.tagFilter === tag)));
  if (status) status.textContent = tag === 'all' ? `${selected.length} 篇札记 · 按时间排列` : `${selected.length} 篇带「${tag}」标签的札记`;
  if (previous) previous.disabled = page === 1;
  if (next) next.disabled = page === pages;
  if (pageLabel) pageLabel.textContent = `${page} / ${pages}`;
  if (pagination) pagination.hidden = pages <= 1;
  const url = new URL(location.href);
  url.searchParams.delete('category');
  if (tag === 'all') url.searchParams.delete('tag'); else url.searchParams.set('tag',tag);
  if (page === 1) url.searchParams.delete('page'); else url.searchParams.set('page',String(page));
  history.replaceState(null,'',url);
 }
 // 同文档视图过渡：留下来的行滑到新位置，离开的淡出，新进的淡入。
 // 每行在过渡期间临时拿一个名字；不支持的浏览器直接重排。
 const reduced = matchMedia('(prefers-reduced-motion: reduce)');
 function render(animate = false) {
  if (!animate || reduced.matches || !('startViewTransition' in document)) { apply(); return; }
  const named = rows.filter(row => !row.hidden);
  const name = (list: HTMLElement[]) => list.forEach(row => { row.style.viewTransitionName = `post-row-${rows.indexOf(row)}`; row.style.setProperty('view-transition-class','post-row'); });
  name(named);
  const transition = document.startViewTransition(() => { named.forEach(row => { row.style.viewTransitionName = ''; }); apply(); name(rows.filter(row => !row.hidden)); });
  transition.finished.finally(() => rows.forEach(row => { row.style.viewTransitionName = ''; row.style.removeProperty('view-transition-class'); }));
 }
 buttons.forEach(button => button.addEventListener('click',() => { tag = button.dataset.tagFilter ?? 'all'; page = 1; render(true); }));
 function changePage(delta: number) { page += delta; render(true); const list=document.querySelector<HTMLElement>('[data-post-list]');if(list){list.tabIndex=-1;list.focus({preventScroll:true});list.scrollIntoView({ block:'start', behavior:matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });} }
 previous?.addEventListener('click',() => changePage(-1));
 next?.addEventListener('click',() => changePage(1));
 const params = new URLSearchParams(location.search);
 if (buttons.some(button => button.dataset.tagFilter === params.get('tag'))) tag = params.get('tag')!;
 const requestedPage = Number(params.get('page'));
 if (Number.isInteger(requestedPage) && requestedPage > 0) page = requestedPage;
 render();
</script>
<style>
 .blog-content { padding-top: 28px; }
 :global(::view-transition-group(*.post-row)) { animation-duration: var(--dur-slow); animation-timing-function: var(--ease-out-expo); }
 :global(::view-transition-old(*.post-row)),:global(::view-transition-new(*.post-row)) { animation-duration: var(--dur-base); }
 .blog-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
 .filter-tabs { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px; border: 1px solid var(--color-line); border-radius: 999px; background: var(--color-surface); }
 .filter-tabs button { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 16px; border-radius: 999px; color: var(--color-ink-soft); font-size: 14px; font-weight: 500; transition: color var(--dur-base), background-color var(--dur-base); }
 .filter-tabs button:not([aria-pressed="true"]):hover { color: var(--color-ink); background: var(--color-surface-hover); }
 .filter-tabs button[aria-pressed="true"] { color: var(--color-on-primary); background: var(--color-primary); font-weight: 600; }
 .filter-tabs span { font-size: 12px; font-variant-numeric: tabular-nums; opacity: .75; }
 .filter-status { font-size: 13px; color: var(--color-ink-muted); margin: 28px 0 12px; }
 .list-pagination { display: flex; justify-content: center; align-items: center; gap: 24px; padding-top: 32px; font-size: 12px; }
 .list-pagination button:disabled { opacity: .5; cursor: default; }
 @media (max-width: 700px) {
  .blog-content { padding-top: 18px; }
  .blog-toolbar { display: block; }
  .blog-toolbar > a { display: none; }
  .filter-tabs { border-radius: 22px; }
  .filter-tabs button { justify-content: space-between; gap: 8px; padding-inline: 14px; }
  .filter-status { margin-top: 18px; }
  .list-pagination { gap: 14px; }
 }
</style>
