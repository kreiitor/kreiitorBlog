---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import SearchPanel from '../../components/SearchPanel.astro';
import TagLink from '../../components/TagLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagSummaries } from '../../utils/content';
import { withBase } from '../../utils/url';

const posts = await getCollection('posts');
const projects = await getCollection('projects');
const publishedPosts = getPublishedPosts(posts);
const tags = getTagSummaries(posts, projects);
---

<BaseLayout title="博客" description="按文章、标签、归档和静态搜索浏览博客内容。">
	<div data-pagefind-ignore>
		<!-- Header -->
		<section class="page-shell pt-16 sm:pt-20" data-zen-reveal>
			<div class="max-w-2xl space-y-4">
				<p class="zen-kicker">Blog</p>
				<h1 class="font-display text-3xl font-semibold text-[color:var(--color-ink)] sm:text-4xl">博客</h1>
				<p class="text-[0.9375rem] leading-7 text-[color:var(--color-ink-soft)]">
					全部文章、标签导航与站内搜索。
				</p>
				<div class="flex flex-wrap gap-2.5 pt-2">
					<a href={withBase('/archive/')} class="zen-btn zen-btn-secondary text-xs">归档</a>
					<a href={withBase('/search/')} class="zen-btn zen-btn-secondary text-xs">搜索页</a>
				</div>
			</div>
		</section>

		<!-- Search -->
		<section class="page-shell mt-12" data-zen-reveal>
			<SearchPanel compact={true} title="搜索文章" description="输入关键词搜索标题、摘要与正文。" />
		</section>

		<!-- Posts + Sidebar -->
		<section class="page-shell mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_240px]">
			<div class="grid gap-5 sm:grid-cols-2">
				{publishedPosts.map((post) => (
					<PostCard post={post} />
				))}
			</div>

			<aside class="space-y-6" data-zen-reveal>
				<div class="zen-card-flat p-5">
					<h2 class="font-display text-base font-semibold text-[color:var(--color-ink)]">标签</h2>
					<div class="mt-4 flex flex-wrap gap-1.5">
						{tags.map((item) => (
							<div class="flex items-center gap-1.5">
								<TagLink tag={item.tag} />
								<span class="text-[0.6875rem] text-[color:var(--color-ink-muted)]">{item.count}</span>
							</div>
						))}
					</div>
				</div>
			</aside>
		</section>
	</div>
</BaseLayout>
