---
import { getCollection } from 'astro:content';
import ArticlePage from '../../../components/ArticlePage.astro';
import { getPublishedPosts } from '../../../utils/content';
import { getReadingParts } from '../../../utils/reading.mjs';
export async function getStaticPaths() {
 const paths = [];
 for (const post of getPublishedPosts(await getCollection('posts'))) {
  const { parts } = await getReadingParts(post, import.meta.env.BASE_URL);
  for (const part of parts.slice(1)) paths.push({ params: { slug: post.id, part: String(part.number) }, props: { post, partNumber: part.number } });
 }
 return paths;
}
const { post, partNumber } = Astro.props;
---
<ArticlePage post={post} partNumber={partNumber}/>
