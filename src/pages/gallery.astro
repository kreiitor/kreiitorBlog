---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';

const photos = [
	{ file: '两只小猫.jpg', title: '两只小猫' },
	{ file: '第一顿饭.jpg', title: '第一顿饭' },
	{ file: '恩施屏山峡谷.jpg', title: '恩施屏山峡谷' },
	{ file: '抽象车流.jpg', title: '抽象车流' },
	{ file: '官宣图.jpg', title: '官宣图' },
];
---
<BaseLayout title="有意义的图" description="一些值得留下的瞬间。">
 <div data-pagefind-ignore>
  <section class="page-shell gallery-head">
   <p class="eyebrow">KEEPSAKES / 有意义的图</p>
   <h1>一些有意义的图。</h1>
   <p class="gallery-lede">有些瞬间无需展开成文，也值得好好收藏。</p>
  </section>
  <section class="page-shell gallery-grid">
   {photos.map((p, i) => (
    <figure class:list={['photo-card', { 'photo-wide': i === 2 }]}>
     <div class="photo-frame">
      <img src={withBase(`/gallery/${p.file}`)} alt={p.title} loading="lazy" decoding="async"/>
     </div>
     <figcaption><span class="photo-no">0{i + 1}</span>{p.title}</figcaption>
    </figure>
   ))}
  </section>
 </div>
</BaseLayout>
<style>
 .gallery-head { padding-bottom: 8px; }
 .gallery-head h1 { margin: 14px 0 10px; }
 .gallery-lede { color: var(--color-ink-soft); font-size: 14px; }
 .gallery-grid {
  margin-top: 40px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px;
 }
 .photo-wide { grid-column: 1 / -1; }
 .photo-card { margin: 0; }
 .photo-frame {
  border: 1px solid var(--color-line);
  border-radius: 12px;
  padding: 10px;
  background: var(--color-surface);
  box-shadow: 0 2px 10px #35382f0a;
  transition: box-shadow var(--dur-base) var(--ease-smooth), transform var(--dur-slow) var(--ease-out-expo), border-color var(--dur-fast) var(--ease-smooth);
 }
 .photo-card:hover .photo-frame {
  border-color: var(--color-line-strong);
  box-shadow: var(--shadow-lift);
  transform: translateY(-4px);
 }
 .photo-frame img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 6px;
 }
 .photo-wide .photo-frame img { max-height: 78vh; object-fit: contain; width: auto; max-width: 100%; margin: 0 auto; }
 figcaption {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-top: 12px;
  padding: 0 4px;
  font-size: 14px;
  color: var(--color-ink);
 }
 .photo-no {
  font-family: var(--font-editorial);
  font-style: italic;
  font-size: 12px;
  color: var(--color-accent);
 }
 @media (max-width: 640px) {
  .gallery-grid { grid-template-columns: 1fr; gap: 22px; }
 }
</style>
