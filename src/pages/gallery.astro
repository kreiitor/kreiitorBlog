---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
// 隐藏页：不进导航，只从关于页的彩蛋进入。
---
<BaseLayout title="有意义的图" description="一些值得留下的瞬间。">
 <div data-pagefind-ignore>
  <section class="page-shell gallery-head">
   <div><p class="eyebrow">生活的切片</p><h1>一些有意义的图。</h1></div>
   <p>有些瞬间无需展开成文，<br/>也值得好好收藏。<span>点击照片，放大看看。</span></p>
  </section>
  <section class="page-shell" aria-label="照片集"><PhotoGallery/></section>
 </div>
</BaseLayout>
<style>
 .gallery-head { display: flex; justify-content: space-between; align-items: end; gap: 32px; padding-block: 56px 32px; }
 .gallery-head h1 { margin-top: 12px; font-size: clamp(32px,4vw,48px); }
 .gallery-head > p { color: var(--color-ink-soft); font-size: 14px; line-height: 1.9; }
 .gallery-head > p span { display: block; margin-top: 10px; font-size: 13px; }
 @media (max-width: 640px) {
  .gallery-head { display: block; padding-top: 36px; }
  .gallery-head > p { margin-top: 16px; }
 }
</style>
