---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../data/site';
import { getPublishedPosts, getTagSummaries } from '../utils/content';
import { getLearningSeries } from '../utils/series';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';
import avatarSvg from '../../public/avatar.svg?raw';
import { sections } from '../data/sections';

const posts = await getCollection('posts');
const publishedPosts = getPublishedPosts(posts);
const series = getLearningSeries(await getCollection('series'), posts);
const seriesTitle = new Map(series.map(item => [item.entry.id, item.entry.data.title]));
const articles = publishedPosts.filter(post => post.data.category === 'knowledge').slice(0, 6);
const notes = publishedPosts.filter(post => post.data.category === 'course').slice(0, 6);
const jottings = publishedPosts.filter(post => post.data.category === 'writing').slice(0, 3);
const tags = getTagSummaries(posts, await getCollection('projects')).slice(0, 6);

// 字数：汉字逐字计，拉丁按词计。
const words = publishedPosts.reduce((sum, post) => {
 const body = post.body ?? '';
 return sum + (body.match(/\p{Script=Han}/gu)?.length ?? 0) + (body.match(/[A-Za-z0-9]+/g)?.length ?? 0);
}, 0);
const firstDate = publishedPosts.at(-1)?.data.pubDate;
const stats: { value: number; unit: string; prefix?: string; since?: string }[] = [
 { value: publishedPosts.length, unit: '篇' },
 { value: Math.round(words / 10000), unit: '万字', prefix: '约 ' },
 ...(firstDate ? [{ value: Math.max(1, Math.ceil((Date.now() - firstDate.getTime()) / 864e5)), unit: '天', since: firstDate.toISOString() }] : []),
];

// 时间线：最近 12 个月，每月一个点，大小随篇数变化。
const now = new Date();
const months = Array.from({ length: 12 }, (_, i) => {
 const date = new Date(now.getFullYear(), now.getMonth() - 11 + i, 1);
 const items = publishedPosts.filter(post => post.data.pubDate.getUTCFullYear() === date.getFullYear() && post.data.pubDate.getUTCMonth() === date.getMonth());
 return { label: `${date.getMonth() + 1}月`, year: date.getFullYear(), anchor: items.length ? `#m-${date.getFullYear()}-${date.getMonth() + 1}` : '', count: items.length, latest: items[0] };
});
const peak = Math.max(1, ...months.map(month => month.count));
const yearCount = publishedPosts.filter(post => post.data.pubDate.getUTCFullYear() === now.getFullYear()).length;
const latest = publishedPosts[0];
// 头像内联而不是 <img>，鹤纹才能跟随主题取色；去掉 title 与 id，避免和页头标志重复。
const avatarMark = avatarSvg.replace(/ role="img" aria-labelledby="logo-title"/, '').replace(/<title[^>]*>.*?<\/title>/s, '').replace(/<style>.*?<\/style>/s, '');
const typed = ['札记', '长卷', '闲笔', '可复用的知识'];
// 首屏背景里的纸鹤：位置、大小、速度各不相同，负延迟让它们在首帧就已经在半途，不会一起从左边起飞。
const cranes = [
 { y: 14, size: 26, dur: 62, delay: -8, rise: -6, opacity: .16, bob: 5.2 },
 { y: 26, size: 16, dur: 78, delay: -41, rise: -4, opacity: .11, bob: 4.4 },
 { y: 58, size: 34, dur: 70, delay: -27, rise: -9, opacity: .12, bob: 6.1 },
 { y: 72, size: 18, dur: 88, delay: -63, rise: -5, opacity: .1, bob: 4.8 },
 { y: 38, size: 22, dur: 94, delay: -12, rise: -7, opacity: .13, bob: 5.6 },
 { y: 84, size: 14, dur: 66, delay: -50, rise: -3, opacity: .09, bob: 4.1 },
 { y: 8, size: 12, dur: 84, delay: -72, rise: -2, opacity: .08, bob: 3.8 },
];
// 列表右栏只放「月-日」：等宽、短，同一列里不会一行「6 天前」一行完整日期。跨年的才带年份。
const pad = (n: number) => String(n).padStart(2, '0');
const shortDate = (date: Date) => `${date.getUTCFullYear() === now.getFullYear() ? '' : `${date.getUTCFullYear()}-`}${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())}`;
---
<BaseLayout>
 <div class="home-page" data-pagefind-ignore>
  <section class="intro" data-home-hero>
   <div class="ambient" aria-hidden="true">
    <span class="blob blob-warm"></span><span class="blob blob-ink"></span><span class="grid"></span>
    <div class="flock">
     <svg width="0" height="0" class="flock-defs"><symbol id="crane" viewBox="0 0 64 64"><path d="M19 40 32 32 45 40 32 51zM20.5 39 32 33 15 5zM17 39.5 29 49 8 20zM47 39.5 35 49 59 22z" fill="currentColor"/><path d="M32 33 43.5 39 49 5z" fill="currentColor" fill-opacity=".5"/><path d="M8 20 12.5 22.5 4 30z" fill="var(--color-accent)"/></symbol></svg>
     {cranes.map(crane => <span class="crane" style={`--y:${crane.y}%;--s:${crane.size}px;--dur:${crane.dur}s;--delay:${crane.delay}s;--rise:${crane.rise}vh;--o:${crane.opacity};--bob:${crane.bob}s`}><svg viewBox="0 0 64 64"><use href="#crane"/></svg></span>)}
    </div>
   </div>
   <div class="hero-copy">
    <div class="avatar reveal" style="--d:0"><span class="avatar-disc" aria-hidden="true" set:html={avatarMark}/></div>
    <h1 class="greeting reveal" style="--d:1"><span class="word" style="--w:0">Hi,</span> <span class="word" style="--w:1">我是</span> <b class="name word" style="--w:2">kreiitor<svg class="brush" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 9c34-5 72-7 110-6 30 1 58 3 84 1" pathLength="1"/></svg></b></h1>
    <p class="claim reveal" style="--d:2">把读过的、试过的，写成<span class="typed" data-typed={JSON.stringify(typed)} aria-hidden="true"><span data-typed-text>{typed[0]}</span><span class="caret"></span></span><span class="sr-only">札记、长卷与闲笔</span></p>
    <p class="role reveal" style="--d:3"><span>{siteConfig.role}</span><span class="role-divider" aria-hidden="true"> · </span><span class="role-details">AI 工程 · 程序分析 · 实验复现</span></p>
    <p class="motto reveal" style="--d:4">「{siteConfig.tagline}。」</p>
    <p class="stats reveal" style="--d:5">{stats.map((item, index) => <>{index > 0 && <i aria-hidden="true">·</i>}<span>{item.prefix}<b data-count={item.value} data-since={item.since}>{item.value}</b> {item.unit}</span></>)}</p>
    <ul class="socials reveal" style="--d:6" aria-label="联系与订阅">
     <li><a href="https://github.com/kreiitor" aria-label="GitHub"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.030-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg></a></li>
     <li><a href={`mailto:${siteConfig.email}`} aria-label="Email"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6 8.5-6"/></svg></a></li>
     <li><a href={withBase('/rss.xml')} aria-label="RSS 订阅"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M5 5a14 14 0 0 1 14 14M5 11a8 8 0 0 1 8 8"/><circle cx="6" cy="18" r="1.3" fill="currentColor"/></svg></a></li>
     <li><a href={withBase('/search/')} aria-label="搜索"><Icon name="search" size={19}/></a></li>
    </ul>
   </div>
   <a class="scroll-cue reveal" style="--d:7" href="#recent" aria-label="向下浏览三个栏目"><span></span></a>
  </section>

  <section class="page-shell recent" id="recent">
   <div class="column">
    <header class="sec-head"><p><span>01</span>零散的知识与教训</p><h2>{sections.knowledge.label}</h2></header>
    <ol class="feed">
     {articles.map((post, index) => <li class="feed-item">
      <a href={withBase(`/blog/${post.id}/`)}>
       <span class="feed-no">{String(index + 1).padStart(2, '0')}</span>
       <span class="feed-title">{post.data.title}</span>
       <span class="feed-meta">{post.data.tags.slice(0, 2).join(' · ')}</span>
       <time class="feed-time" datetime={post.data.pubDate.toISOString()} title={formatDate(post.data.pubDate)}>{shortDate(post.data.pubDate)}</time>
      </a>
     </li>)}
    </ol>
    <a class="more" href={withBase(sections.knowledge.href)}>全部札记 <Icon name="arrow" size={15}/></a>
   </div>
   <div class="column">
    <header class="sec-head"><p><span>02</span>成体系的学习笔记</p><h2>{sections.course.label}</h2></header>
    <ol class="feed feed-notes">
     {notes.map(post => <li class="feed-item">
      <a href={withBase(`/blog/${post.id}/`)}>
       <span class="feed-title">{post.data.title}</span>
       <span class="feed-meta">{seriesTitle.get(post.data.series ?? '') ?? sections.course.label}</span>
       <time class="feed-time" datetime={post.data.pubDate.toISOString()} title={formatDate(post.data.pubDate)}>{shortDate(post.data.pubDate)}</time>
      </a>
     </li>)}
    </ol>
    <a class="more" href={withBase(sections.course.href)}>{series.length} 卷 <Icon name="arrow" size={15}/></a>
   </div>
  </section>

  <section class="page-shell jottings" aria-labelledby="home-jottings">
   <header class="sec-head"><p><span>03</span>日常的片刻</p><h2 id="home-jottings">{sections.writing.label}</h2></header>
   <ol class="jotting-feed">
     {jottings.map(post => <li><a href={withBase(`/blog/${post.id}/`)}><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>{post.data.title}</span></a></li>)}
     {jottings.length === 0 && <li class="jotting-empty">还没有写下什么。</li>}
   </ol>
   <a class="more" href={withBase(sections.writing.href)}>全部闲笔 <Icon name="arrow" size={15}/></a>
  </section>

  <section class="page-shell timeline" data-timeline>
   <header class="sec-head"><p><span>04</span>时间</p><h2>笔耕不辍</h2><span class="sec-aside">今年 <b>{yearCount}</b> 篇</span></header>
   <ol class="months">
    {months.map((month, index) => <li style={`--s:${month.count ? (.18 + Math.sqrt(month.count / peak) * .82).toFixed(3) : 0};--i:${index}`} class:list={{ 'is-empty': !month.count, 'is-now': index === months.length - 1 }}>
     <a href={`${withBase('/archive/')}${month.anchor}`} aria-label={`${month.year} 年 ${month.label}：${month.count} 篇`}>
      <span class="bar" aria-hidden="true"><span class="count">{month.count || ''}</span></span>
      <span class="month" aria-hidden="true">{index === months.length - 1 ? '今' : month.label}</span>
      {month.count > 0 && <span class="tip" aria-hidden="true">{month.count} 篇{month.latest && ` · ${month.latest.data.title}`}</span>}
     </a>
    </li>)}
   </ol>
   {latest && <p class="latest">近作 · <a href={withBase(`/blog/${latest.id}/`)}>{latest.data.title}</a></p>}
   <p class="year"><a href={withBase('/archive/')}>翻阅完整时间线 <Icon name="arrow" size={14}/></a></p>
  </section>

  <section class="page-shell outro">
   <header class="sec-head"><p><span>05</span>来信</p></header>
   <p class="greet" data-greet><span>你好，</span><span>欢迎来信。</span></p>
   <div class="outro-links">
    <a href={`mailto:${siteConfig.email}`}><b>写一封信</b><span>{siteConfig.email}</span><Icon name="arrow" size={18}/></a>
    <a href={withBase('/rss.xml')}><b>订阅更新</b><span>RSS，不错过每一篇。</span><Icon name="arrow" size={18}/></a>
   </div>
   <nav class="topic-row" aria-label="常见话题">{tags.map(item => <a href={withBase(`/tags/${encodeURIComponent(item.tag)}/`)}>{item.tag}</a>)}<a href={withBase('/projects/')}>项目</a></nav>
  </section>
 </div>
</BaseLayout>
<script>
 const day = 24 * 60 * 60 * 1000;
 const since = document.querySelector<HTMLElement>('[data-since]');
 if (since?.dataset.since) {
  const start = Date.parse(since.dataset.since);
  if (Number.isFinite(start)) since.textContent = String(Math.max(1, Math.ceil((Date.now() - start) / day)));
 }
 const hero = document.querySelector<HTMLElement>('[data-home-hero]');
 const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

 // 统计数字从 0 数到目标值，用 ease-out 收尾；先按最终位数锁住宽度，数字跳动时统计条不变宽。
 if (!still) {
  document.querySelectorAll<HTMLElement>('.stats b[data-count]').forEach((node, index) => {
   const target = Number(node.textContent);
   if (!Number.isFinite(target) || target <= 0) return;
   node.style.setProperty('--digits', `${String(target).length}ch`);
   const begin = performance.now() + 520 + index * 120, length = 1400;
   node.textContent = '0';
   const tick = (now: number) => {
    const t = Math.min(1, Math.max(0, (now - begin) / length));
    node.textContent = String(Math.round(target * (1 - (1 - t) ** 4)));
    if (t < 1) requestAnimationFrame(tick);
   };
   requestAnimationFrame(tick);
  });
 }

 // 首屏离开视口时暂停背景里的常驻动画，滚回来再继续。
 if (hero && 'IntersectionObserver' in window) {
  new IntersectionObserver(([entry]) => {
   if (entry.isIntersecting) delete hero.dataset.paused;
   else hero.dataset.paused = '';
  }).observe(hero);
 }

 // 指针显影与视差：点阵只在指针附近出现，光团和纸鹤按远近反向轻移。每帧最多写一次自定义属性。
 if (hero && matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
  let pending = false, x = 0, y = 0;
  hero.addEventListener('pointermove', event => {
   const rect = hero.getBoundingClientRect();
   x = (event.clientX - rect.left) / rect.width; y = (event.clientY - rect.top) / rect.height;
   if (pending) return;
   pending = true;
   requestAnimationFrame(() => {
    pending = false;
    hero.style.setProperty('--px', x.toFixed(3)); hero.style.setProperty('--py', y.toFixed(3));
    hero.dataset.lit = '';
   });
  }, { passive: true });
  hero.addEventListener('pointerleave', () => delete hero.dataset.lit);
 }

 const typed = document.querySelector<HTMLElement>('[data-typed]');
 const text = typed?.querySelector<HTMLElement>('[data-typed-text]');
 const reduced = matchMedia('(prefers-reduced-motion: reduce)');
 if (typed?.dataset.typed && text && !reduced.matches) {
  const words: string[] = JSON.parse(typed.dataset.typed);
  let index = 0;
  let length = words[0]?.length ?? 0;
  let deleting = true;
  let timer = 0;
  // 只有真的在打字时才预留最长词的宽度；无脚本或减少动态时，这一行按实际文字居中。
  typed.dataset.typing = '';
  const step = () => {
   if (reduced.matches) return;
   if (deleting) {
    length--;
    text.textContent = words[index].slice(0, length);
    if (length === 0) { deleting = false; index++; }
   } else {
    length++;
    text.textContent = words[index].slice(0, length);
    if (length === words[index].length) {
     deleting = true;
     if (index === words.length - 1) { typed.dataset.done = ''; return; }
     timer = window.setTimeout(step, 450);
     return;
    }
   }
   timer = window.setTimeout(step, deleting ? 35 : 65);
  };
  timer = window.setTimeout(step, 650);
  reduced.addEventListener('change', event => {
   if (event.matches) { window.clearTimeout(timer); text.textContent = words[0]; delete typed.dataset.typing; }
  });
 }
</script>
<style>
 /* ===== 首页统一系统 =====
    节奏：区块间距 --gap；所有区块共用一个 .sec-head（编号 · 英文眉题 · 中文标题）。
    色彩：朱砂只落在首屏的打字词、当月柱和来信的落款上；编号、分隔线、悬停都用墨色深浅。
    动效：入场 .reveal 只播一次；首屏占满一屏，所以背景有慢速常驻层（纸鹤、光团、头像绕行点），离开视口即暂停；滚动联动全部交给 animation-timeline。 */
 .home-page { --gap: 120px; --ease-spring: cubic-bezier(.34,1.56,.64,1); position: relative; isolation: isolate; overflow-x: clip; padding-bottom: 0; }

 /* ---------- 首屏 ---------- */
 /* 首屏只放欢迎：正好占满一屏视口（扣掉页头），栏目从第二屏开始。内容略高于正中，视觉重心更稳。 */
 .intro { position: relative; isolation: isolate; display: grid; place-items: center; min-height: max(520px,calc(100svh - var(--header-height))); padding: 40px 24px 112px; text-align: center; }
 .ambient { --px: .5; --py: .4; position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
 /* 两团光：暖的朱砂偏左上，冷的墨色偏右下，各自慢慢游走，像纸面上移动的天光。
    用 blur 代替长距离渐变：8 位色深下大面积浅渐变会出现色带，模糊后的实心椭圆过渡更平。
    只动 transform，模糊层由合成器搬运，不重新栅格化。 */
 .blob { position: absolute; border-radius: 50%; filter: blur(90px); will-change: transform; }
 .blob-warm { left: 18%; top: -12%; width: min(640px,80vw); aspect-ratio: 1.6; background: color-mix(in srgb,var(--color-accent) 7%,transparent); animation: wander-a 26s ease-in-out infinite alternate; }
 .blob-ink { right: 8%; bottom: -6%; width: min(520px,70vw); aspect-ratio: 1.4; background: color-mix(in srgb,var(--color-counterpoint) 7%,transparent); animation: wander-b 32s ease-in-out infinite alternate; }

 /* 千羽：几只纸鹤在背景里从左往右慢慢飞过，一边轻轻起伏。外层管横向位移，内层管起伏和振翅，互不干扰。 */
 .flock { position: absolute; inset: 0; color: var(--color-ink); }
 .flock-defs { position: absolute; }
 .crane { position: absolute; left: 0; top: var(--y); width: var(--s); opacity: var(--o); translate: -10vw 0; animation: fly var(--dur) linear var(--delay) infinite; will-change: translate; }
 .crane svg { display: block; width: 100%; height: auto; animation: bob var(--bob) ease-in-out infinite alternate; transform-origin: 50% 60%; }
 .crane:nth-child(odd) svg { animation-direction: alternate-reverse; }
 /* 视差：越大的鹤越近，随指针移动得越多；光团最远，几乎不动。 */
 .flock { translate: calc((var(--px) - .5) * -28px) calc((var(--py) - .5) * -18px); transition: translate 1.2s var(--ease-out-expo); }
 .blob-warm,.blob-ink { translate: calc((var(--px) - .5) * 14px) calc((var(--py) - .5) * 10px); transition: translate 1.6s var(--ease-out-expo); }
 [data-paused] :is(.blob,.crane,.crane svg),[data-paused] .avatar::after { animation-play-state: paused; }
 /* 细点阵只在指针附近显影，像手电照过纸面。 */
 .grid { position: absolute; inset: 0; background-image: radial-gradient(var(--color-grid-dot) 1px,transparent 1.4px); background-size: 24px 24px; opacity: .9; -webkit-mask-image: radial-gradient(260px 260px at calc(var(--px) * 100%) calc(var(--py) * 100%),#000,transparent 70%); mask-image: radial-gradient(260px 260px at calc(var(--px) * 100%) calc(var(--py) * 100%),#000,transparent 70%); transition: opacity var(--dur-slow); }
 .intro:not([data-lit]) .grid { opacity: 0; }

 .hero-copy { width: min(100%,760px); }
 .avatar { position: relative; display: flex; justify-content: center; margin-bottom: 26px; }
 .avatar-disc { position: relative; z-index: 1; display: grid; place-items: center; width: 92px; height: 92px; border: 1px solid var(--color-line); border-radius: 50%; background: var(--color-surface); box-shadow: 0 10px 30px -14px var(--shadow-tint-strong); transition: transform var(--dur-slow) var(--ease-out-expo); }
 .avatar:hover .avatar-disc { transform: rotate(-6deg); }
 .avatar-disc :global(svg) { width: 64%; height: 64%; }
 .avatar-disc :global(.brand-ink) { fill: var(--color-ink); }
 .avatar-disc :global(.brand-accent) { fill: var(--color-accent); }
 /* 头像外一圈发丝线，上面一颗朱砂小点沿着圆慢慢绕行。旋转的是整圈，圆本身没有可见的转动。 */
 .avatar::before { content: ''; position: absolute; left: 50%; top: 50%; width: 106px; height: 106px; margin: -53px 0 0 -53px; border: 1px solid var(--color-line); border-radius: 50%; }
 .avatar::after { content: ''; position: absolute; left: 50%; top: 50%; width: 106px; height: 106px; margin: -53px 0 0 -53px; border-radius: 50%; background: radial-gradient(circle at 50% 0,var(--color-accent) 0 2.5px,transparent 3px); animation: orbit 18s linear infinite; }
 .greeting { font-size: clamp(34px,1.4rem + 2.4vw,52px); line-height: 1.22; letter-spacing: -.01em; }
 .greeting b { font-weight: 600; }
