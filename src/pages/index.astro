---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { getLearningSeries } from '../utils/series';
import SectionHeading from '../components/SectionHeading.astro';
import ResearchArt from '../components/ResearchArt.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
import { getFeaturedPosts, getFeaturedProjects, getPublishedPosts, getProjects, getTagSummaries, getReadingTime } from '../utils/content';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';
const posts = await getCollection('posts');
const projects = await getCollection('projects');
const publishedPosts = getPublishedPosts(posts);
const sortedProjects = getProjects(projects);
const curatedSelections = siteConfig.homeFeaturedPosts.flatMap(selection => {
 const post = publishedPosts.find(post => post.id === selection.id);
 return post ? [{ post, label: selection.label }] : [];
});
const curatedPosts = curatedSelections.map(selection => selection.post);
const featuredPosts = [...curatedPosts, ...getFeaturedPosts(posts).filter(post => !curatedPosts.some(item => item.id === post.id))].slice(0,3);
const featuredLabels = featuredPosts.map(post => curatedSelections.find(selection => selection.post.id === post.id)?.label ?? '精选札记');
const featuredIds = new Set(featuredPosts.map(post => post.id));
const recentPosts = publishedPosts.filter(post => !featuredIds.has(post.id)).slice(0,5);
const featuredProjects = getFeaturedProjects(projects,2);
const allTags = getTagSummaries(posts,projects);
const tags = allTags.slice(0,8);
const learningSeries = getLearningSeries(await getCollection('series'), posts);
---
<BaseLayout>
 <div class="home-page" data-pagefind-ignore>
  <section class="page-shell home-hero">
   <div class="hero-copy zen-reveal">
    <p class="hero-kicker"><span aria-hidden="true"></span>AI for Software Engineering</p>
    <h1>读论文，写代码，<span>让想法经得起实验。</span></h1>
    <p class="hero-description">我是 <a href={withBase('/about/')} class="hero-author">{siteConfig.author}</a>，研究 AI 与软件工程。<br/>记录论文阅读、实验复现与技术写作。</p>
    <div class="hero-actions"><a href={withBase('/blog/')} class="zen-btn zen-btn-primary">阅读研究札记 <Icon name="arrow" size={18}/></a><a href={withBase('/notes/')} class="text-link">探索学习专题 <Icon name="arrow" size={16}/></a></div>
    <div class="hero-caption"><p>程序分析 <span aria-hidden="true">/</span> LLM 评测 <span aria-hidden="true">/</span> 实验与复现</p></div>
   </div>
   <div class="hero-visual zen-reveal zen-delay-1"><ResearchArt/></div>
  </section>
  <section class="page-shell journal-strip" aria-label="站点概况">
   <p>以问题为线索<span class="strip-subtitle">论文、实验与持续学习</span></p>
   <div class="journal-counts"><a href={withBase('/blog/')}><strong>{publishedPosts.length}</strong> 篇札记</a><a href={withBase('/projects/')}><strong>{sortedProjects.length}</strong> 个项目</a><a href={withBase('/tags/')}><strong>{allTags.length}</strong> 个话题</a></div>
  </section>
  <section class="page-shell editorial-section writing-section">
   <SectionHeading title="精选札记" description="从问题出发，把方法与实践写清楚。" linkHref={withBase('/blog/')} linkLabel="阅读全部札记"/>
   <div class="selected-writing">
    {featuredPosts[0] && <PostCard post={featuredPosts[0]} featured featuredLabel={featuredLabels[0]}/>}
    <div class="selected-rows">{featuredPosts.slice(1).map((post,index) => <a href={withBase(`/blog/${post.id}/`)} class="selected-row"><p class="selection-label">{featuredLabels[index+1]}</p><h3>{post.data.title}</h3><p class="card-description">{post.data.description}</p><div class="selected-meta"><span>{formatDate(post.data.pubDate)} · {getReadingTime(post)} 分钟阅读</span><Icon name="arrow" size={20}/></div></a>)}<a class="selected-invitation" href={withBase('/archive/')}><span>更多思考，留在时间里。</span><span>沿时间线浏览 <Icon name="arrow" size={16}/></span></a></div>
   </div>
  </section>
  <section class="page-shell editorial-section learning-section">
   <SectionHeading title="沿着一条主线学下去" description="概念、推导与实践，整理成可以重访的路径。" linkHref={withBase('/notes/')} linkLabel="全部学习专题"/>
   <div class="series-grid home-series">{learningSeries.slice(0,3).map(item => <SeriesCard series={item} presentation="index"/>)}</div>
   {learningSeries.length === 0 && <p class="section-description">学习笔记正在整理中。</p>}
  </section>
  <section class="page-shell editorial-section">
   <SectionHeading title="把想法做成工具" description="论文复现、实验平台，以及正在打磨的项目。" linkHref={withBase('/projects/')} linkLabel="浏览研究项目"/>
   <div class="project-grid">{featuredProjects.map(project => <ProjectCard project={project} showcase/>)}</div>
  </section>
  <section class="page-shell editorial-section lower-grid">
   <div>
    <SectionHeading title="最近写下" linkHref={withBase('/archive/')} linkLabel="时间归档"/>
    <div class="recent-list">{recentPosts.map((post,index) => <a href={withBase(`/blog/${post.id}/`)} class="recent-row"><span class="recent-number">{String(index+1).padStart(2,'0')}</span><div><p class="card-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>· {getReadingTime(post)} 分钟</span></p><h3>{post.data.title}</h3></div><Icon name="arrow" size={18}/></a>)}</div>
   </div>
   <aside class="garden-aside">
    <p class="aside-kicker">话题索引</p><h2>循着好奇心，<br/>找到下一个问题。</h2>
    <div class="topic-list">{tags.map(item => <a href={withBase(`/tags/${encodeURIComponent(item.tag)}/`)}><span>{item.tag}</span><span>{item.count} →</span></a>)}</div>
    <div class="aside-note"><span aria-hidden="true">↳</span><p>不急于给出答案。<br/>先把值得追问的问题留下来。</p></div>
    <a href={withBase('/rss.xml')} class="text-link rss-link">用 RSS 订阅新札记 <span aria-hidden="true">↗</span></a>
   </aside>
  </section>
 </div>
</BaseLayout>
<style>
 .home-hero { display: grid; grid-template-columns: minmax(0,1.5fr) minmax(0,1fr); align-items: center; gap: 56px; padding-block: 42px 36px; }
 .hero-visual { width: 100%; max-width: 364px; justify-self: end; margin-right: 10px; }
 .journal-strip + .editorial-section { margin-top: 40px; }
 .selected-writing { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(0,.9fr); gap: 56px; margin-top: 30px; align-items: start; }
 .selected-writing > *, .home-hero > * { min-width: 0; }
 .selected-rows { border-top: 3px solid var(--color-counterpoint); }
 .selected-row { position: relative; display: block; padding: 24px 0 26px; border-bottom: 1px solid var(--color-line); }
 .selected-writing :global(.card-content h3) { font-size: 27px; line-height: 1.6; text-wrap: pretty; }
 .selection-label { font-size: var(--text-caption); font-weight: 500; color: var(--color-counterpoint-ink); }
 .selected-row h3 { font-size: 23px; margin-block: 12px; line-height: 1.65; }
 .selected-row .card-description { overflow-wrap: anywhere; }
 .selected-row:is(:hover,:focus-visible) h3 { color: var(--color-accent); }
 .selected-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 20px; font-size: 12px; color: var(--color-ink-soft); }
 .selected-meta :global(svg) { color: var(--color-accent); transition: transform 160ms var(--ease-smooth); }
 .selected-row:is(:hover,:focus-visible) :global(svg) { transform: translateX(5px); }
 .selected-row::after { content: ''; position: absolute; inset: auto 0 -1px; height: 1px; background: var(--color-accent); transform: scaleX(0); transform-origin: left; transition: transform 280ms var(--ease-out-expo); }
 .selected-row:is(:hover,:focus-visible)::after { transform: scaleX(1); }
 .selected-invitation { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px; padding-top: 24px; font-size: 12px; color: var(--color-ink-soft); }
 .selected-invitation span:last-child { color: var(--color-accent); }
 @media (max-width: 900px) { .selected-writing { grid-template-columns: minmax(0,1fr); gap: 25px; } .selected-row h3 { font-size: 22px; } }
 .hero-kicker { display: flex; align-items: center; gap: 10px; font-size: var(--text-caption); color: var(--color-accent); }
 .hero-kicker span { width: 22px; height: 2px; background: var(--color-counterpoint); }
 .hero-copy h1 { font-family: var(--font-title); font-size: clamp(38px,4.3vw,62px); font-weight: 600; line-height: 1.35; letter-spacing: -.045em; margin-top: 24px; text-wrap: balance; }
 .hero-copy h1 span { display: block; }
 .hero-copy.zen-reveal { animation: none; }
 .hero-copy > * { animation: hero-intro 560ms var(--ease-out-expo) both; }
 .hero-copy h1 { animation-delay: 50ms; }
 .hero-copy .hero-description { animation-delay: 100ms; }
 .hero-copy .hero-actions { animation-delay: 150ms; }
 .hero-copy .hero-caption { animation-delay: 200ms; }
 @keyframes hero-intro { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
 @media (prefers-reduced-motion: reduce) { .hero-copy > * { animation: none; } }
 .hero-description { margin-top: 24px; font-size: 15px; line-height: 1.95; color: var(--color-ink-soft); }
 .hero-author { display: inline-block; padding-block: 3px; font-weight: 500; color: var(--color-ink); text-decoration: underline; text-decoration-color: var(--color-line-strong); text-underline-offset: 4px; }
 .hero-author:hover { color: var(--color-accent); text-decoration-color: currentColor; }
 .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 24px; }
 .hero-actions .zen-btn { min-height: 48px; padding-inline: 24px; border-radius: 3px; }
 .hero-caption { margin-top: 22px; color: var(--color-ink-muted); }
 .hero-caption p { font-size: var(--text-caption); } .hero-caption p > span { margin: 0 12px; color: var(--color-line-strong); }
 .journal-strip { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-block: 9px; border-block: 1px solid var(--color-line); }
 .journal-strip > p { display: flex; align-items: center; gap: 12px; font-size: var(--text-caption); }
 .strip-subtitle { font-size: var(--text-caption); color: var(--color-ink-muted); padding-left: 10px; }
 .journal-counts { display: flex; gap: 25px; font-size: var(--text-caption); color: var(--color-ink-soft); }
 .journal-counts a { display: inline-flex; align-items: center; min-height: 44px; }
 .journal-counts strong { font-family: var(--font-editorial); font-size: 18px; font-weight: 400; font-variant-numeric: tabular-nums; color: var(--color-ink); margin-right: 6px; }
 .home-series { grid-template-columns: minmax(0,1fr); gap: 0; margin-top: 6px; }
 .home-page :global(.section-heading h2) { font-size: 30px; }
 .project-grid { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,1fr); gap: 32px; margin-top: 30px; }
 .project-grid :global(.project-showcase:nth-child(2)) { margin-top: 40px; }
 .lower-grid { display: grid; grid-template-columns: minmax(0,1fr) 310px; gap: 65px; }
 .recent-row { display: flex; gap: 20px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--color-line); }
 .recent-number { font-family: var(--font-editorial); font-size: 19px; color: var(--color-ink-muted); }
 .recent-row h3 { font-family: var(--font-title); font-size: 18px; font-weight: 600; line-height: 1.65; margin-top: 6px; }
 .recent-row > :global(svg) { margin-left: auto; color: var(--color-accent); } .recent-row:hover h3 { color: var(--color-accent); }
 .garden-aside { padding: 30px; background: var(--color-highlight-soft); border: 1px solid var(--color-line); border-top: 3px solid var(--color-counterpoint); border-radius: 3px; }
 .aside-kicker { font-size: var(--text-caption); color: var(--color-ink-soft); }
 .garden-aside h2 { font-size: 23px; line-height: 1.7; margin-top: 15px; }
 .topic-list { margin-top: 23px; } .topic-list a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 9px 0; font-size: var(--text-caption); border-bottom: 1px solid var(--color-line); }
 .topic-list a > span:last-child { color: var(--color-ink-soft); font-size: var(--text-caption); }
 .topic-list a:hover { color: var(--color-accent); }
 .aside-note { display: flex; gap: 14px; margin-top: 28px; color: var(--color-ink-soft); font-size: var(--text-caption); line-height: 2; }
 .aside-note > span { font-size: 24px; color: var(--color-accent); } .rss-link { margin-top: 25px; font-size: var(--text-caption); }
 @media (max-width: 1100px) { .home-hero { gap: 35px; } .selected-writing { gap: 32px; } .strip-subtitle { display: none; } .lower-grid { gap: 35px; } }
 @media (max-width: 900px) { .hero-copy h1 { font-size: 34px; } .lower-grid { grid-template-columns: 1fr 260px; gap: 25px; } .garden-aside { padding: 22px; } .project-grid { gap: 24px; } .selected-writing :global(.card-content h3) { font-size: 23px; } }
 @media (max-width: 900px) {
  .home-hero { grid-template-columns: 1fr; padding-block: 28px 24px; gap: 24px; }
  .hero-copy h1 { font-size: clamp(29px,8vw,44px); margin-top: 18px; line-height: 1.5; }
  .hero-description { font-size: 14px; margin-top: 18px; }
  .hero-actions { margin-top: 20px; gap: 12px 20px; }
  .hero-caption { display: none; }
  .hero-visual { max-width: none; width: calc(100% - 8px); justify-self: start; margin-right: 0; }
  .journal-strip { padding-block: 6px; }
  .journal-strip > p { display: none; }
  .journal-counts { justify-content: space-between; gap: 12px; width: 100%; }
  .lower-grid { grid-template-columns: 1fr; gap: 35px; }
  .editorial-section { margin-top: 44px; }
  .journal-strip + .editorial-section { margin-top: 32px; }
  .selected-writing { margin-top: 20px; }
  .home-page :global(.section-heading h2) { font-size: 25px; }
  .project-grid { grid-template-columns: minmax(0,1fr); }
  .project-grid :global(.project-showcase:nth-child(2)) { margin-top: 0; }
 }
 @media (max-width: 600px) {
  .writing-section :global(.section-heading) { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 8px 12px; }
  .writing-section :global(.section-heading > div) { display: contents; }
  .writing-section :global(.section-heading h2) { grid-column: 1; grid-row: 1; }
  .writing-section :global(.section-heading .text-link) { grid-column: 2; grid-row: 1; }
  .writing-section :global(.section-heading .section-description) { grid-column: 1 / -1; grid-row: 2; margin-top: 0; }
 }
</style>
