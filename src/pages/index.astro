---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../data/site';
import { photos } from '../data/photos';
import { countProseWords, getProjects, getPublishedPosts, getReadingTime, getTagSummaries } from '../utils/content';
import { getLearningSeries } from '../utils/series';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';
import { sections } from '../data/sections';

const posts = await getCollection('posts');
const publishedPosts = getPublishedPosts(posts);
const series = getLearningSeries(await getCollection('series'), posts);
const projects = getProjects(await getCollection('projects'));

const allArticles = publishedPosts.filter(post => post.data.category === 'knowledge');
const jottings = publishedPosts.filter(post => post.data.category === 'writing');
const latestJotting = jottings[0];
const tags = getTagSummaries(posts, projects).slice(0, 6);

const knowledgeTagCounts = new Map<string, number>();
for (const post of allArticles) {
 for (const tag of post.data.tags) {
  knowledgeTagCounts.set(tag, (knowledgeTagCounts.get(tag) ?? 0) + 1);
 }
}
const topKnowledgeTags = [...knowledgeTagCounts.entries()]
 .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'))
 .slice(0, 3)
 .map(([tag]) => tag);

const visibleNoteIds = new Set<string>(allArticles.slice(0, 6).map(post => post.id));
for (const tag of topKnowledgeTags) {
 for (const post of allArticles.filter(item => item.data.tags.includes(tag)).slice(0, 6)) {
  visibleNoteIds.add(post.id);
 }
}
const homeNotePool = allArticles.filter(post => visibleNoteIds.has(post.id));

const words = publishedPosts.reduce((sum, post) => sum + countProseWords(post.body ?? ''), 0);
const wordsTenK = Math.max(1, Math.round(words / 10000));
const homePhotos = photos.slice(0, 4);
const stem = (file: string) => file.replace(/\.jpe?g$/i, '');

const now = new Date();
const months = Array.from({ length: 12 }, (_, i) => {
 const date = new Date(now.getFullYear(), now.getMonth() - 11 + i, 1);
 const items = publishedPosts.filter(
  post => post.data.pubDate.getUTCFullYear() === date.getFullYear() && post.data.pubDate.getUTCMonth() === date.getMonth(),
 );
 return {
  label: `${date.getMonth() + 1}月`,
  year: date.getFullYear(),
  anchor: items.length ? `#m-${date.getFullYear()}-${date.getMonth() + 1}` : '',
  count: items.length,
  latest: items[0],
 };
});
const peak = Math.max(1, ...months.map(month => month.count));
const yearCount = months.reduce((sum, month) => sum + month.count, 0);
const latest = publishedPosts[0];
const pad = (n: number) => String(n).padStart(2, '0');
const shortDate = (date: Date) => `${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())}`;
const issueCode = `${now.getFullYear()}.${pad(now.getMonth() + 1)}`;
---
<BaseLayout>
 <script is:inline>
  try {
   if (sessionStorage.getItem('welcomed')) document.documentElement.dataset.welcomed = '';
   else sessionStorage.setItem('welcomed', '1');
  } catch {}
 </script>

 <div class="home-page" data-pagefind-ignore>
  <!-- Row 1: Hero Bento (Left 1.85fr Intro + Right 1fr Status Card) -->
  <section class="page-shell bento-hero reveal" style="--d:0" aria-label="站点导言与近况">
   <div class="porcelain-card hero-main">
    <div class="hero-top">
     <div class="hero-kicker-row">
      <span class="eyebrow">KREIITOR · AI4SE &amp; PERSONAL ARCHIVE</span>
      <span class="hero-issue">{siteConfig.location.split('，')[0]} · {issueCode}</span>
     </div>
     <h1 class="hero-title">
      把读过的、试过的与生活里的光，<br />安静地收在同一处<span class="hero-seal" aria-hidden="true">。</span>
     </h1>
     <p class="hero-bio">
      我是 <strong>{siteConfig.author}</strong>，{siteConfig.role}。白天在论文、程序分析与实验复现里整理秩序，晚上也留给做饭、两只小猫和旅途里的照片。
     </p>
    </div>

    <div class="hero-foot">
     <div class="hero-actions">
      <a href={withBase('/notes/')} class="zen-btn zen-btn-primary">翻阅长卷 <Icon name="arrow" size={15}/></a>
      <a href={withBase('/blog/')} class="zen-btn zen-btn-secondary">全部札记</a>
      <ul class="socials" aria-label="联系与订阅">
       <li><a href={siteConfig.socialLinks[0].href} target="_blank" rel="noreferrer" aria-label="GitHub"><Icon name="github" size={17}/></a></li>
       <li><a href={`mailto:${siteConfig.email}`} aria-label="Email"><Icon name="mail" size={17}/></a></li>
       <li><a href={withBase('/rss.xml')} aria-label="RSS 订阅"><Icon name="rss" size={17}/></a></li>
      </ul>
     </div>
     <p class="hero-stats">
      <span>{String(series.length).padStart(2, '0')} 卷</span>
      <i aria-hidden="true">·</i>
      <span>{publishedPosts.length} 篇</span>
      <i aria-hidden="true">·</i>
      <span>约 {wordsTenK} 万字</span>
     </p>
    </div>
   </div>

   <aside class="porcelain-card now-card">
    <div class="now-head">
     <h2>近况 · 武汉</h2>
     <span class="now-status"><i aria-hidden="true"></i>记录中</span>
    </div>
    <div class="now-list">
     {siteConfig.nowItems.map(item => (
      item.href ? (
       <a href={withBase(item.href)} class:list={['now-item', { 'is-life': item.tone === 'life' }]}>
        <span class="now-label">{item.label}</span>
        <span class="now-text">{item.text}</span>
       </a>
      ) : (
       <div class:list={['now-item', { 'is-life': item.tone === 'life' }]}>
        <span class="now-label">{item.label}</span>
        <span class="now-text">{item.text}</span>
       </div>
      )
     ))}
    </div>
    <div class="now-foot">
     <span>「{siteConfig.tagline}」</span>
     <a href={withBase('/about/')} class="now-link">关于我 →</a>
    </div>
   </aside>
  </section>

  <!-- Row 2: Research Tabular Notes + Life Gallery & Jotting -->
  <section class="page-shell bento-mid reveal" style="--d:1" id="recent">
   <div class="porcelain-card notes-panel">
    <header class="panel-head">
     <div>
      <p class="eyebrow">01 / FIELD NOTES</p>
      <h2>{sections.knowledge.label}</h2>
     </div>
     <div class="home-tag-filters" role="group" aria-label="按标签筛选近期札记" data-home-filters>
      <button type="button" data-home-tag="all" aria-pressed="true">全部</button>
      {topKnowledgeTags.map(tag => (
       <button type="button" data-home-tag={tag} aria-pressed="false">{tag}</button>
      ))}
     </div>
    </header>

    <ol class="feed" data-home-feed>
     {homeNotePool.map((post, idx) => (
      <li class="feed-item" data-home-note data-tags={post.data.tags.join('|')} hidden={idx >= 6}>
       <a href={withBase(`/blog/${post.id}/`)}>
        <time class="feed-time" datetime={post.data.pubDate.toISOString()} title={formatDate(post.data.pubDate)}>{shortDate(post.data.pubDate)}</time>
        <span class="feed-title">{post.data.title}</span>
        <span class="feed-tag">{post.data.tags[0]}</span>
        <span class="feed-read">{getReadingTime(post)} min</span>
       </a>
      </li>
     ))}
    </ol>

    <div class="panel-foot">
     <span class="panel-meta">零散的知识与工程记录 · 共 {allArticles.length} 篇</span>
     <a class="more" href={withBase(sections.knowledge.href)}>全部札记 <Icon name="arrow" size={15}/></a>
    </div>
   </div>

   <div class="porcelain-card life-panel">
    <header class="panel-head">
     <div>
      <p class="eyebrow life-eyebrow">02 / LIFE &amp; FRAMES</p>
      <h2>{sections.writing.label}</h2>
     </div>
     <a href={withBase('/gallery/')} class="panel-link">全部 {photos.length} 张 →</a>
    </header>

    <div class="life-gallery">
     {homePhotos.map((p, idx) => (
      <a href={withBase(`/gallery/#photo-${idx + 1}`)} class="life-photo-tile" aria-label={`查看照片：${p.title}`}>
       <picture>
        <source type="image/avif" srcset={withBase(`/gallery/optimized/${stem(p.file)}-480.avif`)} />
        <source type="image/webp" srcset={withBase(`/gallery/optimized/${stem(p.file)}-480.webp`)} />
        <img src={withBase(`/gallery/${p.file}`)} alt={p.title} width={p.width} height={p.height} loading="lazy" decoding="async" />
       </picture>
       <span class="life-photo-cap">
        <span class="life-photo-title">{p.title}</span>
        <span class="life-photo-no">0{idx + 1}</span>
       </span>
      </a>
     ))}
    </div>

    {latestJotting ? (
     <a href={withBase(`/blog/${latestJotting.id}/`)} class="life-essay-card">
      <div class="life-essay-meta">
       <span>{sections.writing.label}</span>
       <time datetime={latestJotting.data.pubDate.toISOString()}>{formatDate(latestJotting.data.pubDate)}</time>
      </div>
      <h3>{latestJotting.data.title}</h3>
      <p>{latestJotting.data.description}</p>
     </a>
    ) : (
     <div class="life-essay-card is-empty"><p>还没有写下闲笔。</p></div>
    )}

    <div class="panel-foot">
     <span class="panel-meta">生活片刻与随手拍</span>
     <a class="more" href={withBase(sections.writing.href)}>全部闲笔 <Icon name="arrow" size={15}/></a>
    </div>
   </div>
  </section>

  <!-- Row 3: 03 / 长卷 · Three Monograph Volumes -->
  <section class="page-shell monographs-section reveal" style="--d:2" aria-labelledby="home-series">
   <header class="shelf-head">
    <div>
     <p class="eyebrow">03 / MONOGRAPHS</p>
     <h2 id="home-series">{sections.course.label}</h2>
    </div>
    <a class="more" href={withBase(sections.course.href)}>全部 {series.length} 卷 <Icon name="arrow" size={15}/></a>
   </header>

   <div class="monographs-grid">
    {series.map((item, idx) => (
     <a href={withBase(`/notes/${item.entry.id}/`)} class="porcelain-card monograph-card">
      <div class="monograph-top">
       <span class="monograph-vol">VOL.{String(idx + 1).padStart(2, '0')}</span>
       <span class="monograph-count">{item.chapters.length} 篇</span>
      </div>
      <h3>{item.entry.data.title}</h3>
      {item.entry.data.englishTitle && <p class="monograph-en">{item.entry.data.englishTitle}</p>}
      <p class="monograph-desc">{item.entry.data.description}</p>
      <span class="monograph-foot">按章节阅读 <Icon name="arrow" size={14}/></span>
     </a>
    ))}
   </div>
  </section>

  <!-- Row 4: 04 / 研究项目 -->
  {projects.length > 0 && (
   <section class="page-shell projects-section reveal" style="--d:3" aria-labelledby="home-projects">
    <header class="shelf-head">
     <div>
      <p class="eyebrow">04 / PROJECTS</p>
      <h2 id="home-projects">研究项目</h2>
     </div>
     <a class="more" href={withBase('/projects/')}>全部项目 <Icon name="arrow" size={15}/></a>
    </header>
    <div class="home-projects-grid">
     {projects.slice(0, 2).map((project, idx) => (
      <a href={withBase(`/projects/${project.id}/`)} class="porcelain-card home-project-card">
       <div class="monograph-top">
        <span class="monograph-vol">PRJ.{String(idx + 1).padStart(2, '0')}</span>
        <span class:list={['home-project-status', { 'is-done': project.data.status === '已完成' }]}>{project.data.status}</span>
       </div>
       <h3>{project.data.title}</h3>
       <p class="monograph-desc">{project.data.summary}</p>
       <div class="home-project-tags">
        {project.data.tags.slice(0, 3).map(tag => <span>{tag}</span>)}
       </div>
      </a>
     ))}
    </div>
   </section>
  )}

  <!-- Row 5: Minimalist 12-Month Rhythm + Correspondence -->
  <section class="page-shell bento-foot reveal" style="--d:4">
   <div class="porcelain-card timeline-panel" data-timeline>
    <header class="panel-head">
     <div>
      <p class="eyebrow">05 / WRITING RHYTHM</p>
      <h2>近一年记录</h2>
     </div>
     <span class="panel-meta">{yearCount} 篇 / 12 个月</span>
    </header>
    <ol class="months">
     {months.map((month, index) => (
      <li style={`--s:${month.count ? (.16 + Math.sqrt(month.count / peak) * .84).toFixed(3) : 0};--i:${index}`} class:list={{ 'is-empty': !month.count, 'is-now': index === months.length - 1 }}>
       <a href={`${withBase('/archive/')}${month.anchor}`} aria-label={`${month.year} 年 ${month.label}：${month.count} 篇`}>
        <span class="bar" aria-hidden="true"><span class="count">{month.count || ''}</span></span>
        <span class="month" aria-hidden="true">{month.label}</span>
        {month.count > 0 && <span class="tip" aria-hidden="true">{month.count} 篇{month.latest && ` · ${month.latest.data.title}`}</span>}
       </a>
      </li>
     ))}
    </ol>
    <div class="panel-foot timeline-foot">
     {latest && <p class="latest">近作 · <a href={withBase(`/blog/${latest.id}/`)}>{latest.data.title}</a></p>}
     <a class="more" href={withBase('/archive/')}>完整时间线 <Icon name="arrow" size={14}/></a>
    </div>
   </div>

   <div class="porcelain-card outro-panel">
    <div>
     <p class="eyebrow">06 / CORRESPONDENCE</p>
     <h2 class="outro-greet">你好，欢迎来信。</h2>
     <p class="outro-desc">如果某篇笔记或做法碰巧对你有用，随时写信聊聊。</p>
    </div>

    <div class="outro-actions">
     <a href={`mailto:${siteConfig.email}`} class="outro-action">
      <span class="outro-action-label">写一封信</span>
      <span class="outro-action-val">{siteConfig.email}</span>
     </a>
     <a href={withBase('/rss.xml')} class="outro-action">
      <span class="outro-action-label">RSS 订阅</span>
      <span class="outro-action-val">不错过新文章</span>
     </a>
    </div>

    <nav class="topic-row" aria-label="常见话题">
     {tags.slice(0, 5).map(item => <a href={withBase(`/tags/${encodeURIComponent(item.tag)}/`)}>{item.tag}</a>)}
     <a href={withBase('/projects/')} class="topic-projects">研究项目</a>
    </nav>
   </div>
  </section>
 </div>
</BaseLayout>

<script>
 const filterGroup = document.querySelector<HTMLElement>('[data-home-filters]');
 const noteItems = Array.from(document.querySelectorAll<HTMLLIElement>('[data-home-note]'));
 if (filterGroup && noteItems.length) {
  const buttons = Array.from(filterGroup.querySelectorAll<HTMLButtonElement>('[data-home-tag]'));
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const applyFilter = (tag: string, animate = false) => {
   let shown = 0;
   const revealed: HTMLLIElement[] = [];
   for (const item of noteItems) {
    const match = tag === 'all' || (item.dataset.tags ?? '').split('|').includes(tag);
    if (match && shown < 6) {
     if (item.hidden) revealed.push(item);
     item.hidden = false;
     shown += 1;
    } else {
     item.hidden = true;
    }
   }
   for (const btn of buttons) {
    btn.setAttribute('aria-pressed', String(btn.dataset.homeTag === tag));
   }
   if (animate && !reducedMotion.matches) {
    revealed.forEach((item, index) => {
     item.animate(
      [{ opacity: 0, translate: '0 6px' }, { opacity: 1, translate: '0 0' }],
      { duration: 240, delay: index * 24, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' },
     );
    });
   }
  };
  filterGroup.addEventListener('click', event => {
   const target = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-home-tag]');
   if (!target) return;
   applyFilter(target.dataset.homeTag ?? 'all', true);
  });
 }
</script>

<style>
 .home-page { padding-top: 28px; overflow-x: clip; }
 .porcelain-card {
  background: var(--color-surface);
  border: 1px solid var(--color-line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
  transition: border-color var(--dur-base) var(--ease-smooth), box-shadow var(--dur-slow) var(--ease-out-expo), translate var(--dur-slow) var(--ease-out-expo);
 }

 /* ---------- Row 1: Hero Bento ---------- */
 .bento-hero { display: grid; grid-template-columns: minmax(0, 1.85fr) minmax(0, 1fr); gap: 18px; align-items: stretch; }
 .hero-main { padding: 34px 36px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
 .hero-kicker-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; }
 .hero-issue { color: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12px; font-variant-numeric: tabular-nums; }
 .hero-title { margin-top: 16px; font-size: clamp(26px, 1.35rem + 1.3vw, 36px); line-height: 1.3; letter-spacing: -.015em; text-wrap: balance; }
 .hero-seal { color: var(--color-vermilion); }
 .hero-bio { margin-top: 14px; max-width: 56ch; color: var(--color-ink-soft); font-size: 15px; line-height: 1.82; }
 .hero-bio strong { color: var(--color-ink); font-weight: 600; }
 .hero-foot { padding-top: 18px; border-top: 1px solid var(--color-line); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 20px; }
 .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
 .socials { display: inline-flex; align-items: center; gap: 6px; margin: 0; padding: 0; list-style: none; }
 .socials a { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--color-line-strong); border-radius: 50%; background: var(--color-surface); color: var(--color-ink-soft); transition: color var(--dur-base), border-color var(--dur-base), background-color var(--dur-base); }
 .socials a:is(:hover,:focus-visible) { color: var(--color-accent-strong); border-color: var(--color-accent); background: var(--color-accent-soft); }
 .hero-stats { display: inline-flex; align-items: center; gap: 8px; color: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12.5px; font-variant-numeric: tabular-nums; }
 .hero-stats i { font-style: normal; color: var(--color-line-strong); }

 /* Status Card (近况 · 武汉) */
 .now-card { padding: 26px 26px 22px; display: flex; flex-direction: column; justify-content: space-between; gap: 16px; }
 .now-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
 .now-head h2 { font-size: 19px; line-height: 1.3; }
 .now-status { display: inline-flex; align-items: center; gap: 6px; color: var(--color-accent-strong); font-family: var(--font-mono); font-size: 12px; font-weight: 600; }
 .now-status i { width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); }
 .now-list { display: flex; flex-direction: column; gap: 10px; }
 .now-item { display: flex; flex-direction: column; gap: 3px; padding: 11px 14px; border-radius: var(--radius-inner); background: var(--color-surface-soft); border: 1px solid transparent; transition: border-color var(--dur-base), background-color var(--dur-base); }
 .now-item.is-life { background: var(--color-warm-soft); }
 a.now-item:is(:hover,:focus-visible) { border-color: var(--color-line-strong); }
 .now-label { color: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12px; }
 .now-item.is-life .now-label { color: var(--color-warm); font-weight: 600; }
 .now-text { color: var(--color-ink); font-size: 13.5px; font-weight: 600; line-height: 1.5; }
 .now-foot { padding-top: 12px; border-top: 1px solid var(--color-line); display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 12.5px; color: var(--color-ink-muted); }
 .now-link { color: var(--color-accent-strong); font-weight: 600; white-space: nowrap; }
 .now-link:hover { color: var(--color-accent); }

 /* ---------- Shared Bento Panel Chrome ---------- */
 .panel-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid var(--color-line); }
 .panel-head h2 { margin-top: 2px; font-size: 21px; line-height: 1.25; }
 .panel-meta { color: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12px; font-variant-numeric: tabular-nums; }
 .panel-link { color: var(--color-accent-strong); font-size: 13px; font-weight: 600; white-space: nowrap; }
 .panel-link:hover { color: var(--color-accent); }
 .panel-foot { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--color-line); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
 .more { display: inline-flex; align-items: center; gap: 6px; min-height: 38px; color: var(--color-accent-strong); font-size: 13px; font-weight: 600; }
 .more:is(:hover,:focus-visible) { color: var(--color-accent); }
 .more :global(svg) { transition: translate var(--dur-base) var(--ease-out-expo); }
 @media (hover: hover) { .more:hover :global(svg) { translate: 3px 0; } }

 /* ---------- Row 2: Notes Table + Life Gallery ---------- */
 .bento-mid { display: grid; grid-template-columns: minmax(0, 1.38fr) minmax(0, 1fr); gap: 18px; margin-top: 20px; align-items: stretch; }
 .notes-panel,.life-panel { padding: 26px 28px 22px; display: flex; flex-direction: column; }
 .home-tag-filters { display: flex; flex-wrap: wrap; gap: 6px; }
 .home-tag-filters button { min-height: 30px; padding: 2px 11px; border: 1px solid var(--color-line); border-radius: 999px; background: transparent; color: var(--color-ink-muted); font-size: 12px; font-weight: 500; transition: background-color var(--dur-base), border-color var(--dur-base), color var(--dur-base); }
 .home-tag-filters button:hover { color: var(--color-ink); border-color: var(--color-line-strong); }
 .home-tag-filters button[aria-pressed="true"] { border-color: var(--color-accent); background: var(--color-accent-soft); color: var(--color-accent-strong); font-weight: 600; }

 .feed { margin: 4px 0 12px; padding: 0; list-style: none; flex: 1; }
 .feed-item + .feed-item:not([hidden]) { border-top: 1px solid var(--color-line); }
