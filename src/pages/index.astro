---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TagLink from '../components/TagLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
import {
	getFeaturedPosts,
	getFeaturedProjects,
	getLatestUpdates,
	getPublishedPosts,
	getProjects,
	getTagSummaries,
} from '../utils/content';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';

const posts = await getCollection('posts');
const projects = await getCollection('projects');
const publishedPosts = getPublishedPosts(posts);
const sortedProjects = getProjects(projects);
const featuredPosts = getFeaturedPosts(posts, 3);
const featuredProjects = getFeaturedProjects(projects, 2);
const latestUpdates = getLatestUpdates(posts, projects, 5);
const tags = getTagSummaries(posts, projects).slice(0, 8);
---

<BaseLayout>
	<div data-pagefind-ignore>

		<!-- ═══ Hero — 空 ═══ -->
		<section class="page-shell pt-20 sm:pt-28" data-zen-reveal>
			<div class="max-w-2xl space-y-8">
				<p class="zen-kicker zen-reveal">{siteConfig.hero.kicker}</p>

				<h1 class="font-display text-3xl font-semibold leading-tight tracking-tight text-[color:var(--color-ink)] sm:text-4xl lg:text-5xl zen-reveal zen-delay-1">
					{siteConfig.hero.title}
				</h1>

				<p class="text-base leading-8 text-[color:var(--color-ink-soft)] sm:text-lg zen-reveal zen-delay-2">
					{siteConfig.hero.description}
				</p>

				<div class="flex flex-wrap items-center gap-3 zen-reveal zen-delay-3">
					<a href={withBase('/blog/')} class="zen-btn zen-btn-primary">
						进入博客
					</a>
					<a href={withBase('/projects/')} class="zen-btn zen-btn-secondary">
						查看项目
					</a>
					<a href={withBase('/about/')} class="zen-btn zen-btn-ghost">
						关于我
					</a>
				</div>
			</div>

			<!-- Research highlights — subtle chips -->
			<div class="mt-12 flex flex-wrap gap-2 zen-reveal zen-delay-4">
				{siteConfig.hero.highlights.map((highlight) => (
					<span class="rounded-full border border-[color:var(--color-line)] bg-[color:var(--color-surface)] px-3.5 py-1.5 text-xs font-medium text-[color:var(--color-ink-soft)]">
						{highlight}
					</span>
				))}
			</div>
		</section>

		<!-- ═══ Stats — 静 ═══ -->
		<section class="page-shell mt-20" data-zen-reveal>
			<div class="grid grid-cols-3 gap-6">
				<div class="text-center">
					<p class="font-display text-3xl font-semibold text-[color:var(--color-ink)] sm:text-4xl">{publishedPosts.length}</p>
					<p class="mt-2 text-xs font-medium tracking-wide text-[color:var(--color-ink-muted)]">篇文章</p>
				</div>
				<div class="text-center">
					<p class="font-display text-3xl font-semibold text-[color:var(--color-ink)] sm:text-4xl">{sortedProjects.length}</p>
					<p class="mt-2 text-xs font-medium tracking-wide text-[color:var(--color-ink-muted)]">个项目</p>
				</div>
				<div class="text-center">
					<p class="font-display text-xl font-semibold text-[color:var(--color-ink)] sm:text-2xl">{tags.length}</p>
					<p class="mt-2 text-xs font-medium tracking-wide text-[color:var(--color-ink-muted)]">个标签</p>
				</div>
			</div>
		</section>

		<!-- Divider -->
		<div class="page-shell mt-20">
			<div class="zen-divider"></div>
		</div>

		<!-- ═══ Featured Posts ═══ -->
		<section class="page-shell mt-20 space-y-10" data-zen-reveal>
			<SectionHeading
				kicker="文章"
				title="近期写作"
				description="论文阅读笔记、实验日志与方法思考。"
				linkHref={withBase('/blog/')}
				linkLabel="查看全部"
			/>
			<div class="section-grid">
				{featuredPosts.map((post) => (
					<PostCard post={post} />
				))}
			</div>
		</section>

		<!-- ═══ Featured Projects ═══ -->
		<section class="page-shell mt-24 space-y-10" data-zen-reveal>
			<SectionHeading
				kicker="项目"
				title="研究项目"
				description="论文复现、实验平台与工具型项目。"
				linkHref={withBase('/projects/')}
				linkLabel="浏览项目"
			/>
			<div class="section-grid">
				{featuredProjects.map((project) => (
					<ProjectCard project={project} />
				))}
			</div>
		</section>

		<!-- Divider -->
		<div class="page-shell mt-24">
			<div class="zen-divider"></div>
		</div>

		<!-- ═══ Tags + Timeline ═══ -->
		<section class="page-shell mt-20 grid gap-12 lg:grid-cols-2" data-zen-reveal>
			<!-- Tags -->
			<div class="space-y-6">
				<p class="zen-kicker">标签</p>
				<h2 class="font-display text-xl font-semibold text-[color:var(--color-ink)]">探索话题</h2>
				<div class="flex flex-wrap gap-2">
					{tags.map((item) => (
						<a href={withBase(`/tags/${encodeURIComponent(item.tag)}/`)} class="zen-tag">
							{item.tag}
							<span class="text-[color:var(--color-ink-muted)]">{item.count}</span>
						</a>
					))}
				</div>
			</div>

			<!-- Timeline -->
			<div class="space-y-6">
				<p class="zen-kicker">动态</p>
				<h2 class="font-display text-xl font-semibold text-[color:var(--color-ink)]">最近更新</h2>
				<div class="space-y-4">
					{latestUpdates.slice(0, 4).map((item) => (
						<a href={withBase(item.href)} class="group block rounded-xl border border-[color:var(--color-line)] bg-[color:var(--color-surface)] p-4 transition hover:border-[color:var(--color-line-strong)] hover:shadow-[var(--shadow-whisper)]">
							<div class="flex items-center gap-2 text-xs text-[color:var(--color-ink-muted)]">
								<span>{item.type === 'post' ? '文章' : '项目'}</span>
								<span class="h-0.5 w-0.5 rounded-full bg-[color:var(--color-ink-muted)]"></span>
								<span>{formatDate(item.pubDate)}</span>
							</div>
							<p class="mt-2 text-sm font-medium text-[color:var(--color-ink)] transition group-hover:text-[color:var(--color-accent-strong)]">
								{item.title}
							</p>
						</a>
					))}
				</div>
			</div>
		</section>
	</div>
</BaseLayout>
