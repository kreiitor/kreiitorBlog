---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../data/site';
import { getFeaturedPosts, getFeaturedProjects, getProjects, getPublishedPosts, getReadingTime, getTagSummaries } from '../utils/content';
import { getLearningSeries } from '../utils/series';
import { formatDate } from '../utils/date';
import { withBase } from '../utils/url';

const posts = await getCollection('posts');
const projects = await getCollection('projects');
const publishedPosts = getPublishedPosts(posts);
const curated = siteConfig.homeFeaturedPosts.flatMap(selection => {
 const post = publishedPosts.find(item => item.id === selection.id);
 return post ? [{ post, label: selection.label }] : [];
});
const featuredPosts = [...curated.map(item => item.post), ...getFeaturedPosts(posts).filter(post => !curated.some(item => item.post.id === post.id))].slice(0, 3);
const featuredIds = new Set(featuredPosts.map(post => post.id));
const recentPosts = publishedPosts.filter(post => !featuredIds.has(post.id)).slice(0, 5);
const series = getLearningSeries(await getCollection('series'), posts);
const featuredProjects = getFeaturedProjects(projects, 2);
const allTags = getTagSummaries(posts, projects);
const tags = allTags.slice(0, 8);
const ribbon = allTags.slice(0, 14);
const stats = [
 { href: '/blog/', label: '文章', value: publishedPosts.length },
 { href: '/notes/', label: '学习专题', value: series.length },
 { href: '/projects/', label: '研究项目', value: getProjects(projects).length },
];
const title = [...'研究札记'];
---
<BaseLayout>
 <div class="home-page" data-pagefind-ignore>
  <section class="home-hero dark-island" data-home-hero>
   <canvas class="hero-threads" data-hero-threads aria-hidden="true"></canvas>
   <div class="page-shell hero-inner">
    <div class="hero-copy">
     <p class="intro-label"><span class="live-dot" aria-hidden="true"></span>kreiitor 的个人网站 · 持续更新</p>
     <h1 class="hero-title" aria-label="研究札记">{title.map((char, index) => <span aria-hidden="true" style={`--i:${index}`}>{char}</span>)}<span class="seal" aria-hidden="true"></span></h1>
     <p class="hero-motto">研究、学习、动手做。</p>
     <p class="intro-copy">关于 AI、软件工程和学习过程中的问题与发现。把读过的论文、做过的实验和走过的弯路，整理成可以再次使用的知识。</p>
     <div class="intro-actions">
      <a class="big-link" href={withBase('/blog/')}>开始阅读 <Icon name="arrow" size={18}/></a>
      <a class="about-link" href={withBase('/about/')}>关于我 <Icon name="arrow" size={16}/></a>
     </div>
    </div>
    <nav class="intro-index" aria-label="站点内容">
     {stats.map((item, index) => <a href={withBase(item.href)} style={`--i:${index}`}><strong data-count={item.value}>{item.value}</strong><span>{item.label}</span><Icon name="arrow" size={18}/></a>)}
    </nav>
   </div>
   <div class="hero-ribbon" aria-label="常见话题">
    <div class="ribbon-track">
     {[0, 1].map(copy => <ul class="ribbon-list" aria-hidden={copy === 1 ? 'true' : undefined} inert={copy === 1}>{ribbon.map(item => <li><a href={withBase(`/tags/${encodeURIComponent(item.tag)}/`)}>{item.tag}</a></li>)}</ul>)}
    </div>
   </div>
  </section>

  <section class="page-shell home-section writing-section" aria-labelledby="featured-heading">
   <div class="section-bar"><div><p>从这里开始</p><h2 id="featured-heading">精选文章</h2></div><a href={withBase('/blog/')}>所有文章 <Icon name="arrow" size={16}/></a></div>
   <div class="selected-writing">
    {featuredPosts[0] && <PostCard post={featuredPosts[0]} featured featuredLabel={curated[0]?.label}/>}
    <div class="selected-rows">
     {featuredPosts.slice(1).map((post, index) => <a href={withBase(`/blog/${post.id}/`)} class="selected-row" data-spotlight>
      <span class="selected-number" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>
      <span class="selection-label">{curated[index + 1]?.label ?? '精选文章'}</span>
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
      <span class="selected-meta"><span>{formatDate(post.data.pubDate)} · {getReadingTime(post)} 分钟</span><span class="selected-arrow"><Icon name="arrow" size={18}/></span></span>
     </a>)}
    </div>
   </div>
  </section>

  <section class="learning-band">
   <div class="page-shell">
    <div class="section-bar learning-heading"><div><p>一条线，一步步学</p><h2>学习专题</h2></div><a href={withBase('/notes/')}>全部专题 <Icon name="arrow" size={16}/></a></div>
    <div class="series-grid home-series">{series.slice(0, 3).map(item => <SeriesCard series={item}/>)}</div>
   </div>
  </section>

  <section class="page-shell home-section projects-section">
   <div class="section-bar"><div><p>从想法到实践</p><h2>项目与实验</h2></div><a href={withBase('/projects/')}>所有项目 <Icon name="arrow" size={16}/></a></div>
   <div class="project-grid">{featuredProjects.map(project => <ProjectCard project={project} showcase/>)}</div>
  </section>

  <section class="page-shell home-section discovery">
   <div class="recent">
    <div class="section-bar"><div><p>持续更新</p><h2>最近写下</h2></div><a href={withBase('/archive/')}>时间归档 <Icon name="arrow" size={16}/></a></div>
    <ol class="recent-list">{recentPosts.map(post => <li><a href={withBase(`/blog/${post.id}/`)} class="recent-row"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><h3>{post.data.title}</h3><Icon name="arrow" size={18}/></a></li>)}</ol>
   </div>
   <aside class="topics dark-island">
    <p>按话题探索</p>
    <h2>今天想读什么？</h2>
    <div class="topic-list">{tags.map(item => <a href={withBase(`/tags/${encodeURIComponent(item.tag)}/`)}>{item.tag}<span>{item.count}</span></a>)}</div>
    <a class="topic-all" href={withBase('/tags/')}>所有话题 <Icon name="arrow" size={16}/></a>
   </aside>
  </section>
 </div>
</BaseLayout>
<script>
 import { mountThreads } from '../utils/threads';
 const reduced = matchMedia('(prefers-reduced-motion: reduce)');
 const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-threads]');
 if (canvas) mountThreads(canvas, reduced);

 // 数字从零走到实际值；减少动态效果时保持服务端渲染的最终值。
 if (!reduced.matches) {
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((node, index) => {
   const target = Number(node.dataset.count);
   if (!Number.isFinite(target) || target <= 0) return;
   const start = performance.now() + 450 + index * 120;
   const duration = 1100;
   node.textContent = '0';
   const step = (now: number) => {
    const t = Math.min(1, Math.max(0, (now - start) / duration));
    node.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 4))));
    if (t < 1) requestAnimationFrame(step);
   };
   requestAnimationFrame(step);
  });
 }
</script>
<style>
 .home-hero { position: relative; isolation: isolate; overflow: hidden; margin-top: calc(-1 * var(--header-height)); padding-top: var(--header-height); background-color: var(--hero-bg); background-image: radial-gradient(900px 520px at 78% 38%,var(--hero-glow),transparent 70%),radial-gradient(700px 420px at 8% 110%,rgb(61 106 90 / .28),transparent 70%); }
 .home-hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background-image: radial-gradient(rgb(236 230 218 / .07) 1px,transparent 1.4px); background-size: 26px 26px; -webkit-mask-image: radial-gradient(ellipse at 70% 40%,#000 10%,transparent 70%); mask-image: radial-gradient(ellipse at 70% 40%,#000 10%,transparent 70%); pointer-events: none; }
 .hero-threads { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; }
 .hero-inner { display: grid; grid-template-columns: minmax(0,1fr) 260px; gap: 64px; align-items: end; padding-block: 60px 44px; }
 .hero-copy { animation: rise var(--dur-slower) var(--ease-out-expo) both; }
 .intro-label { display: inline-flex; align-items: center; gap: 10px; padding: 6px 14px 6px 12px; border: 1px solid var(--color-line-strong); border-radius: 999px; background: rgb(18 21 28 / .5); color: var(--color-ink-soft); font-size: 13px; backdrop-filter: blur(6px); }
 .live-dot { position: relative; width: 7px; height: 7px; border-radius: 50%; background: var(--color-sage); }
 .live-dot::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid var(--color-sage); animation: pulse 2.4s var(--ease-smooth) infinite; }
 .hero-title { margin-top: 26px; font-family: var(--font-display); font-size: clamp(54px,min(17vw,4rem + 5vw),136px); white-space: nowrap; font-weight: 600; line-height: 1; letter-spacing: .02em; color: var(--color-ink); }
 .hero-title > span[style] { display: inline-block; animation: rise 1s var(--ease-out-expo) both; animation-delay: calc(120ms + var(--i) * 90ms); }
 .hero-title .seal { width: .16em; height: .16em; margin-left: .1em; vertical-align: .06em; animation: stamp .7s var(--ease-out-expo) .6s both; }
 .hero-motto { margin-top: 22px; color: var(--color-counterpoint); font-family: var(--font-kai); font-size: clamp(22px,1.2rem + .8vw,30px); letter-spacing: .12em; }
 .intro-copy { max-width: 34em; margin-top: 18px; color: var(--color-ink-soft); font-size: 16px; line-height: 1.85; }
 .intro-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 26px; margin-top: 34px; }
 .big-link { display: inline-flex; align-items: center; gap: 14px; min-height: 52px; padding: 12px 26px; border-radius: 999px; background: var(--color-accent); color: var(--color-on-primary); font-size: 15px; font-weight: 600; box-shadow: 0 14px 40px -12px rgb(242 137 107 / .55); transition: transform var(--dur-base) var(--ease-out-expo),box-shadow var(--dur-base),background-color var(--dur-base); }
 .big-link:hover { background: var(--color-accent-strong); transform: translateY(-2px); box-shadow: 0 20px 44px -12px rgb(242 137 107 / .65); }
 .big-link:active { transform: scale(.97); }
 .big-link :global(svg),.about-link :global(svg) { transition: transform var(--dur-base) var(--ease-out-expo); }
 .big-link:hover :global(svg),.about-link:hover :global(svg) { transform: translateX(4px); }
 .about-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--color-ink); font-size: 14px; font-weight: 600; }
 .about-link:hover { color: var(--color-accent-strong); }
 .intro-index { display: grid; border-top: 1px solid var(--color-line-strong); }
 .intro-index a { display: grid; grid-template-columns: auto 1fr 18px; align-items: baseline; gap: 14px; padding: 18px 0 16px; border-bottom: 1px solid var(--color-line-strong); color: var(--color-ink); animation: rise .9s var(--ease-out-expo) both; animation-delay: calc(500ms + var(--i) * 110ms); }
 .intro-index strong { min-width: 2.2ch; font-family: var(--font-display); font-size: 40px; font-weight: 500; line-height: 1; font-variant-numeric: tabular-nums; }
 .intro-index span { color: var(--color-ink-soft); font-size: 14px; }
 .intro-index :global(svg) { align-self: center; color: var(--color-ink-muted); transition: transform var(--dur-base) var(--ease-out-expo),color var(--dur-base); }
 .intro-index a:hover span,.intro-index a:hover :global(svg) { color: var(--color-accent-strong); }
 .intro-index a:hover :global(svg) { transform: translateX(4px); }
 .hero-ribbon { position: relative; overflow: hidden; border-top: 1px solid var(--color-line); -webkit-mask-image: linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent); mask-image: linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent); }
 .ribbon-track { display: flex; width: max-content; animation: ribbon 60s linear infinite; }
 .hero-ribbon:hover .ribbon-track,.hero-ribbon:focus-within .ribbon-track { animation-play-state: paused; }
 .ribbon-list { display: flex; flex-shrink: 0; }
 .ribbon-list a { display: inline-flex; align-items: center; gap: 28px; min-height: 52px; padding-right: 28px; color: var(--color-ink-muted); font-family: var(--font-display); font-size: 17px; white-space: nowrap; }
 .ribbon-list a::after { content: ''; width: 5px; height: 5px; border-radius: 1px; background: var(--color-accent); opacity: .7; rotate: 45deg; }
 .ribbon-list a:hover { color: var(--color-ink); }

 .home-section { margin-top: 88px; }
 .section-bar { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
 .section-bar p { margin-bottom: 8px; color: var(--color-sage); font-size: 12.5px; font-weight: 600; letter-spacing: .08em; }
 .section-bar h2 { font-size: clamp(30px,1.4rem + 1.2vw,42px); line-height: 1.2; letter-spacing: -.01em; }
 .section-bar h2::after { content: ''; display: inline-block; width: .2em; height: .2em; margin-left: .12em; border-radius: 2px; background: var(--color-accent); vertical-align: .05em; }
 .section-bar > a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border: 1px solid var(--color-line-strong); border-radius: 999px; color: var(--color-ink); font-size: 13px; font-weight: 600; transition: background-color var(--dur-base),color var(--dur-base),border-color var(--dur-base); }
 .section-bar > a:hover { border-color: var(--color-primary); background: var(--color-primary); color: var(--color-on-primary); }

 .writing-section { margin-top: 56px; }
 .selected-writing { display: grid; grid-template-columns: minmax(0,1.3fr) minmax(0,1fr); gap: 24px; }
 .selected-writing :global(.post-featured .card-content) { padding: 26px 30px 30px; }
 .selected-writing :global(.post-featured h3) { font-size: 27px; line-height: 1.35; }
 .selected-rows { display: grid; grid-template-rows: repeat(2,minmax(0,1fr)); gap: 24px; }
 .selected-row { position: relative; isolation: isolate; display: flex; flex-direction: column; min-width: 0; overflow: hidden; padding: 28px 30px 26px; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); transition: translate var(--dur-slow) var(--ease-out-expo),box-shadow var(--dur-slow) var(--ease-out-expo),border-color var(--dur-base); }
 .selected-row::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(380px circle at var(--mx,80%) var(--my,0%),var(--spot),transparent 65%); opacity: 0; transition: opacity var(--dur-slow); }
 .selected-number { position: absolute; right: 22px; top: 6px; z-index: -1; color: transparent; font-family: var(--font-display); font-size: 92px; font-weight: 600; line-height: 1; -webkit-text-stroke: 1px var(--color-line-strong); opacity: .55; transition: -webkit-text-stroke-color var(--dur-base),translate var(--dur-slow) var(--ease-out-expo); }
 .selection-label { color: var(--color-sage); font-size: 12.5px; font-weight: 600; letter-spacing: .06em; }
 .selected-row h3 { max-width: 18em; padding-right: 56px; margin-top: 14px; font-size: 23px; line-height: 1.4; }
 .selected-row p { margin-top: 10px; color: var(--color-ink-soft); font-size: 14px; line-height: 1.8; }
 .selected-meta { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; padding-top: 22px; color: var(--color-ink-muted); font-size: 13px; font-variant-numeric: tabular-nums; }
 .selected-arrow { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--color-line); border-radius: 50%; color: var(--color-ink); transition: background-color var(--dur-base),color var(--dur-base),border-color var(--dur-base),transform var(--dur-base) var(--ease-out-expo); }
 @media (hover: hover) and (prefers-reduced-motion: no-preference) {
  .selected-row:hover { translate: 0 -4px; border-color: var(--color-line-strong); box-shadow: var(--shadow-lift); }
  .selected-row:hover .selected-number { translate: -6px 4px; -webkit-text-stroke-color: var(--color-accent); }
 }
 .selected-row:is(:hover,:focus-visible)::before { opacity: 1; }
 .selected-row:is(:hover,:focus-visible) h3 { color: var(--color-accent-strong); }
 .selected-row:is(:hover,:focus-visible) .selected-arrow { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-on-primary); transform: translateX(3px); }

 .learning-band { position: relative; margin-top: 104px; padding-block: 80px 88px; overflow: hidden; background: var(--color-paper-warm); border-block: 1px solid var(--color-line); }
 .learning-band::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(var(--color-grid-dot) 1px,transparent 1.4px); background-size: 24px 24px; -webkit-mask-image: linear-gradient(180deg,#000,transparent 65%); mask-image: linear-gradient(180deg,#000,transparent 65%); pointer-events: none; }
 .learning-band > .page-shell { position: relative; }
 .home-series { margin-top: 0; }

 .project-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 24px; }

 .discovery { display: grid; grid-template-columns: minmax(0,1fr) 380px; align-items: start; gap: 56px; }
 .recent-list { list-style: none; border-top: 1px solid var(--color-ink); }
 .recent-row { position: relative; display: grid; grid-template-columns: 116px minmax(0,1fr) 18px; gap: 20px; align-items: center; min-height: 72px; padding-block: 14px; border-bottom: 1px solid var(--color-line); }
 .recent-row::before { content: ''; position: absolute; left: 0; bottom: -1px; width: 100%; height: 1px; background: var(--color-accent); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-slow) var(--ease-out-expo); }
 .recent-row time { color: var(--color-ink-muted); font-family: var(--font-mono); font-size: 12.5px; font-variant-numeric: tabular-nums; }
 .recent-row h3 { font-family: var(--font-sans); font-size: 16px; font-weight: 600; line-height: 1.55; transition: translate var(--dur-base) var(--ease-out-expo),color var(--dur-base); }
 .recent-row :global(svg) { color: var(--color-ink-muted); transition: transform var(--dur-base) var(--ease-out-expo),color var(--dur-base); }
 .recent-row:is(:hover,:focus-visible)::before { transform: scaleX(1); }
 .recent-row:is(:hover,:focus-visible) h3 { color: var(--color-accent-strong); translate: 6px 0; }
 .recent-row:is(:hover,:focus-visible) :global(svg) { color: var(--color-accent); transform: translateX(3px); }
 .topics { position: relative; overflow: hidden; padding: 32px; border-radius: 22px; background-color: var(--hero-bg); background-image: radial-gradient(360px 260px at 100% 0%,var(--hero-glow),transparent 70%); }
 .topics > p { color: var(--color-sage); font-size: 12.5px; font-weight: 600; letter-spacing: .08em; }
 .topics h2 { margin-top: 10px; font-size: 28px; line-height: 1.3; }
 .topic-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
 .topic-list a { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 14px; border: 1px solid var(--color-line-strong); border-radius: 999px; color: var(--color-ink); font-size: 13px; transition: background-color var(--dur-base),border-color var(--dur-base),color var(--dur-base),transform var(--dur-base) var(--ease-out-expo); }
 .topic-list a:hover { border-color: var(--color-accent); background: var(--color-accent-soft); color: var(--color-accent-strong); transform: translateY(-2px); }
 .topic-list span { color: var(--color-ink-muted); font-size: 12px; font-variant-numeric: tabular-nums; }
 .topic-all { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-top: 18px; color: var(--color-ink); font-size: 14px; font-weight: 600; }
 .topic-all:hover { color: var(--color-accent-strong); }

 @keyframes rise { from { opacity: 0; transform: translateY(22px); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }
 @keyframes stamp { from { opacity: 0; transform: scale(2.4) rotate(-20deg); } to { opacity: 1; transform: none; } }
 @keyframes pulse { from { opacity: .9; transform: scale(.6); } to { opacity: 0; transform: scale(1.8); } }
 @keyframes ribbon { to { transform: translateX(-50%); } }

 @media (max-width: 1100px) {
  .hero-inner { grid-template-columns: minmax(0,1fr) 220px; gap: 40px; }
  .discovery { grid-template-columns: 1fr; gap: 48px; }
  .home-series { grid-template-columns: repeat(3,minmax(0,1fr)); }
 }
 @media (max-width: 900px) {
  .selected-writing { grid-template-columns: 1fr; }
  .selected-rows { grid-template-rows: none; grid-template-columns: 1fr 1fr; }
  .home-series { grid-template-columns: 1fr 1fr; }
 }
 @media (max-width: 700px) {
  .hero-inner { grid-template-columns: 1fr; gap: 36px; padding-block: 44px 32px; }
  .hero-title { margin-top: 22px; }
  .hero-motto { margin-top: 16px; }
  .intro-copy { font-size: 15px; }
  .intro-actions { margin-top: 26px; }
  .intro-index { grid-template-columns: repeat(3,minmax(0,1fr)); border-top: 0; }
  .intro-index a { grid-template-columns: 1fr; gap: 4px; padding: 14px 0 0 14px; border-bottom: 0; border-left: 1px solid var(--color-line-strong); }
  .intro-index strong { font-size: 30px; }
  .intro-index span { font-size: 12.5px; }
  .intro-index :global(svg) { display: none; }
  .ribbon-list a { min-height: 46px; font-size: 15px; }
  .home-section { margin-top: 64px; }
  .writing-section { margin-top: 44px; }
  .section-bar { margin-bottom: 22px; }
  .section-bar > a { padding: 0 14px; }
  .selected-rows,.project-grid,.home-series { grid-template-columns: 1fr; }
  .selected-writing,.selected-rows { gap: 18px; }
  .selected-writing :global(.post-featured .card-content) { padding: 22px; }
  .selected-writing :global(.post-featured h3) { font-size: 22px; }
  .selected-row { padding: 24px 22px 22px; }
  .selected-row h3 { font-size: 20px; }
  .selected-number { font-size: 72px; }
  .learning-band { margin-top: 72px; padding-block: 56px 60px; }
  .recent-row { grid-template-columns: 1fr 18px; gap: 4px 12px; }
  .recent-row time,.recent-row h3 { grid-column: 1; }
  .recent-row :global(svg) { grid-column: 2; grid-row: 1 / span 2; }
  .topics { padding: 26px 22px; }
 }
</style>
