---
import { getCollection, render } from 'astro:content';
import type { LearningSeries } from '../../utils/series';
import { getLearningSeries } from '../../utils/series';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/url';
export async function getStaticPaths() {
 const groups = getLearningSeries(await getCollection('series'), await getCollection('posts'));
 return groups.map(group => ({ params: { series: group.entry.id }, props: { group } }));
}
interface Props { group: LearningSeries; }
const { group } = Astro.props;
const { entry, chapters } = group;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
 <div data-pagefind-ignore>
  <section class="page-shell pt-10 sm:pt-14"><a href={withBase('/notes/')} class="text-link back-link">← 全部学习专题</a></section>
  <section class="page-shell learning-layout" aria-label={`${entry.data.title}学习路径`}>
   <aside class="course-intro"><p class="eyebrow">STRUCTURED LEARNING</p><span class="course-emblem" aria-hidden="true">{entry.data.emblem}</span><h1>{entry.data.title}</h1>{entry.data.englishTitle && <p class="course-english">{entry.data.englishTitle}</p>}<p class="course-description">{entry.data.description}</p><div class="course-facts"><span>{chapters.length} 篇笔记</span>{entry.data.facts && <span>{entry.data.facts}</span>}</div><a href={withBase(`/blog/${chapters[0].id}/`)} class="zen-btn zen-btn-primary">从第一篇开始 ↗</a>{entry.data.sourceNote && <p class="source-note">{entry.data.sourceNote}</p>}</aside>
   <div class="chapter-list">
    {entry.body?.trim() && <div class="rich-content series-overview"><Content/></div>}
    <h2 class="eyebrow chapter-label">CONTENTS / 按章节阅读</h2>
    {chapters.map((post,index) => <a href={withBase(`/blog/${post.id}/`)} class="chapter-row"><span class="chapter-number">{String(index+1).padStart(2,'0')}</span><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="chapter-arrow" aria-hidden="true">↗</span></a>)}
   </div>
  </section>
 </div>
</BaseLayout>
<style>
 .learning-layout { display: grid; grid-template-columns: 330px minmax(0,1fr); gap: 60px; margin-top: 30px; align-items: start; }
 .course-intro { padding: 32px; border: 1px solid var(--color-line); border-radius: 10px; background: var(--color-paper-warm); position: sticky; top: 118px; }
 .course-emblem { font-family: var(--font-editorial); font-size: 100px; line-height: 1.1; color: var(--color-accent); display: block; margin-top: 25px; }
 .course-intro h1 { font-size: 25px; margin-top: 10px; }
 .course-english { font-family: var(--font-editorial); font-size: 24px; line-height: 1.35; color: var(--color-accent); margin-top: 10px; }
 .course-description { margin-top: 25px; font-size: 12px; line-height: 2; color: var(--color-ink-soft); }
 .course-facts { display: flex; flex-wrap: wrap; gap: 16px; font-size: 10px; margin: 20px 0; color: var(--color-ink-soft); }
 .course-intro .zen-btn { width: 100%; }
 .source-note { margin-top: 23px; font-size: 10px; line-height: 1.9; color: var(--color-ink-soft); }
 .series-overview { margin-bottom: 30px; }
 .chapter-label { padding-bottom: 18px; border-bottom: 1px solid var(--color-line); }
 .chapter-row { padding: 22px 12px; margin-inline: -12px; border-bottom: 1px solid var(--color-line); display: grid; grid-template-columns: 36px minmax(0,1fr) 15px; gap: 15px; align-items: start; border-radius: 8px; transition: background-color .2s var(--ease-smooth); }
 .chapter-row:hover { background: var(--color-surface-hover); }
 .chapter-number { font-family: var(--font-editorial); font-size: 24px; color: var(--color-accent); line-height: 1.4; }
 .chapter-row h3 { font-family: var(--font-sans); font-size: 14px; font-weight: 500; transition: color .2s var(--ease-smooth); }
 .chapter-row p { margin-top: 7px; font-size: 11px; line-height: 1.9; color: var(--color-ink-soft); }
 .chapter-arrow { color: var(--color-accent); transition: transform .25s var(--ease-out-expo); }
 .chapter-row:hover h3 { color: var(--color-accent); }
 .chapter-row:hover .chapter-arrow { transform: translate(3px,-3px); }
 @media (max-width: 900px) { .learning-layout { grid-template-columns: 260px minmax(0,1fr); gap: 30px; } .course-intro { padding: 24px; } }
 @media (max-width: 700px) { .learning-layout { grid-template-columns: 1fr; gap: 30px; } .course-intro { position: static; } .course-emblem { font-size: 65px; margin-top: 15px; } .chapter-row { padding: 18px 8px; margin-inline: -8px; grid-template-columns: 30px minmax(0,1fr) 12px; gap: 12px; } .chapter-number { font-size: 20px; } }
</style>
