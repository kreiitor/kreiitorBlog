---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutSections, siteConfig } from '../data/site';
import { withBase } from '../utils/url';
---

<BaseLayout title="关于" description="个人简介、研究兴趣与站点维护说明。">
	<div data-pagefind-ignore>
		<!-- Profile -->
		<section class="page-shell pt-16 sm:pt-20" data-zen-reveal>
			<div class="grid gap-10 lg:grid-cols-[1fr_280px] lg:items-start">
				<div class="space-y-6">
					<p class="zen-kicker">About</p>
					<h1 class="font-display text-3xl font-semibold text-[color:var(--color-ink)] sm:text-4xl">
						{siteConfig.author}
					</h1>
					<p class="max-w-2xl text-base leading-8 text-[color:var(--color-ink-soft)]">
						{siteConfig.role}，目前以中文写作为主，持续整理研究问题、论文思路和工程实验过程。
					</p>
					<div class="flex flex-wrap gap-2.5">
						{siteConfig.socialLinks.map((link) => (
							<a
								href={link.href}
								target="_blank"
								rel="noreferrer"
								class="zen-btn zen-btn-secondary text-xs"
							>
								{link.label}
							</a>
						))}
					</div>
				</div>

				<div class="zen-card-flat p-5">
					<img src={withBase(siteConfig.avatar)} alt={siteConfig.author} class="h-20 w-20 rounded-2xl object-cover" />
					<p class="mt-5 font-display text-lg font-semibold text-[color:var(--color-ink)]">{siteConfig.location}</p>
					<p class="mt-2 text-sm leading-7 text-[color:var(--color-ink-soft)]">
						品牌信息集中在
						<code class="rounded bg-[color:var(--color-paper-warm)] px-1 py-0.5 text-xs text-[color:var(--color-accent-strong)]">src/data/site.ts</code>
						，修改内容无需重写页面结构。
					</p>
				</div>
			</div>
		</section>

		<!-- Sections -->
		<section class="page-shell mt-16 grid gap-5 md:grid-cols-3" data-zen-reveal>
			{aboutSections.map((section) => (
				<div class="zen-card-flat p-5">
					<h2 class="font-display text-lg font-semibold text-[color:var(--color-ink)]">{section.title}</h2>
					<ul class="mt-4 space-y-2.5 text-sm leading-7 text-[color:var(--color-ink-soft)]">
						{section.items.map((item) => (
							<li class="flex items-start gap-2">
								<span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-[color:var(--color-accent)]"></span>
								{item}
							</li>
						))}
					</ul>
				</div>
			))}
		</section>
	</div>
</BaseLayout>
