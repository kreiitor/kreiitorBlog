---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { aboutSections, siteConfig } from '../data/site';
import { withBase } from '../utils/url';
import avatarSvg from '../../public/avatar.svg?raw';
// 内联而不是 <img>：鹤纹要跟随站内的主题切换取色，外部 SVG 只能读到系统主题。
const avatarMark = avatarSvg.replace(/<style>.*?<\/style>/s, '').replace(/ aria-labelledby="logo-title"/, ' aria-label="kreiitor 的标志"').replace(/<title[^>]*>.*?<\/title>/s, '');
---
<BaseLayout title="关于我" description="kreiitor 的研究兴趣、写作方向与联系方式。">
 <div data-pagefind-ignore>
  <PageIntro eyebrow="Behind the notes / About me" mark="person"><Fragment slot="title">你好，我是 kreiitor<span class="hello-dot">.</span></Fragment><p>数据科学硕士，偏软件工程方向，坐标武汉。<br/>记录问题，记录想法，喜欢看着零散的东西慢慢连起来。</p></PageIntro>
  <section class="page-shell about-layout">
   <div class="about-copy"><p class="eyebrow">A little about this space</p><h2>认真做研究，<br/>也认真记录过程。</h2><p>我目前关注于 AI 的基础理论和它能用在哪儿，尤其是大语言模型怎么帮我们理解代码、改善软件工程、完成日常任务等具体的事。而数学和阅读是让我安静下来的兴趣所在。</p><p>这个博客算是我的一个自留地：读过的论文、做完的项目、遇到的问题，都想在这里留一份记录。不一定有结论，但希望保留问题从哪里来、当时为什么这么做。</p><p>如果某篇札记碰巧对你有用，或者你想聊聊里面的某个想法，欢迎随时找我。</p><div class="mt-7 flex flex-wrap gap-3">{siteConfig.socialLinks.map(link => <a href={link.href} target="_blank" rel="noreferrer" class="zen-btn zen-btn-secondary">{link.label} ↗</a>)}</div></div>
   <aside class="profile-note"><span id="profile-logo" class="profile-logo" data-gallery-href={withBase('/gallery/')} set:html={avatarMark}/><h2>{siteConfig.author}</h2><p>{siteConfig.role}</p><div class="profile-rule"></div><p class="eyebrow">关于这个站</p><p>论文阅读、实验过程与工程实践的长期记录。</p><a class="text-link" href={withBase("/archive/")}>浏览写作归档 →</a><p class="profile-location"><span aria-hidden="true">↳</span>{siteConfig.location}</p></aside>
  </section>
  <section class="page-shell about-principles">{aboutSections.map((section,index) => <div><p class="eyebrow">0{index+1}</p><h2>{section.title}</h2><ul>{section.items.map(item => <li>{item}</li>)}</ul></div>)}</section>
 </div>
</BaseLayout>
<script>
 // 隐藏页彩蛋：连点三次右侧 logo → /gallery/
 const logo = document.getElementById('profile-logo');
 if (logo) {
  let taps = 0;
  let timer: ReturnType<typeof setTimeout> | undefined;
  logo.addEventListener('click', () => {
   taps += 1;
   clearTimeout(timer);
   if (taps >= 3) {
    taps = 0;
    window.location.href = logo.dataset.galleryHref ?? '/gallery/';
   } else {
    logo.animate(
     [{ transform: 'rotate(0deg)' }, { transform: 'rotate(-8deg)' }, { transform: 'rotate(0deg)' }],
     { duration: 260, easing: 'ease-out' }
    );
    timer = setTimeout(() => { taps = 0; }, 900);
   }
  });
  logo.style.cursor = 'pointer';
 }
</script>
<style>
 .hello-dot { color: var(--color-accent); }
 .about-layout { display: grid; grid-template-columns: minmax(0,1fr) 310px; gap: 110px; margin-top: 55px; }
 .about-copy h2 { font-size: clamp(28px,1.2rem + 1.4vw,40px); line-height: 1.45; margin: 16px 0 26px; }
 .about-copy > p:not(.eyebrow) { max-width: 40em; font-size: 16px; color: var(--color-ink-soft); line-height: 1.9; margin-top: 18px; }
 .profile-note { position: sticky; top: calc(var(--header-height) + 32px); align-self: start; padding: 32px; border: 1px solid var(--color-line); border-radius: 22px; background: var(--color-surface); box-shadow: var(--shadow-soft); }
 .profile-logo { display: grid; place-items: center; width: 80px; height: 80px; border-radius: 18px; background: var(--color-surface-soft); }
 .profile-logo :global(svg) { width: 60%; height: 60%; }
 .profile-logo :global(.brand-ink) { fill: var(--color-ink); }
 .profile-logo :global(.brand-accent) { fill: var(--color-accent); }
 .profile-note h2 { font-family: var(--font-editorial); font-size: 30px; margin-top: 20px; }
 .profile-note > p:not(.eyebrow) { font-size: var(--text-caption); color: var(--color-ink-soft); margin-top: 8px; }
 .profile-rule { border-top: 1px solid var(--color-blossom-line); margin: 26px 0; }
 .profile-note ul { font-size: var(--text-caption); color: var(--color-ink-soft); line-height: 2.5; margin-top: 12px; }
 .profile-location { margin-top: 28px !important; } .profile-location span { margin-right: 10px; }
 /* 三组原则是并列的短清单：用竖线和对齐分组，不再套等大圆角卡片。 */
 .about-principles { margin-top: 72px; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); border-top: 1px solid var(--color-line); }
 .about-principles > div { padding: 28px 28px 8px; border-left: 1px solid var(--color-line); }
 .about-principles > div:first-child { padding-left: 0; border-left: 0; }
 .about-principles .eyebrow { font-family: var(--font-mono); font-size: 12.5px; font-weight: 500; letter-spacing: .04em; color: var(--color-ink-muted); font-variant-numeric: tabular-nums; }
 .about-principles > div:first-child .eyebrow { color: var(--color-accent); }
 .about-principles h2 { font-size: 20px; margin: 10px 0 12px; } .about-principles ul { font-size: 14px; color: var(--color-ink-soft); line-height: 2.1; }
 @media (max-width: 900px) { .about-layout { gap: 35px; } }
 @media (max-width: 600px) { .about-layout { grid-template-columns: 1fr; } .about-principles { grid-template-columns: 1fr; } .about-principles > div { padding: 24px 0 4px; border-left: 0; } .about-principles > div + div { border-top: 1px solid var(--color-line); } }
</style>
