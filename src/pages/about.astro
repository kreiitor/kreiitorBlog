---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutSections, siteConfig } from '../data/site';
import { withBase } from '../utils/url';
---
<BaseLayout title="关于我" description="kreiitor 的研究兴趣、写作方向与联系方式。">
 <div data-pagefind-ignore>
  <section class="page-shell page-intro"><p class="eyebrow">BEHIND THE NOTES / ABOUT ME</p><h1>你好，我是 kreiitor<span class="hello-dot">.</span></h1><p>软件工程智能化方向研究者，坐标武汉。<br/>喜欢把复杂的问题拆开，再把零散的想法连起来。</p></section>
  <section class="page-shell about-layout">
   <div class="about-copy"><p class="eyebrow">A LITTLE ABOUT THIS SPACE</p><h2>认真做研究，<br/>也认真记录途中。</h2><p>我关注 AI for Software Engineering，尤其是大语言模型如何帮助我们理解代码、分析程序和改善软件工程实践。</p><p>这份博客是我的研究札记，也是一个持续生长的知识花园。论文阅读、实验复现、数学学习、工具实践，都可以在这里留下痕迹。</p><p>我希望文章不只是记录结论，也能保留问题从哪里来、为什么这样做，以及哪些地方还值得继续追问。</p><div class="mt-7 flex flex-wrap gap-3">{siteConfig.socialLinks.map(link => <a href={link.href} target="_blank" rel="noreferrer" class="zen-btn zen-btn-secondary">{link.label} ↗</a>)}</div></div>
   <aside class="profile-note"><img src={withBase(siteConfig.avatar)} alt="kreiitor 的字母标志" width="80" height="80"/><h2>{siteConfig.author}</h2><p>{siteConfig.role}</p><div class="profile-rule"></div><p class="eyebrow">CURRENTLY EXPLORING</p><ul><li>LLM × Software Engineering</li><li>程序分析与代码理解</li><li>可复现的研究工作流</li></ul><p class="profile-location"><span aria-hidden="true">↳</span>{siteConfig.location}</p></aside>
  </section>
  <section class="page-shell about-principles">{aboutSections.map((section,index) => <div><p class="eyebrow">0{index+1}</p><h2>{section.title}</h2><ul>{section.items.map(item => <li>{item}</li>)}</ul></div>)}</section>
 </div>
</BaseLayout>
<style>
 .hello-dot { color: var(--color-accent); }
 .about-layout { display: grid; grid-template-columns: minmax(0,1fr) 310px; gap: 110px; margin-top: 55px; }
 .about-copy h2 { font-size: 30px; line-height: 1.7; margin: 18px 0 26px; font-weight: 500; }
 .about-copy > p:not(.eyebrow) { font-size: 14px; color: var(--color-ink-soft); line-height: 2.1; margin-top: 18px; }
 .profile-note { padding: 32px; background: var(--color-paper-warm); border: 1px solid var(--color-line); border-radius: 6px; }
 .profile-note img { border-radius: 17px; } .profile-note h2 { font-family: var(--font-editorial); font-size: 30px; margin-top: 20px; }
 .profile-note > p:not(.eyebrow) { font-size: 11px; color: var(--color-ink-soft); margin-top: 8px; }
 .profile-rule { border-top: 1px solid var(--color-line-strong); margin: 26px 0; }
 .profile-note ul { font-size: 11px; color: var(--color-ink-soft); line-height: 2.5; margin-top: 12px; }
 .profile-location { margin-top: 28px !important; } .profile-location span { margin-right: 10px; }
 .about-principles { margin-top: 65px; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 45px; border-top: 1px solid var(--color-line); padding-top: 30px; }
 .about-principles h2 { font-size: 20px; margin: 12px 0; } .about-principles ul { font-size: 12px; color: var(--color-ink-soft); line-height: 2.4; }
 @media (max-width: 900px) { .about-layout { gap: 35px; } }
 @media (max-width: 700px) { .about-layout { grid-template-columns: 1fr; } .about-principles { grid-template-columns: 1fr; gap: 30px; } }
</style>
