---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutSections, siteConfig } from '../data/site';
import { withBase } from '../utils/url';
---
<BaseLayout title="关于我" description="kreiitor 的研究兴趣、写作方向与联系方式。">
 <div data-pagefind-ignore>
  <section class="page-shell page-intro"><p class="eyebrow">BEHIND THE NOTES / ABOUT ME</p><h1>你好，我是 kreiitor<span class="hello-dot">.</span></h1><p>数据科学硕士，偏软件工程方向，坐标武汉。<br/>记录问题，记录想法，喜欢看着零散的东西慢慢连起来。</p></section>
  <section class="page-shell about-layout">
   <div class="about-copy"><p class="eyebrow">A LITTLE ABOUT THIS SPACE</p><h2>认真做研究，<br/>也认真记录过程。</h2><p>我目前关注于 AI 的基础理论和它能用在哪儿，尤其是大语言模型怎么帮我们理解代码、改善软件工程、完成日常任务等具体的事。而数学和阅读是让我安静下来的兴趣所在。</p><p>这个博客算是我的一个自留地：读过的论文、做完的项目、遇到的问题，都想在这里留一份记录。不一定有结论，但希望保留问题从哪里来、当时为什么这么做。</p><p>如果某篇札记碰巧对你有用，或者你想聊聊里面的某个想法，欢迎随时找我。</p><div class="mt-7 flex flex-wrap gap-3">{siteConfig.socialLinks.map(link => <a href={link.href} target="_blank" rel="noreferrer" class="zen-btn zen-btn-secondary">{link.label} ↗</a>)}</div></div>
   <aside class="profile-note"><img id="profile-logo" data-gallery-href={withBase('/gallery/')} src={withBase(siteConfig.avatar)} alt="kreiitor 的标志" width="80" height="80"/><h2>{siteConfig.author}</h2><p>{siteConfig.role}</p><div class="profile-rule"></div><p class="eyebrow">关于这份札记</p><p>论文阅读、实验过程与工程实践的长期记录。</p><a class="text-link" href={withBase("/archive/")}>浏览写作归档 →</a><p class="profile-location"><span aria-hidden="true">↳</span>{siteConfig.location}</p></aside>
  </section>
  <section class="page-shell about-principles">{aboutSections.map((section,index) => <div><p class="eyebrow">0{index+1}</p><h2>{section.title}</h2><ul>{section.items.map(item => <li>{item}</li>)}</ul></div>)}</section>
 </div>
</BaseLayout>
<script>
 // 隐藏页彩蛋：连点三次右侧 logo → /gallery/
 const logo = document.getElementById('profile-logo');
 if (logo) {
  let taps = 0;
  let timer: ReturnType<typeof setTimeout> | undefined;
  logo.addEventListener('click', () => {
   taps += 1;
   clearTimeout(timer);
   if (taps >= 3) {
    taps = 0;
    window.location.href = logo.dataset.galleryHref ?? '/gallery/';
   } else {
    logo.animate(
     [{ transform: 'rotate(0deg)' }, { transform: 'rotate(-8deg)' }, { transform: 'rotate(0deg)' }],
     { duration: 260, easing: 'ease-out' }
    );
    timer = setTimeout(() => { taps = 0; }, 900);
   }
  });
  logo.style.cursor = 'pointer';
 }
</script>
<style>
 .hello-dot { color: var(--color-accent); }
 .about-layout { display: grid; grid-template-columns: minmax(0,1fr) 310px; gap: 110px; margin-top: 55px; }
 .about-copy h2 { font-size: 30px; line-height: 1.7; margin: 18px 0 26px; font-weight: 500; }
 .about-copy > p:not(.eyebrow) { font-size: 14px; color: var(--color-ink-soft); line-height: 2.1; margin-top: 18px; }
 .profile-note { padding: 32px; background: var(--color-paper-warm); border: 1px solid var(--color-line); border-radius: 10px; }
 .profile-note img { border-radius: 12px; } .profile-note h2 { font-family: var(--font-editorial); font-size: 30px; margin-top: 20px; }
 .profile-note > p:not(.eyebrow) { font-size: var(--text-caption); color: var(--color-ink-soft); margin-top: 8px; }
 .profile-rule { border-top: 1px solid var(--color-line-strong); margin: 26px 0; }
 .profile-note ul { font-size: var(--text-caption); color: var(--color-ink-soft); line-height: 2.5; margin-top: 12px; }
 .profile-location { margin-top: 28px !important; } .profile-location span { margin-right: 10px; }
 .about-principles { margin-top: 65px; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 45px; border-top: 1px solid var(--color-line); padding-top: 30px; }
 .about-principles h2 { font-size: 20px; margin: 12px 0; } .about-principles ul { font-size: 12px; color: var(--color-ink-soft); line-height: 2.4; }
 @media (max-width: 900px) { .about-layout { gap: 35px; } }
 @media (max-width: 700px) { .about-layout { grid-template-columns: 1fr; } .about-principles { grid-template-columns: 1fr; gap: 30px; } }
</style>
