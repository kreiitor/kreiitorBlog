---
import SearchPanel from '../components/SearchPanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="使用 Pagefind 进行站内静态搜索。">
	<section data-pagefind-ignore class="page-shell pt-16 sm:pt-20">
		<div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_280px]">
			<div data-zen-reveal>
				<SearchPanel
					title="站内搜索"
					description="搜索博客文章、项目页面和正文内容。"
				/>
			</div>

			<aside class="space-y-5" data-zen-reveal>
				<div class="zen-card-flat p-5">
					<p class="zen-kicker">Tips</p>
					<ul class="mt-4 space-y-2.5 text-sm leading-7 text-[color:var(--color-ink-soft)]">
						<li>优先尝试主题词，如"算法学习""实验复现"</li>
						<li>结果太少可以减少限定词</li>
						<li>换更具体的技术名词缩小范围</li>
					</ul>
				</div>
				<div class="zen-card-flat p-5">
					<p class="zen-kicker">索引范围</p>
					<p class="mt-3 text-sm leading-7 text-[color:var(--color-ink-soft)]">
						当前索引覆盖文章详情页和项目详情页，导航页、归档页和标签页不参与搜索。
					</p>
				</div>
			</aside>
		</div>
	</section>
</BaseLayout>
