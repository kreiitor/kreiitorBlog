{
  "name": "ai4program",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test:series": "node scripts/test-series.mjs",
    "test:unit": "node --test tests/*.test.mjs && npm run test:series",
    "test:browser": "playwright test",
    "fonts:prepare": "python scripts/prepare-fonts.py",
    "social:prepare": "node scripts/prepare-social-images.mjs",
    "art:prepare": "node scripts/prepare-garden-art.mjs && npm run social:prepare",
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/inject-heading-anchors.mjs && pagefind --site dist && node scripts/check-site.mjs",
    "links:check": "node scripts/check-external-links.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.3.8",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "katex": "^0.19.0",
    "pagefind": "^1.4.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
