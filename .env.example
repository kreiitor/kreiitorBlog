# Giscus 评论配置。取值入口是官方配置页 https://giscus.app 。
#
# 获取 repo / repoId / category / categoryId 的步骤：
#   1. 确认目标仓库是公开仓库，并已开启 Discussions；未安装 giscus App 也无法评论，
#      安装入口：https://github.com/apps/giscus
#   2. 打开 https://giscus.app ，选好仓库与 Discussion 分类（本仓库用 Announcements），
#      页面底部生成的 <script> 标签里就带着 data-repo / data-repo-id /
#      data-category / data-category-id 四项的值，直接抄成下面四行即可。
#
# 这四项都会写进页面 HTML，属于公开值，不是密钥；仍然放在 .env /
# GitHub 仓库 Variables 里只是为了按部署切换。本地 .env 已被 .gitignore 忽略，不要提交。
# 本仓库的默认值同样写在 src/utils/giscus.ts，因此不配置也能显示评论。
PUBLIC_GISCUS_REPO=kreiitor/kreiitorBlog
PUBLIC_GISCUS_REPO_ID=R_kgDOR5wNCw
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOR5wNC84C6DIZ

# 以下为可选项，留空时使用 src/utils/giscus.ts 中的默认值。
# mapping：评论与页面的关联方式；站点固定用 pathname，组件据此按文章原始路径建立讨论关联。
PUBLIC_GISCUS_MAPPING=pathname
# strict：1 为严格匹配 mapping，0 为允许模糊匹配。
PUBLIC_GISCUS_STRICT=0
# reactionsEnabled：是否启用表情回应（1/0）。
PUBLIC_GISCUS_REACTIONS_ENABLED=1
# emitMetadata：是否向父页面发送页面元数据（1/0）。
PUBLIC_GISCUS_EMIT_METADATA=0
# inputPosition：评论输入框位置，top 或 bottom。
PUBLIC_GISCUS_INPUT_POSITION=top
# lang：评论界面语言。
PUBLIC_GISCUS_LANG=zh-CN
